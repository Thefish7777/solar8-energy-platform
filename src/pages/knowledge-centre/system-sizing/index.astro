---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
---

<BaseLayout
    title="Solar System Sizing & Backup Power | Solar8"
    description="Learn how to size a solar inverter, battery and solar panels for your home, and understand how much backup power you need during load shedding."
>

<Navigation />

<main>

    <!-- HERO -->

    <section class="sizing-hero">

        <div class="sizing-container">

            <div class="hero-content">

                <span class="eyebrow">
                    SOLAR8 KNOWLEDGE CENTRE
                </span>

                <h1>
                    Solar System
                    <span>Sizing Made Simple.</span>
                </h1>

                <p>
                    How much solar do you need? Learn how inverter power,
                    battery capacity, solar panels and your electrical loads
                    work together to create the right system for your property.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Get My FREE Assessment
                    </a>

                    <a href="/knowledge-centre" class="secondary-button">
                        Back to Knowledge Centre
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- INTRO -->

    <section class="intro-section">

        <div class="sizing-container">

            <div class="section-heading">

                <span class="eyebrow">
                    THE BASICS
                </span>

                <h2>
                    Solar sizing starts with how you use electricity.
                </h2>

                <p>
                    The right solar system is not simply the biggest system
                    you can afford. It should be designed around your actual
                    electricity demand, the appliances you want to run,
                    your backup requirements and how much solar energy your
                    property can produce.
                </p>

            </div>


            <div class="intro-grid">

                <div class="intro-text">

                    <p>
                        There are three main questions to answer when sizing
                        a solar system:
                    </p>

                    <div class="question-list">

                        <div class="question">
                            <strong>01</strong>
                            <span>
                                How much power do my appliances need at the
                                same time?
                            </span>
                        </div>

                        <div class="question">
                            <strong>02</strong>
                            <span>
                                How much energy do I want to store in my
                                batteries?
                            </span>
                        </div>

                        <div class="question">
                            <strong>03</strong>
                            <span>
                                How much solar energy do I need to generate
                                during the day?
                            </span>
                        </div>

                    </div>

                </div>


                <div class="sizing-diagram">

                    <div class="diagram-title">
                        THE THREE PARTS OF SYSTEM SIZING
                    </div>

                    <div class="sizing-flow">

                        <div class="sizing-box">

                            <div class="sizing-icon">
                                ⚡
                            </div>

                            <strong>
                                Inverter
                            </strong>

                            <small>
                                How much power?
                            </small>

                        </div>

                        <div class="sizing-plus">
                            +
                        </div>

                        <div class="sizing-box">

                            <div class="sizing-icon">
                                🔋
                            </div>

                            <strong>
                                Battery
                            </strong>

                            <small>
                                How long?
                            </small>

                        </div>

                        <div class="sizing-plus">
                            +
                        </div>

                        <div class="sizing-box">

                            <div class="sizing-icon">
                                ☀
                            </div>

                            <strong>
                                Solar
                            </strong>

                            <small>
                                How much generation?
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- INVERTER -->

    <section class="inverter-section">

        <div class="sizing-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    01 — INVERTER SIZING
                </span>

                <h2>
                    How big should your inverter be?
                </h2>

                <p>
                    Your inverter is primarily concerned with power. Its
                    rating determines how much electrical load the system
                    can supply at a given moment.
                </p>

            </div>


            <div class="inverter-grid">

                <div class="info-card">

                    <div class="info-number">
                        kW
                    </div>

                    <h3>
                        Power capacity
                    </h3>

                    <p>
                        An inverter rated at 5 kW can supply approximately
                        5 kW of electrical power under the appropriate
                        operating conditions.
                    </p>

                </div>


                <div class="info-card">

                    <div class="info-number">
                        ⚡
                    </div>

                    <h3>
                        Think about simultaneous loads
                    </h3>

                    <p>
                        If several high-power appliances operate at the
                        same time, their combined demand may determine the
                        inverter size required.
                    </p>

                </div>


                <div class="info-card">

                    <div class="info-number">
                        ↑
                    </div>

                    <h3>
                        Allow for future needs
                    </h3>

                    <p>
                        A system should also consider appliances or
                        electrical loads that you may add in the future.
                    </p>

                </div>

            </div>


            <div class="example-box">

                <span class="example-label">
                    SIMPLE EXAMPLE
                </span>

                <h3>
                    Why simultaneous loads matter
                </h3>

                <p>
                    Imagine a property running a kettle, microwave,
                    refrigerator, lighting and other appliances at the
                    same time. The inverter needs to handle the combined
                    electrical demand rather than simply looking at the
                    monthly electricity bill.
                </p>

                <strong>
                    Inverter sizing = power demand
                </strong>

            </div>

        </div>

    </section>


    <!-- BATTERY -->

    <section class="battery-section">

        <div class="sizing-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    02 — BATTERY SIZING
                </span>

                <h2>
                    How many batteries do you need?
                </h2>

                <p>
                    Battery sizing is mainly about energy capacity and
                    how long you want selected appliances to operate
                    without grid power.
                </p>

            </div>


            <div class="battery-grid">

                <article class="battery-card">

                    <div class="battery-icon">
                        🔋
                    </div>

                    <span class="card-label">
                        CAPACITY
                    </span>

                    <h3>
                        Battery kWh
                    </h3>

                    <p>
                        Battery capacity is normally expressed in
                        kilowatt-hours (kWh). A larger battery can store
                        more energy.
                    </p>

                </article>


                <article class="battery-card featured">

                    <div class="battery-icon">
                        ⏱
                    </div>

                    <span class="card-label">
                        BACKUP TIME
                    </span>

                    <h3>
                        How long?
                    </h3>

                    <p>
                        The amount of usable battery energy and the power
                        being consumed determine how long the battery
                        can support your selected loads.
                    </p>

                </article>


                <article class="battery-card">

                    <div class="battery-icon">
                        🏠
                    </div>

                    <span class="card-label">
                        ESSENTIAL LOADS
                    </span>

                    <h3>
                        What must stay on?
                    </h3>

                    <p>
                        Backup systems are often designed around essential
                        loads such as refrigeration, lighting, internet,
                        security and selected household circuits.
                    </p>

                </article>

            </div>


            <div class="formula-box">

                <div class="formula-title">
                    SIMPLE WAY TO THINK ABOUT IT
                </div>

                <div class="formula">
                    Battery capacity → backup energy
                </div>

                <p>
                    More battery capacity generally means more stored
                    energy available for later use. Actual backup time
                    depends on the loads being supplied and the usable
                    battery capacity.
                </p>

            </div>

        </div>

    </section>


    <!-- SOLAR PANELS -->

    <section class="solar-section">

        <div class="sizing-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    03 — SOLAR PANEL SIZING
                </span>

                <h2>
                    How many solar panels do you need?
                </h2>

                <p>
                    Solar panels determine how much energy your system can
                    generate during the day.
                </p>

            </div>


            <div class="solar-grid">

                <div class="solar-feature">

                    <div class="feature-icon">
                        ☀
                    </div>

                    <h3>
                        Panel capacity
                    </h3>

                    <p>
                        Each panel has a rated power output, normally
                        expressed in watts. Multiple panels are combined
                        to create the required solar array.
                    </p>

                </div>


                <div class="solar-feature">

                    <div class="feature-icon">
                        🌤
                    </div>

                    <h3>
                        Sunlight matters
                    </h3>

                    <p>
                        Actual production varies with sunlight, weather,
                        temperature, orientation, shading and the
                        installation itself.
                    </p>

                </div>


                <div class="solar-feature">

                    <div class="feature-icon">
                        📈
                    </div>

                    <h3>
                        Daily energy production
                    </h3>

                    <p>
                        The solar array should be considered together with
                        your electricity consumption and battery charging
                        requirements.
                    </p>

                </div>


                <div class="solar-feature">

                    <div class="feature-icon">
                        🔧
                    </div>

                    <h3>
                        Installation limitations
                    </h3>

                    <p>
                        Roof space, panel orientation, shading and inverter
                        specifications can all influence the final design.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- LOAD SHEDDING -->

    <section class="load-section">

        <div class="sizing-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    LOAD SHEDDING & BACKUP
                </span>

                <h2>
                    What do you actually want to keep running?
                </h2>

                <p>
                    A backup system does not necessarily need to power
                    every appliance in the property.
                </p>

            </div>


            <div class="load-grid">

                <div class="load-card essential">

                    <span class="load-label">
                        ESSENTIAL
                    </span>

                    <h3>
                        Common backup loads
                    </h3>

                    <ul>

                        <li>
                            Refrigerator
                        </li>

                        <li>
                            Lighting
                        </li>

                        <li>
                            Wi-Fi / Internet
                        </li>

                        <li>
                            Security systems
                        </li>

                        <li>
                            Television and electronics
                        </li>

                        <li>
                            Selected plugs
                        </li>

                    </ul>

                </div>


                <div class="load-card high-demand">

                    <span class="load-label">
                        HIGH-DEMAND
                    </span>

                    <h3>
                        Loads requiring more planning
                    </h3>

                    <ul>

                        <li>
                            Electric geysers
                        </li>

                        <li>
                            Electric stoves
                        </li>

                        <li>
                            Large air conditioners
                        </li>

                        <li>
                            Pool pumps
                        </li>

                        <li>
                            Electric heaters
                        </li>

                        <li>
                            Other high-power equipment
                        </li>

                    </ul>

                </div>

            </div>


            <div class="load-note">

                <strong>
                    Important:
                </strong>

                <p>
                    Whether an appliance can be included in a backup circuit
                    depends on its electrical demand, the inverter capacity,
                    installation configuration and the overall system design.
                </p>

            </div>

        </div>

    </section>


    <!-- SYSTEM LEVELS -->

    <section class="levels-section">

        <div class="sizing-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    CHOOSING A SYSTEM
                </span>

                <h2>
                    Different properties need different solutions
                </h2>

                <p>
                    There is no single solar system that is right for
                    every property.
                </p>

            </div>


            <div class="levels-grid">

                <article class="level-card">

                    <span class="level-tag">
                        ESSENTIAL BACKUP
                    </span>

                    <h3>
                        Keep the basics running
                    </h3>

                    <p>
                        Suitable when the main objective is maintaining
                        essential household services during power outages.
                    </p>

                    <ul>

                        <li>
                            Essential appliances
                        </li>

                        <li>
                            Smaller battery requirement
                        </li>

                        <li>
                            Focused backup circuits
                        </li>

                    </ul>

                </article>


                <article class="level-card highlighted">

                    <span class="level-tag">
                        HYBRID HOME
                    </span>

                    <h3>
                        Savings + backup
                    </h3>

                    <p>
                        A hybrid system combines solar generation, battery
                        storage and grid electricity to provide greater
                        flexibility.
                    </p>

                    <ul>

                        <li>
                            Daytime solar savings
                        </li>

                        <li>
                            Battery backup
                        </li>

                        <li>
                            Flexible energy management
                        </li>

                    </ul>

                </article>


                <article class="level-card">

                    <span class="level-tag">
                        HIGH ENERGY USE
                    </span>

                    <h3>
                        Larger energy requirements
                    </h3>

                    <p>
                        Properties with larger electrical loads may require
                        additional inverter capacity, battery storage and
                        solar generation.
                    </p>

                    <ul>

                        <li>
                            Higher loads
                        </li>

                        <li>
                            Larger solar array
                        </li>

                        <li>
                            Greater storage requirements
                        </li>

                    </ul>

                </article>

            </div>

        </div>

    </section>


    <!-- KEY TERMS -->

    <section class="terms-section">

        <div class="sizing-container">

            <div class="section-heading">

                <span class="eyebrow">
                    QUICK REFERENCE
                </span>

                <h2>
                    The numbers you need to understand
                </h2>

            </div>


            <div class="terms-grid">

                <div class="term">

                    <strong>
                        kW
                    </strong>

                    <p>
                        Power. Used to describe the power capacity of
                        an inverter and the demand of electrical loads.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        kWh
                    </strong>

                    <p>
                        Energy. Commonly used to describe battery capacity
                        and electricity consumption.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        Load
                    </strong>

                    <p>
                        The electrical demand created by appliances
                        and equipment.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        Usable Capacity
                    </strong>

                    <p>
                        The portion of a battery's capacity that can
                        practically be used by the system.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        Backup Load
                    </strong>

                    <p>
                        An electrical circuit or appliance selected to
                        remain powered when the grid is unavailable.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        Solar Array
                    </strong>

                    <p>
                        A group of solar panels connected together to
                        generate electricity.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="sizing-cta">

        <div class="sizing-container">

            <div class="cta-content">

                <span class="eyebrow">
                    NEED HELP WITH SIZING?
                </span>

                <h2>
                    Let Solar8 work out what your property needs.
                </h2>

                <p>
                    Your electricity usage, appliances, backup requirements
                    and property all influence the right solar system.
                    Start with an assessment before choosing equipment.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Start My FREE Assessment
                    </a>

                    <a href="/knowledge-centre/batteries" class="secondary-button">
                        Learn About Batteries
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<Footer />

<style>

.sizing-container {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
}

.sizing-hero {
    padding: 180px 0 120px;
    background:
        radial-gradient(
            circle at 82% 18%,
            rgba(255,104,0,.14),
            transparent 35%
        ),
        linear-gradient(
            180deg,
            #ffffff 0%,
            #FAFAFA 100%
        );
}

.hero-content {
    max-width: 840px;
}

.eyebrow {
    display: inline-block;
    color: #FF6800;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .14em;
}

.sizing-hero h1 {
    margin: 20px 0 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(3.2rem, 6vw, 5.8rem);
    line-height: 1.02;
    letter-spacing: -.045em;
}

.sizing-hero h1 span {
    display: block;
    color: #FF6800;
}

.sizing-hero p {
    max-width: 720px;
    margin-top: 30px;
    color: #6B7280;
    font-family: Inter, sans-serif;
    font-size: 20px;
    line-height: 1.7;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
}

.primary-button,
.secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all .3s ease;
}

.primary-button {
    background: #FF6800;
    color: white;
}

.primary-button:hover {
    background: #E65E00;
    transform: translateY(-2px);
}

.secondary-button {
    border: 1px solid #D1D5DB;
    color: #374151;
    background: white;
}

.secondary-button:hover {
    border-color: #FF6800;
    color: #FF6800;
}

.intro-section,
.battery-section,
.solar-section,
.comparison-section,
.terms-section {
    padding: 110px 0;
    background: #ffffff;
}

.inverter-section,
.load-section {
    padding: 110px 0;
    background: #F4F5F7;
}

.levels-section {
    padding: 110px 0;
    background: #FAFAFA;
}

.section-heading {
    max-width: 780px;
    margin-bottom: 60px;
}

.section-heading.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.section-heading h2 {
    margin: 16px 0 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(2.3rem, 4vw, 3.3rem);
    line-height: 1.1;
}

.section-heading p {
    margin-top: 20px;
    color: #6B7280;
    font-size: 18px;
    line-height: 1.7;
}

.intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.intro-text > p {
    margin-bottom: 28px;
    color: #4B5563;
    font-size: 18px;
    line-height: 1.8;
}

.question-list {
    display: grid;
    gap: 14px;
}

.question {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px;
    border: 1px solid #E5E7EB;
    border-radius: 18px;
    background: #FAFAFA;
}

.question strong {
    color: #FF6800;
    font-family: Poppins, sans-serif;
    font-size: 15px;
}

.question span {
    color: #374151;
    line-height: 1.5;
}

.sizing-diagram {
    padding: 38px;
    border: 1px solid #E5E7EB;
    border-radius: 28px;
    background: #F8F9FA;
}

.diagram-title {
    margin-bottom: 35px;
    color: #6B7280;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
}

.sizing-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

.sizing-box {
    flex: 1;
    padding: 24px 15px;
    border: 1px solid #E5E7EB;
    border-radius: 18px;
    background: #ffffff;
    text-align: center;
}

.sizing-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: #FFF3EA;
    font-size: 28px;
}

.sizing-box strong {
    display: block;
    color: #111827;
}

.sizing-box small {
    display: block;
    margin-top: 6px;
    color: #6B7280;
    line-height: 1.4;
}

.sizing-plus {
    color: #FF6800;
    font-size: 25px;
    font-weight: 800;
}

.inverter-grid,
.battery-grid,
.solar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.info-card,
.battery-card,
.solar-feature {
    padding: 34px;
    border: 1px solid #E5E7EB;
    border-radius: 24px;
    background: #ffffff;
    box-shadow: 0 5px 16px rgba(0,0,0,.04);
}

.info-card:hover,
.battery-card:hover,
.solar-feature:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(0,0,0,.08);
}

.info-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 17px;
    background: #FFF3EA;
    color: #FF6800;
    font-family: Poppins, sans-serif;
    font-size: 22px;
    font-weight: 800;
}

.info-card h3,
.battery-card h3,
.solar-feature h3 {
    margin: 25px 0 12px;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: 24px;
}

.info-card p,
.battery-card p,
.solar-feature p {
    color: #6B7280;
    line-height: 1.7;
}

.example-box {
    margin-top: 28px;
    padding: 38px;
    border-radius: 26px;
    background: #111827;
}

.example-label,
.card-label,
.load-label,
.level-tag {
    color: #FF6800;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .13em;
}

.example-box h3 {
    margin: 15px 0 12px;
    color: white;
    font-family: Poppins, sans-serif;
    font-size: 27px;
}

.example-box p {
    max-width: 800px;
    color: #D1D5DB;
    line-height: 1.7;
}

.example-box strong {
    display: block;
    margin-top: 24px;
    color: #FF9B58;
}

.battery-card.featured {
    border: 2px solid #FF6800;
    box-shadow: 0 18px 50px rgba(255,104,0,.1);
}

.battery-icon,
.feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 17px;
    background: #FFF3EA;
    font-size: 28px;
}

.card-label {
    display: block;
    margin-top: 22px;
}

.formula-box {
    margin-top: 30px;
    padding: 38px;
    border: 1px solid rgba(255,104,0,.2);
    border-radius: 26px;
    background: #FFF8F3;
    text-align: center;
}

.formula-title {
    color: #6B7280;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .13em;
}

.formula {
    margin-top: 15px;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
}

.formula-box p {
    max-width: 700px;
    margin: 15px auto 0;
    color: #6B7280;
    line-height: 1.7;
}

.solar-grid {
    grid-template-columns: repeat(4, 1fr);
}

.solar-feature {
    background: #FAFAFA;
}

.solar-feature h3 {
    font-size: 22px;
}

.load-grid {
