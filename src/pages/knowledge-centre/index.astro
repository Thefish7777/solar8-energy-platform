---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout
    title="Knowledge Centre | Solar Power Information | Solar8"
    description="Learn about solar panels, inverters, batteries, solar systems and system sizing with the Solar8 Knowledge Centre."
>

<Navigation />

<main>

    <!-- HERO -->

    <section class="knowledge-hero">

        <div class="solar-container">

            <div class="hero-content">

                <span class="eyebrow">
                    SOLAR8 KNOWLEDGE CENTRE
                </span>

                <h1>
                    Understand Solar.
                    <span>Make Better Decisions.</span>
                </h1>

                <p>
                    New to solar or trying to understand what system is right
                    for your property? Start here. Our Knowledge Centre
                    explains the key components and concepts in simple,
                    practical language.
                </p>

                <div class="hero-actions">

                    <a href="/knowledge-centre/solar-basics/" class="primary-button">
                        Start with Solar Basics
                    </a>

                    <a href="/assessment/" class="secondary-button">
                        Get My FREE Assessment
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- INTRODUCTION -->

    <section class="intro-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    START HERE
                </span>

                <h2>
                    Solar doesn't have to be complicated.
                </h2>

                <p>
                    Understanding a few important concepts can make it much
                    easier to compare solar systems and decide what your
                    property actually needs.
                </p>

            </div>


            <div class="learning-path">

                <div class="path-step">

                    <span class="path-number">
                        01
                    </span>

                    <div class="path-icon">
                        ☀
                    </div>

                    <h3>
                        Learn the Basics
                    </h3>

                    <p>
                        Understand how solar panels, inverters, batteries and
                        your electrical system work together.
                    </p>

                    <a href="/knowledge-centre/solar-basics/">
                        Solar Basics →
                    </a>

                </div>


                <div class="path-line"></div>


                <div class="path-step">

                    <span class="path-number">
                        02
                    </span>

                    <div class="path-icon">
                        ⚡
                    </div>

                    <h3>
                        Understand the Components
                    </h3>

                    <p>
                        Learn what solar panels, inverters and batteries do,
                        and what specifications actually matter.
                    </p>

                    <a href="/knowledge-centre/panels/">
                        Explore Components →
                    </a>

                </div>


                <div class="path-line"></div>


                <div class="path-step">

                    <span class="path-number">
                        03
                    </span>

                    <div class="path-icon">
                        📐
                    </div>

                    <h3>
                        Understand Your Requirements
                    </h3>

                    <p>
                        Your electricity usage, appliances and backup
                        requirements determine the type of system you need.
                    </p>

                    <a href="/assessment/">
                        Start Assessment →
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- KNOWLEDGE CARDS -->

    <section class="topics-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    EXPLORE THE KNOWLEDGE CENTRE
                </span>

                <h2>
                    Choose a topic
                </h2>

                <p>
                    Explore the areas that matter when planning or
                    understanding a solar energy system.
                </p>

            </div>


            <div class="topics-grid">

                <!-- SOLAR BASICS -->

                <article class="topic-card featured">

                    <div class="topic-top">

                        <div class="topic-icon">
                            ☀
                        </div>

                        <span class="topic-number">
                            01
                        </span>

                    </div>

                    <span class="topic-label">
                        START HERE
                    </span>

                    <h3>
                        Solar Basics
                    </h3>

                    <p>
                        A simple introduction to solar energy and how panels,
                        inverters, batteries and your electrical system work
                        together.
                    </p>

                    <a href="/knowledge-centre/solar-basics/">
                        Learn Solar Basics
                        <span>→</span>
                    </a>

                </article>


                <!-- PANELS -->

                <article class="topic-card">

                    <div class="topic-top">

                        <div class="topic-icon">
                            ☀
                        </div>

                        <span class="topic-number">
                            02
                        </span>

                    </div>

                    <span class="topic-label">
                        COMPONENT
                    </span>

                    <h3>
                        Solar Panels
                    </h3>

                    <p>
                        Understand how solar panels generate electricity and
                        the factors that affect their performance and output.
                    </p>

                    <a href="/knowledge-centre/panels/">
                        Learn About Solar Panels
                        <span>→</span>
                    </a>

                </article>


                <!-- INVERTERS -->

                <article class="topic-card">

                    <div class="topic-top">

                        <div class="topic-icon">
                            ⚡
                        </div>

                        <span class="topic-number">
                            03
                        </span>

                    </div>

                    <span class="topic-label">
                        COMPONENT
                    </span>

                    <h3>
                        Inverters
                    </h3>

                    <p>
                        Learn what an inverter does and understand the
                        difference between grid-tied, hybrid and backup
                        inverter systems.
                    </p>

                    <a href="/knowledge-centre/inverters/">
                        Learn About Inverters
                        <span>→</span>
                    </a>

                </article>


                <!-- BATTERIES -->

                <article class="topic-card">

                    <div class="topic-top">

                        <div class="topic-icon">
                            🔋
                        </div>

                        <span class="topic-number">
                            04
                        </span>

                    </div>

                    <span class="topic-label">
                        COMPONENT
                    </span>

                    <h3>
                        Batteries
                    </h3>

                    <p>
                        Understand battery capacity, energy storage,
                        discharge and how batteries can provide backup power
                        when solar production or grid electricity is
                        unavailable.
                    </p>

                    <a href="/knowledge-centre/batteries/">
                        Learn About Batteries
                        <span>→</span>
                    </a>

                </article>


                <!-- SYSTEM SIZING -->

                <article class="topic-card assessment-card">

                    <div class="topic-top">

                        <div class="topic-icon">
                            📐
                        </div>

                        <span class="topic-number">
                            05
                        </span>

                    </div>

                    <span class="topic-label">
                        YOUR PROPERTY
                    </span>

                    <h3>
                        System Sizing & Backup Power
                    </h3>

                    <p>
                        Your ideal solar system depends on your electricity
                        usage, appliances, available space and backup
                        requirements.
                    </p>

                    <a href="/assessment/">
                        Get My FREE Assessment
                        <span>→</span>
                    </a>

                </article>

            </div>

        </div>

    </section>


    <!-- SYSTEM TYPES -->

    <section class="systems-section">

        <div class="solar-container">

            <div class="section-heading">

                <span class="eyebrow">
                    UNDERSTANDING SYSTEMS
                </span>

                <h2>
                    What type of solar system are you considering?
                </h2>

                <p>
                    Solar systems can be designed for different objectives.
                    Understanding the differences can help you identify what
                    matters most for your property.
                </p>

            </div>


            <div class="systems-grid">

                <div class="system-card">

                    <div class="system-icon">
                        ☀
                    </div>

                    <h3>
                        Solar Savings
                    </h3>

                    <p>
                        Use solar energy during the day to reduce the amount
                        of electricity purchased from the grid.
                    </p>

                    <a href="/systems/">
                        Explore Solar Systems →
                    </a>

                </div>


                <div class="system-card highlighted">

                    <div class="system-icon">
                        🔋
                    </div>

                    <h3>
                        Solar + Battery
                    </h3>

                    <p>
                        Combine solar generation with battery storage to
                        increase energy availability and provide backup
                        during grid interruptions.
                    </p>

                    <a href="/systems/">
                        Explore Solar Systems →
                    </a>

                </div>


                <div class="system-card">

                    <div class="system-icon">
                        ⚡
                    </div>

                    <h3>
                        Backup Power
                    </h3>

                    <p>
                        Focus on keeping important appliances and circuits
                        running when grid electricity is unavailable.
                    </p>

                    <a href="/assessment/">
                        Assess My Requirements →
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- TERMINOLOGY -->

    <section class="terms-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    SOLAR TERMINOLOGY
                </span>

                <h2>
                    A few terms worth knowing
                </h2>

                <p>
                    These are some of the most common terms you'll encounter
                    when comparing solar systems.
                </p>

            </div>


            <div class="terms-grid">

                <div class="term">

                    <strong>kW</strong>

                    <p>
                        A measure of power. In solar systems, inverter
                        capacity is commonly expressed in kilowatts.
                    </p>

                </div>


                <div class="term">

                    <strong>kWh</strong>

                    <p>
                        A measure of energy. Battery storage capacity is
                        commonly expressed in kilowatt-hours.
                    </p>

                </div>


                <div class="term">

                    <strong>DC</strong>

                    <p>
                        Direct current. Solar panels generate DC electricity.
                    </p>

                </div>


                <div class="term">

                    <strong>AC</strong>

                    <p>
                        Alternating current. Most household appliances use
                        AC electricity.
                    </p>

                </div>


                <div class="term">

                    <strong>Load</strong>

                    <p>
                        The electrical demand created by appliances,
                        equipment and other devices.
                    </p>

                </div>


                <div class="term">

                    <strong>Battery Capacity</strong>

                    <p>
                        The amount of electrical energy a battery can store,
                        normally expressed in kWh.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="knowledge-cta">

        <div class="solar-container">

            <div class="cta-content">

                <span class="eyebrow">
                    READY TO TAKE THE NEXT STEP?
                </span>

                <h2>
                    Find out what your property actually needs.
                </h2>

                <p>
                    There is no single solar system that is right for every
                    property. Your electricity usage, appliances, backup
                    requirements and available space all matter.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Start My FREE Assessment
                    </a>

                    <a href="/knowledge-centre/solar-basics/" class="secondary-button">
                        Start with Solar Basics
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<Footer />


<style>

.solar-container {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
}


/* =========================================================
   HERO
========================================================= */

.knowledge-hero {
    padding: 180px 0 120px;

    background:
        radial-gradient(
            circle at 82% 18%,
            rgba(255,104,0,.14),
            transparent 35%
        ),
        linear-gradient(
            180deg,
            #ffffff 0%,
            #FAFAFA 100%
        );
}

.hero-content {
    max-width: 850px;
}

.eyebrow {
    display: inline-block;

    color: #FF6800;

    font-size: 13px;
    font-weight: 800;

    letter-spacing: .14em;
}

.knowledge-hero h1 {
    margin: 20px 0 0;

    color: #111827;

    font-family: Poppins, sans-serif;

    font-size: clamp(3.2rem, 6vw, 5.8rem);

    line-height: 1.02;

    letter-spacing: -.045em;
}

.knowledge-hero h1 span {
    display: block;
    color: #FF6800;
}

.knowledge-hero p {
    max-width: 760px;

    margin-top: 30px;

    color: #6B7280;

    font-family: Inter, sans-serif;

    font-size: 20px;

    line-height: 1.7;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;

    gap: 16px;

    margin-top: 36px;
}

.primary-button,
.secondary-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 56px;

    padding: 0 28px;

    border-radius: 14px;

    font-weight: 700;

    text-decoration: none;

    transition: all .3s ease;
}

.primary-button {
    background: #FF6800;
    color: white;
}

.primary-button:hover {
    background: #E65E00;
    transform: translateY(-2px);
}

.secondary-button {
    border: 1px solid #D1D5DB;

    color: #374151;

    background: white;
}

.secondary-button:hover {
    border-color: #FF6800;
    color: #FF6800;
}


/* =========================================================
   GENERAL SECTIONS
========================================================= */

.intro-section,
.topics-section,
.systems-section,
.terms-section {
    padding: 110px 0;

    background: white;
}

.section-heading {
    max-width: 760px;

    margin-bottom: 60px;
}

.section-heading.centered {
    margin-left: auto;
    margin-right: auto;

    text-align: center;
}

.section-heading h2 {
    margin: 16px 0 0;

    color: #111827;

    font-family: Poppins, sans-serif;

    font-size: clamp(2.3rem, 4vw, 3.3rem);

    line-height: 1.1;
}

.section-heading p {
    margin-top: 20px;

    color: #6B7280;

    font-size: 18px;

    line-height: 1.7;
}


/* =========================================================
   LEARNING PATH
========================================================= */

.intro-section {
    background: #FAFAFA;
}

.learning-path {
    display: grid;

    grid-template-columns: 1fr auto 1fr auto 1fr;

    align-items: center;

    gap: 22px;
}

.path-step {
    position: relative;

    min-height: 330px;

    padding: 36px;

    border: 1px solid #E5E7EB;

    border-radius: 26px;

    background: white;

    box-shadow: 0 5px 18px rgba(0,0,0,.04);
}

.path-number {
    position: absolute;

    top: 28px;
    right: 30px;

    color: #D1D5DB;

    font-size: 12px;

    font-weight: 800;
}

.path-icon {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 64px;
    height: 64px;

    border-radius: 18px;

    background: #FFF3EA;

    font-size: 30px;
}

.path-step h3 {
    margin-top: 25px;

    color: #111827;

    font-family: Poppins, sans-serif;

    font-size: 24px;
}

.path-step p {
    margin-top: 12px;

    color: #6B7280;

    line-height: 1.7;
}

.path-step a {
    display: inline-block;

    margin-top: 24px;

    color: #FF6800;

    font-weight: 700;

    text-decoration: none;
}

.path-line {
    width: 50px;

    height: 2px;

    background: #FF6800;

    opacity: .45;
}


/* =========================================================
   TOPICS
========================================================= */

.topics-section {
    background: #F4F5F7;
}

.topics-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 24px;
}

.topic-card {
    position: relative;

    padding: 34px;

    border: 1px solid #E5E7EB;

    border-radius: 26px;

    background: white;

    box-shadow: 0 5px 18px rgba(0,0,0,.04);

    transition: all .3s ease;
}

.topic-card:hover {
    transform: translateY(-6px);

    box-shadow: 0 20px 45px rgba(0,0,0,.09);
}

.topic-card.featured {
    border: 2px solid #FF6800;
}

.topic-card.assessment-card {
    background:
        radial-gradient(
            circle at 90% 10%,
            rgba(255,104,0,.10),
            transparent 35%
        ),
        white;
}

.topic-top {
    display: flex;

    align-items: flex-start;
    justify-content: space-between;
}

.topic-icon {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 62px;
    height: 62px;

    border-radius: 18px;

    background: #FFF3EA;

    font-size: 30px;
}

.topic-number {
    color: #D1D5DB;

    font-size: 12px;

    font-weight: 800;
}

.topic-label {
    display: inline-block;

    margin-top: 25px;

    color: #FF6800;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: .12em;
}

.topic-card h3 {
    margin: 10px 0 12px;

    color: #111827;

    font-family: Poppins, sans-serif;

    font-size: 27px;
}

.topic-card p {
    color: #6B7280;

    line-height: 1.7;
}

.topic-card a {
    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-top: 26px;

    color: #FF6800;

    font-weight: 700;

    text-decoration: none;
}

.topic-card a span {
    font-size: 20px;
}


/* =========================================================
   SYSTEM TYPES
========================================================= */

.systems-section {
    background: white;
}

.systems-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 24px;
}

.system-card {
    padding: 38px;

    border: 1px solid #E5E7EB;

    border-radius: 26px;

    background: #FAFAFA;
}

.system-card.highlighted {
    border: 2px solid #FF6800;

    background: #FFF9F5;

    box-shadow: 0 18px 50px rgba(255,104,0,.08);
}

.system-icon {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 60px;
    height: 60px;

    border-radius: 18px;

    background: #FFF3EA;

    font-size: 29px;
}

.system-card h3 {
    margin-top: 25px;

    color: #111827;

    font-family: Poppins, sans-serif;

    font-size: 26px;
}

.system-card p {
    margin-top: 12px;

    color: #6B7280;

    line-height: 1.7;
}

.system-card a {
    display: inline-block;

    margin-top: 24px;

    color: #FF6800;

    font-weight: 700;

    text-decoration: none;
}


/* =========================================================
   TERMS
========================================================= */

.terms-section {
    background: #FAFAFA;
}

.terms-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 1px;

    overflow: hidden;

    border: 1px solid #E5E7EB;

    border-radius: 24px;

    background: #E5E7EB;
}

.term {
    padding: 34px;

    background: white;
}

.term strong {
    color: #FF6800;

    font-family: Poppins, sans-serif;

    font-size: 22px;
}

.term p {
    margin-top: 10px;

    color: #6B7280;

    line-height: 1.65;
}


/* =========================================================
   CTA
========================================================= */

.knowledge-cta {
    padding: 110px 0;

    background:
        radial-gradient(
            circle at 85% 30%,
            rgba(255,104,0,.22),
            transparent 35%
        ),
        #111827;
}

.cta-content {
    max-width: 850px;
}

.cta-content h2 {
    margin-top: 18px;

    color: white;

    font-family: Poppins, sans-serif;

    font-size: clamp(2.4rem, 5vw, 4rem);

    line-height: 1.08;
}

.cta-content p {
    margin-top: 22px;

    color: #D1D5DB;

    font-size: 19px;

    line-height: 1.7;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

    .topics-grid,
    .systems-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .learning-path {
        grid-template-columns: 1fr;

        gap: 18px;
    }

    .path-line {
        width: 2px;
        height: 35px;

        margin: 0 auto;
    }

}


@media (max-width: 768px) {

    .solar-container {
        width: min(100% - 32px, 1440px);
    }

    .knowledge-hero {
        padding: 140px 0 80px;
    }

    .knowledge-hero h1 {
        font-size: clamp(2.8rem, 12vw, 4rem);
    }

    .knowledge-hero p {
        font-size: 17px;
    }

    .intro-section,
    .topics-section,
    .systems-section,
    .terms-section,
    .knowledge-cta {
        padding: 80px 0;
    }

    .topics-grid,
    .systems-grid,
    .terms-grid {
        grid-template-columns: 1fr;
    }

    .hero-actions {
        flex-direction: column;

        align-items: stretch;
    }

    .primary-button,
    .secondary-button {
        width: 100%;
    }

}


@media (max-width: 420px) {

    .solar-container {
        width: calc(100% - 24px);
    }

    .path-step,
    .topic-card,
    .system-card {
        padding: 26px;

        border-radius: 20px;
    }

}

</style>

</BaseLayout>