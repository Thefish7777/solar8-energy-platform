---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
---

<BaseLayout
    title="Solar Inverters | How Inverters Work | Solar8"
    description="Learn how solar inverters work, the difference between hybrid, grid-tied and off-grid inverters, inverter sizing, battery compatibility and choosing the right inverter for your property."
>

<Navigation />

<main>

    <!-- HERO -->

    <section class="inverter-hero">

        <div class="solar-container">

            <div class="hero-content">

                <span class="eyebrow">
                    SOLAR8 KNOWLEDGE CENTRE
                </span>

                <h1>
                    Solar Inverters
                    <span>Made Simple.</span>
                </h1>

                <p>
                    The inverter is the control centre of a modern solar
                    energy system. Learn what it does, how it works and
                    how to choose the right size for your property.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Get My FREE Assessment
                    </a>

                    <a href="/systems/" class="secondary-button">
                        Explore Solar Systems
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- WHAT IS AN INVERTER -->

    <section class="intro-section">

        <div class="solar-container">

            <div class="section-heading">

                <span class="eyebrow">
                    THE BASICS
                </span>

                <h2>
                    What does a solar inverter actually do?
                </h2>

                <p>
                    Solar panels produce DC electricity, while most
                    appliances in your home use AC electricity. The inverter
                    manages the conversion between the two.
                </p>

            </div>


            <div class="intro-grid">

                <div class="intro-text">

                    <p>
                        Solar panels generate direct current (DC) electricity.
                        Your home's electrical system and normal appliances
                        generally operate using alternating current (AC).
                    </p>

                    <p>
                        The inverter converts DC electricity into usable AC
                        electricity and manages how power moves between your
                        solar panels, batteries, home and the electrical grid.
                    </p>

                    <p>
                        Modern hybrid inverters can perform considerably more
                        than simple DC-to-AC conversion. They can control
                        battery charging, manage grid electricity, monitor
                        solar production and provide backup power.
                    </p>

                </div>


                <div class="inverter-diagram">

                    <div class="diagram-title">
                        BASIC ENERGY FLOW
                    </div>

                    <div class="energy-flow">

                        <div class="energy-item">

                            <div class="energy-icon">
                                ☀
                            </div>

                            <strong>
                                Solar Panels
                            </strong>

                            <small>
                                DC electricity
                            </small>

                        </div>


                        <div class="flow-arrow">
                            →
                        </div>


                        <div class="energy-item inverter-main">

                            <div class="energy-icon">
                                ⚡
                            </div>

                            <strong>
                                Inverter
                            </strong>

                            <small>
                                Converts & manages power
                            </small>

                        </div>


                        <div class="flow-arrow">
                            →
                        </div>


                        <div class="energy-item">

                            <div class="energy-icon">
                                ⌂
                            </div>

                            <strong>
                                Property
                            </strong>

                            <small>
                                AC electricity
                            </small>

                        </div>

                    </div>


                    <div class="battery-flow">

                        <div class="vertical-arrow">
                            ↕
                        </div>

                        <div class="battery-item">

                            <div class="energy-icon">
                                🔋
                            </div>

                            <strong>
                                Battery
                            </strong>

                            <small>
                                Stores energy
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- TYPES -->

    <section class="types-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    TYPES OF INVERTERS
                </span>

                <h2>
                    Which type of inverter do you need?
                </h2>

                <p>
                    Different inverter types are designed for different
                    energy requirements.
                </p>

            </div>


            <div class="types-grid">

                <article class="type-card">

                    <span class="type-number">
                        01
                    </span>

                    <div class="type-icon">
                        ⚡
                    </div>

                    <span class="type-label">
                        GRID-TIED
                    </span>

                    <h3>
                        Grid-Tied Inverter
                    </h3>

                    <p>
                        Designed primarily to use solar power to reduce
                        electricity purchased from the grid.
                    </p>

                    <ul>
                        <li>Good for daytime solar savings</li>
                        <li>Usually no battery required</li>
                        <li>Works with the electrical grid</li>
                    </ul>

                </article>


                <article class="type-card featured">

                    <span class="type-number">
                        02
                    </span>

                    <div class="type-icon">
                        🔋
                    </div>

                    <span class="type-label">
                        HYBRID
                    </span>

                    <h3>
                        Hybrid Inverter
                    </h3>

                    <p>
                        Combines solar, battery storage and grid electricity
                        in one energy-management system.
                    </p>

                    <ul>
                        <li>Solar power</li>
                        <li>Battery storage</li>
                        <li>Backup during outages</li>
                        <li>Flexible energy management</li>
                    </ul>

                </article>


                <article class="type-card">

                    <span class="type-number">
                        03
                    </span>

                    <div class="type-icon">
                        🌄
                    </div>

                    <span class="type-label">
                        OFF-GRID
                    </span>

                    <h3>
                        Off-Grid Inverter
                    </h3>

                    <p>
                        Designed for systems that operate independently of
                        the electrical grid.
                    </p>

                    <ul>
                        <li>Independent power system</li>
                        <li>Requires appropriate battery storage</li>
                        <li>Suitable for remote applications</li>
                    </ul>

                </article>

            </div>

        </div>

    </section>


    <!-- INVERTER SIZE -->

    <section class="size-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    INVERTER SIZING
                </span>

                <h2>
                    What does a 5 kW inverter mean?
                </h2>

                <p>
                    An inverter's kW rating describes the amount of power
                    it can supply. It is one of the most important numbers
                    when comparing systems.
                </p>

            </div>


            <div class="size-layout">

                <div class="size-card">

                    <div class="big-number">
                        5
                        <span>kW</span>
                    </div>

                    <h3>
                        Example inverter rating
                    </h3>

                    <p>
                        A 5 kW inverter can generally supply up to around
                        5 kW of AC power, subject to the inverter's specific
                        specifications and operating conditions.
                    </p>

                </div>


                <div class="size-text">

                    <h3>
                        Your inverter needs to match your electrical demand.
                    </h3>

                    <p>
                        The important question is not simply how much solar
                        panel capacity you have. It is also how much power
                        your appliances may require at the same time.
                    </p>

                    <p>
                        For example, a property running several high-power
                        appliances simultaneously may require a larger
                        inverter than a property with lower simultaneous
                        demand.
                    </p>

                    <p>
                        This is why proper system assessment is important
                        before selecting an inverter.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- LOAD EXAMPLES -->

    <section class="load-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    UNDERSTANDING LOAD
                </span>

                <h2>
                    What appliances affect inverter sizing?
                </h2>

                <p>
                    Appliances with high electrical demand can have a
                    significant effect on the inverter size required.
                </p>

            </div>


            <div class="load-grid">

                <div class="load-card">

                    <div class="load-icon">
                        🔥
                    </div>

                    <h3>
                        Electric Stove
                    </h3>

                    <p>
                        High electrical demand, especially when multiple
                        cooking elements are used simultaneously.
                    </p>

                </div>


                <div class="load-card">

                    <div class="load-icon">
                        ♨
                    </div>

                    <h3>
                        Geyser
                    </h3>

                    <p>
                        Heating water can create a significant electrical
                        load when the element is operating.
                    </p>

                </div>


                <div class="load-card">

                    <div class="load-icon">
                        ❄
                    </div>

                    <h3>
                        Air Conditioning
                    </h3>

                    <p>
                        Compressors can require substantial power,
                        particularly during startup and high-demand periods.
                    </p>

                </div>


                <div class="load-card">

                    <div class="load-icon">
                        🚿
                    </div>

                    <h3>
                        Pumps
                    </h3>

                    <p>
                        Pool pumps, borehole pumps and other motors can
                        create starting and running loads.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- BATTERY COMPATIBILITY -->

    <section class="battery-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    INVERTERS & BATTERIES
                </span>

                <h2>
                    Can any battery work with any inverter?
                </h2>

                <p>
                    No. Battery and inverter compatibility is an important
                    part of designing a reliable system.
                </p>

            </div>


            <div class="battery-grid">

                <div class="battery-point">

                    <div class="point-number">
                        01
                    </div>

                    <h3>
                        Voltage compatibility
                    </h3>

                    <p>
                        The battery's electrical characteristics must be
                        compatible with the inverter's battery input.
                    </p>

                </div>


                <div class="battery-point">

                    <div class="point-number">
                        02
                    </div>

                    <h3>
                        Communication
                    </h3>

                    <p>
                        Compatible batteries and inverters may communicate
                        through supported battery-management protocols.
                    </p>

                </div>


                <div class="battery-point">

                    <div class="point-number">
                        03
                    </div>

                    <h3>
                        Charge & discharge limits
                    </h3>

                    <p>
                        The inverter and battery must be correctly matched
                        for charging and discharge requirements.
                    </p>

                </div>


                <div class="battery-point">

                    <div class="point-number">
                        04
                    </div>

                    <h3>
                        Manufacturer compatibility
                    </h3>

                    <p>
                        Always check the manufacturer's approved
                        compatibility information before combining products.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- SOLAR INPUT -->

    <section class="input-section">

        <div class="solar-container">

            <div class="section-heading">

                <span class="eyebrow">
                    SOLAR INPUT
                </span>

                <h2>
                    Your inverter also has a solar input limit.
                </h2>

                <p>
                    An inverter may have a different maximum solar input
                    capacity from its AC output rating.
                </p>

            </div>


            <div class="input-grid">

                <div class="input-card">

                    <span>
                        AC OUTPUT
                    </span>

                    <strong>
                        Inverter Power
                    </strong>

                    <p>
                        The AC rating describes the amount of power the
                        inverter can supply to your electrical system.
                    </p>

                </div>


                <div class="input-card highlighted">

                    <span>
                        PV INPUT
                    </span>

                    <strong>
                        Solar Capacity
                    </strong>

                    <p>
                        The inverter may allow a larger amount of solar
                        panel capacity to be connected, depending on its
                        specifications.
                    </p>

                </div>


                <div class="input-card">

                    <span>
                        BATTERY
                    </span>

                    <strong>
                        Energy Storage
                    </strong>

                    <p>
                        Battery capacity is normally expressed in kWh and
                        determines how much stored energy is available.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- FEATURES -->

    <section class="features-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    FEATURES TO LOOK FOR
                </span>

                <h2>
                    Modern inverters can do much more than conversion.
                </h2>

            </div>


            <div class="features-grid">

                <div class="feature">

                    <strong>
                        Battery Management
                    </strong>

                    <p>
                        Controls battery charging and discharging.
                    </p>

                </div>


                <div class="feature">

                    <strong>
                        Backup Output
                    </strong>

                    <p>
                        Provides power to selected circuits during outages.
                    </p>

                </div>


                <div class="feature">

                    <strong>
                        Monitoring
                    </strong>

                    <p>
                        Tracks solar production, consumption and battery
                        status.
                    </p>

                </div>


                <div class="feature">

                    <strong>
                        Load Management
                    </strong>

                    <p>
                        Helps control how available energy is distributed.
                    </p>

                </div>


                <div class="feature">

                    <strong>
                        Grid Management
                    </strong>

                    <p>
                        Controls interaction with the electrical grid.
                    </p>

                </div>


                <div class="feature">

                    <strong>
                        Expandability
                    </strong>

                    <p>
                        Some systems can be expanded with additional batteries
                        or inverter capacity.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- TERMINOLOGY -->

    <section class="terms-section">

        <div class="solar-container">

            <div class="section-heading">

                <span class="eyebrow">
                    INVERTER TERMINOLOGY
                </span>

                <h2>
                    Terms you'll see when comparing inverters
                </h2>

            </div>


            <div class="terms-grid">

                <div class="term">

                    <strong>
                        kW
                    </strong>

                    <p>
                        Power rating of the inverter's AC output.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        kVA
                    </strong>

                    <p>
                        Apparent power rating used for some electrical
                        equipment and inverter specifications.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        MPPT
                    </strong>

                    <p>
                        Maximum Power Point Tracking. Helps the inverter
                        extract available power from solar panels.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        PV Input
                    </strong>

                    <p>
                        The solar-panel input side of the inverter.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        Backup Output
                    </strong>

                    <p>
                        The inverter output used to supply selected loads
                        during a grid outage.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        EPS
                    </strong>

                    <p>
                        Emergency Power Supply. A term commonly used for
                        backup functionality.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- CHOOSING -->

    <section class="choose-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    CHOOSING YOUR INVERTER
                </span>

                <h2>
                    The right inverter depends on your property.
                </h2>

                <p>
                    There is no single inverter size that is right for
                    every home or business.
                </p>

            </div>


            <div class="choose-grid">

                <div class="choose-card">

                    <span>
                        01
                    </span>

                    <h3>
                        Understand your load
                    </h3>

                    <p>
                        Identify which appliances you use and which may
                        operate simultaneously.
                    </p>

                </div>


                <div class="choose-card">

                    <span>
                        02
                    </span>

                    <h3>
                        Determine backup requirements
                    </h3>

                    <p>
                        Decide which appliances must remain operational
                        during a power interruption.
                    </p>

                </div>


                <div class="choose-card">

                    <span>
                        03
                    </span>

                    <h3>
                        Consider solar production
                    </h3>

                    <p>
                        Your available roof area, panel capacity and
                        sunlight affect the solar side of the system.
                    </p>

                </div>


                <div class="choose-card">

                    <span>
                        04
                    </span>

                    <h3>
                        Match the battery
                    </h3>

                    <p>
                        If battery storage is required, the inverter and
                        battery should be selected as a compatible system.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="inverter-cta">

        <div class="solar-container">

            <div class="cta-content">

                <span class="eyebrow">
                    NEED HELP CHOOSING?
                </span>

                <h2>
                    Let's work out what your property actually needs.
                </h2>

                <p>
                    Solar8 can help you understand your electricity
                    requirements and identify a suitable inverter,
                    battery and solar configuration.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Start My FREE Assessment
                    </a>

                    <a href="/knowledge-centre" class="secondary-button">
                        Back to Knowledge Centre
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<Footer />

<style>

.solar-container {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
}

.inverter-hero {
    padding: 180px 0 120px;
    background:
        radial-gradient(
            circle at 82% 18%,
            rgba(255,104,0,.14),
            transparent 35%
        ),
        linear-gradient(
            180deg,
            #ffffff 0%,
            #FAFAFA 100%
        );
}

.hero-content {
    max-width: 850px;
}

.eyebrow {
    display: inline-block;
    color: #FF6800;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .14em;
}

.inverter-hero h1 {
    margin: 20px 0 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(3.2rem, 6vw, 5.8rem);
    line-height: 1.02;
    letter-spacing: -.045em;
}

.inverter-hero h1 span {
    display: block;
    color: #FF6800;
}

.inverter-hero p {
    max-width: 720px;
    margin-top: 30px;
    color: #6B7280;
    font-family: Inter, sans-serif;
    font-size: 20px;
    line-height: 1.7;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
}

.primary-button,
.secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all .3s ease;
}

.primary-button {
    background: #FF6800;
    color: white;
}

.primary-button:hover {
    background: #E65E00;
    transform: translateY(-2px);
}

.secondary-button {
    border: 1px solid #D1D5DB;
    color: #374151;
    background: white;
}

.secondary-button:hover {
    border-color: #FF6800;
    color: #FF6800;
}

.intro-section,
.size-section,
.battery-section,
.input-section,
.terms-section,
.choose-section {
    padding: 110px 0;
    background: white;
}

.section-heading {
    max-width: 760px;
    margin-bottom: 60px;
}

.section-heading.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.section-heading h2 {
    margin: 16px 0 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(2.3rem, 4vw, 3.3rem);
    line-height: 1.1;
}

.section-heading p {
    margin-top: 20px;
    color: #6B7280;
    font-size: 18px;
    line-height: 1.7;
}

.intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.intro-text p {
    margin-bottom: 22px;
    color: #4B5563;
    font-size: 18px;
    line-height: 1.8;
}

.inverter-diagram {
    padding: 38px;
    border: 1px solid #E5E7EB;
    border-radius: 28px;
    background: #F8F9FA;
}

.diagram-title {
    margin-bottom: 35px;
    color: #6B7280;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
}

.energy-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
}

.energy-item {
    flex: 1;
    text-align: center;
}

.energy-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border-radius: 18px;
    background: #FFF3EA;
    font-size: 30px;
}

.energy-item strong,
.battery-item strong {
    display: block;
    color: #111827;
}

.energy-item small,
.battery-item small {
    display: block;
    margin-top: 5px;
    color: #6B7280;
    line-height: 1.4;
}

.inverter-main .energy-icon {
    background: #FF6800;
    color: white;
}

.flow-arrow,
.vertical-arrow {
    color: #FF6800;
    font-size: 28px;
    font-weight: 700;
}

.battery-flow {
    margin-top: 24px;
    text-align: center;
}

.vertical-arrow {
    margin-bottom: 8px;
}

.battery-item {
    width: 200px;
    margin: 0 auto;
    padding: 20px;
    border: 1px solid rgba(255,104,0,.25);
    border-radius: 18px;
    background: white;
}

.types-section {
    padding: 110px 0;
    background: #F4F5F7;
}

.types-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
}

.type-card {
    position: relative;
    padding: 40px;
    border: 1px solid #E5E7EB;
    border-radius: 26px;
    background: white;
    box-shadow: 0 6px 18px rgba(0,0,0,.04);
}

.type-card.featured {
    border: 2px solid #FF6800;
    box-shadow: 0 18px 50px rgba(255,104,0,.1);
}

.type-number {
    position: absolute;
    top: 34px;
    right: 32px;
    color: #D1D5DB;
    font-size: 12px;
    font-weight: 800;
}

.type-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    margin-bottom: 25px;
    border-radius: 18px;
    background: #FFF3EA;
    font-size: 28px;
}

.type-label {
    color: #FF6800;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
}

.type-card h3 {
    margin: 15px 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: 28px;
}

.type-card p {
    color: #6B7280;
    line-height: 1.7;
}

.type-card ul {
    margin: 25px 0 0;
    padding-left: 20px;
    color: #4B5563;
    line-height: 2;
}

.size-section {
    background: #111827;
}

.size-section .section-heading h2 {
    color: white;
}

.size-section .section-heading p {
    color: #D1D5DB;
}

.size-layout {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 70px;
    align-items: center;
}

.size-card {
    padding: 45px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 28px;
    background: rgba(255,255,255,.05);
    text-align: center;
}

.big-number {
    color: #FF6800;
    font-family: Poppins, sans-serif;
