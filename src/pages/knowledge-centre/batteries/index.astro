---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
---

<BaseLayout
    title="Solar Batteries | Battery Storage & Backup Power | Solar8"
    description="Learn how solar batteries work, understand battery capacity, usable energy, backup time, depth of discharge and how to choose the right battery storage system."
>

<Navigation />

<main>

    <!-- HERO -->

    <section class="battery-hero">

        <div class="battery-container">

            <div class="hero-content">

                <span class="eyebrow">
                    SOLAR8 KNOWLEDGE CENTRE
                </span>

                <h1>
                    Solar Batteries
                    <span>Made Simple.</span>
                </h1>

                <p>
                    Understand how solar batteries store electricity,
                    how much energy they can provide and how battery
                    storage can keep your home powered when the sun
                    isn't shining or the grid goes down.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Get My FREE Assessment
                    </a>

                    <a href="/systems/" class="secondary-button">
                        Explore Solar Systems
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- INTRODUCTION -->

    <section class="intro-section">

        <div class="battery-container">

            <div class="section-heading">

                <span class="eyebrow">
                    THE BASICS
                </span>

                <h2>
                    What does a solar battery do?
                </h2>

                <p>
                    A solar battery stores electrical energy so that
                    electricity generated by your solar system can be
                    used later.
                </p>

            </div>


            <div class="intro-grid">

                <div class="intro-text">

                    <p>
                        Solar panels produce the most electricity when
                        there is sunlight. Your household, however, may
                        continue using electricity after the sun has gone
                        down.
                    </p>

                    <p>
                        A battery allows some of the energy generated
                        during the day to be stored and used later.
                        Depending on the system design, it can also
                        provide backup power when the electrical grid
                        is unavailable.
                    </p>

                    <p>
                        The important point is that battery size should
                        be matched to your actual electricity usage and
                        the amount of backup you want.
                    </p>

                </div>


                <div class="battery-diagram">

                    <div class="diagram-title">
                        SIMPLE BATTERY ENERGY FLOW
                    </div>

                    <div class="energy-flow">

                        <div class="energy-item">

                            <div class="energy-icon">
                                ☀
                            </div>

                            <strong>
                                Solar
                            </strong>

                            <small>
                                Generates electricity
                            </small>

                        </div>


                        <div class="energy-arrow">
                            →
                        </div>


                        <div class="energy-item active">

                            <div class="energy-icon">
                                🔋
                            </div>

                            <strong>
                                Battery
                            </strong>

                            <small>
                                Stores energy
                            </small>

                        </div>


                        <div class="energy-arrow">
                            →
                        </div>


                        <div class="energy-item">

                            <div class="energy-icon">
                                ⌂
                            </div>

                            <strong>
                                Home
                            </strong>

                            <small>
                                Uses electricity
                            </small>

                        </div>

                    </div>


                    <div class="grid-note">

                        <span>
                            GRID
                        </span>

                        <p>
                            The grid can supplement the system when
                            solar and stored energy are insufficient.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- WHY BATTERIES -->

    <section class="benefits-section">

        <div class="battery-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    WHY ADD A BATTERY?
                </span>

                <h2>
                    More than just backup power
                </h2>

                <p>
                    Battery storage can serve several purposes depending
                    on how your solar system is configured.
                </p>

            </div>


            <div class="benefits-grid">

                <article class="benefit-card">

                    <div class="benefit-icon">
                        ⚡
                    </div>

                    <h3>
                        Backup Power
                    </h3>

                    <p>
                        Keep selected appliances and essential circuits
                        operating when the electrical grid goes down.
                    </p>

                </article>


                <article class="benefit-card">

                    <div class="benefit-icon">
                        ☀
                    </div>

                    <h3>
                        Use More Solar
                    </h3>

                    <p>
                        Store excess daytime solar generation and use
                        some of that energy later instead of buying as
                        much electricity from the grid.
                    </p>

                </article>


                <article class="benefit-card">

                    <div class="benefit-icon">
                        🌙
                    </div>

                    <h3>
                        Evening Energy
                    </h3>

                    <p>
                        Use stored energy after solar production falls
                        in the late afternoon and evening.
                    </p>

                </article>


                <article class="benefit-card">

                    <div class="benefit-icon">
                        🛡
                    </div>

                    <h3>
                        Greater Energy Independence
                    </h3>

                    <p>
                        Combining solar generation with battery storage
                        can reduce your dependence on grid electricity.
                    </p>

                </article>

            </div>

        </div>

    </section>


    <!-- BATTERY CAPACITY -->

    <section class="capacity-section">

        <div class="battery-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    UNDERSTANDING CAPACITY
                </span>

                <h2>
                    How big should your battery be?
                </h2>

                <p>
                    Battery capacity is normally measured in kilowatt-hours,
                    but the number printed on a battery is not necessarily
                    the amount of energy you should plan to use.
                </p>

            </div>


            <div class="capacity-grid">

                <div class="capacity-card">

                    <span class="capacity-number">
                        01
                    </span>

                    <h3>
                        Battery Capacity
                    </h3>

                    <div class="capacity-value">
                        kWh
                    </div>

                    <p>
                        The battery's rated energy storage capacity.
                        For example, a battery may have a nominal
                        capacity of 5 kWh.
                    </p>

                </div>


                <div class="capacity-card highlighted">

                    <span class="capacity-number">
                        02
                    </span>

                    <h3>
                        Usable Energy
                    </h3>

                    <div class="capacity-value">
                        Usable kWh
                    </div>

                    <p>
                        The amount of stored energy that can realistically
                        be used after considering the battery's operating
                        limits and system configuration.
                    </p>

                </div>


                <div class="capacity-card">

                    <span class="capacity-number">
                        03
                    </span>

                    <h3>
                        Your Load
                    </h3>

                    <div class="capacity-value">
                        kW
                    </div>

                    <p>
                        Your appliances determine how quickly stored
                        energy is consumed. Higher loads use battery
                        energy faster.
                    </p>

                </div>

            </div>


            <div class="capacity-note">

                <strong>
                    Important:
                </strong>

                <p>
                    A larger battery does not automatically mean a
                    longer backup period. Your backup time depends on
                    both the usable battery energy and the electrical
                    load being supplied.
                </p>

            </div>

        </div>

    </section>


    <!-- BACKUP TIME -->

    <section class="backup-section">

        <div class="battery-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    BACKUP TIME
                </span>

                <h2>
                    How long will a battery last?
                </h2>

                <p>
                    Backup duration depends on how much usable energy
                    is available and how much power your appliances
                    are consuming.
                </p>

            </div>


            <div class="backup-model">

                <div class="model-title">
                    A SIMPLE WAY TO THINK ABOUT IT
                </div>

                <div class="formula">
                    Backup Time ≈ Usable Battery Energy ÷ Average Load
                </div>

                <div class="model-explanation">

                    <div>
                        <strong>
                            More usable energy
                        </strong>

                        <span>
                            Generally increases backup duration.
                        </span>
                    </div>

                    <div>
                        <strong>
                            Higher electrical load
                        </strong>

                        <span>
                            Generally reduces backup duration.
                        </span>
                    </div>

                </div>

            </div>


            <div class="backup-examples">

                <article>

                    <span>
                        LOW LOAD
                    </span>

                    <h3>
                        Lights + Wi-Fi + TV
                    </h3>

                    <p>
                        A relatively small electrical load can allow
                        stored energy to last significantly longer.
                    </p>

                </article>


                <article>

                    <span>
                        MEDIUM LOAD
                    </span>

                    <h3>
                        Essential Home Loads
                    </h3>

                    <p>
                        Refrigeration, lighting, internet, selected
                        plugs and other essential circuits require
                        more battery energy.
                    </p>

                </article>


                <article>

                    <span>
                        HIGH LOAD
                    </span>

                    <h3>
                        Multiple Large Appliances
                    </h3>

                    <p>
                        High-power appliances can consume stored energy
                        much faster and may require a larger system.
                    </p>

                </article>

            </div>

        </div>

    </section>


    <!-- BATTERY CHEMISTRY -->

    <section class="chemistry-section">

        <div class="battery-container">

            <div class="section-heading">

                <span class="eyebrow">
                    BATTERY TECHNOLOGY
                </span>

                <h2>
                    Why lithium batteries are common in modern solar systems
                </h2>

                <p>
                    Battery chemistry affects usable capacity, lifespan,
                    operating characteristics, safety requirements and
                    system cost.
                </p>

            </div>


            <div class="chemistry-grid">

                <div class="chemistry-text">

                    <p>
                        Modern residential solar systems commonly use
                        lithium-based batteries because they can provide
                        a useful combination of energy density, cycle life,
                        efficiency and usable capacity.
                    </p>

                    <p>
                        Different lithium battery technologies exist, and
                        the specifications can vary significantly between
                        manufacturers and models.
                    </p>

                    <p>
                        When comparing batteries, it is therefore important
                        to look beyond the headline kWh capacity and consider
                        the complete technical specification.
                    </p>

                </div>


                <div class="spec-list">

                    <div class="spec">
                        <strong>
                            Capacity
                        </strong>

                        <span>
                            How much energy the battery stores
                        </span>
                    </div>


                    <div class="spec">
                        <strong>
                            Usable Capacity
                        </strong>

                        <span>
                            How much energy can practically be used
                        </span>
                    </div>


                    <div class="spec">
                        <strong>
                            Power Rating
                        </strong>

                        <span>
                            How much power the battery can deliver
                        </span>
                    </div>


                    <div class="spec">
                        <strong>
                            Cycle Life
                        </strong>

                        <span>
                            Expected number of charge and discharge cycles
                        </span>
                    </div>


                    <div class="spec">
                        <strong>
                            Warranty
                        </strong>

                        <span>
                            Manufacturer's coverage and operating conditions
                        </span>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- DEPTH OF DISCHARGE -->

    <section class="dod-section">

        <div class="battery-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    BATTERY TERMINOLOGY
                </span>

                <h2>
                    What is Depth of Discharge?
                </h2>

                <p>
                    Depth of Discharge, commonly called DoD, describes
                    how much of a battery's available capacity has been
                    used.
                </p>

            </div>


            <div class="dod-grid">

                <div class="dod-card">

                    <div class="dod-circle">
                        20%
                    </div>

                    <h3>
                        Light Use
                    </h3>

                    <p>
                        Only a relatively small portion of the battery's
                        available energy has been used.
                    </p>

                </div>


                <div class="dod-card highlighted">

                    <div class="dod-circle">
                        50%
                    </div>

                    <h3>
                        Moderate Use
                    </h3>

                    <p>
                        Approximately half of the available battery
                        energy has been consumed.
                    </p>

                </div>


                <div class="dod-card">

                    <div class="dod-circle">
                        80%
                    </div>

                    <h3>
                        Deeper Use
                    </h3>

                    <p>
                        A larger portion of the battery's available
                        capacity has been used.
                    </p>

                </div>

            </div>


            <div class="dod-note">

                <strong>
                    Remember:
                </strong>

                <span>
                    Battery manufacturers specify operating limits,
                    and the battery management system controls how
                    the battery is charged and discharged.
                </span>

            </div>

        </div>

    </section>


    <!-- BATTERY SIZING -->

    <section class="sizing-section">

        <div class="battery-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    SIZING YOUR SYSTEM
                </span>

                <h2>
                    Battery size should start with your electricity usage
                </h2>

                <p>
                    There is no single battery size that is right for
                    every household.
                </p>

            </div>


            <div class="sizing-grid">

                <div class="sizing-step">

                    <span>
                        01
                    </span>

                    <h3>
                        Understand Your Loads
                    </h3>

                    <p>
                        Identify the appliances and electrical circuits
                        that need to remain operational.
                    </p>

                </div>


                <div class="sizing-step">

                    <span>
                        02
                    </span>

                    <h3>
                        Determine Backup Requirements
                    </h3>

                    <p>
                        Decide how long you want selected appliances
                        to operate during a grid interruption.
                    </p>

                </div>


                <div class="sizing-step">

                    <span>
                        03
                    </span>

                    <h3>
                        Match Battery Capacity
                    </h3>

                    <p>
                        Choose a battery system with suitable usable
                        energy and power capability.
                    </p>

                </div>


                <div class="sizing-step">

                    <span>
                        04
                    </span>

                    <h3>
                        Match the Inverter
                    </h3>

                    <p>
                        The inverter and battery must be compatible
                        and correctly configured as part of the
                        complete system.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- IMPORTANT TERMS -->

    <section class="terms-section">

        <div class="battery-container">

            <div class="section-heading">

                <span class="eyebrow">
                    BATTERY TERMINOLOGY
                </span>

                <h2>
                    Terms you'll hear when comparing batteries
                </h2>

            </div>


            <div class="terms-grid">

                <div class="term">

                    <strong>
                        kWh
                    </strong>

                    <p>
                        A measure of energy. Battery capacity is commonly
                        expressed in kilowatt-hours.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        kW
                    </strong>

                    <p>
                        A measure of power. It describes how much
                        electrical power a battery or inverter can
                        deliver at a given time.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        Usable Capacity
                    </strong>

                    <p>
                        The portion of the battery's rated capacity
                        that can practically be used by the system.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        DoD
                    </strong>

                    <p>
                        Depth of Discharge. The proportion of available
                        battery capacity that has been used.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        Cycle
                    </strong>

                    <p>
                        A charge and discharge sequence. Battery
                        specifications commonly refer to expected
                        cycle life.
                    </p>

                </div>


                <div class="term">

                    <strong>
                        BMS
                    </strong>

                    <p>
                        Battery Management System. Electronics that
                        monitor and manage battery operation.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="battery-cta">

        <div class="battery-container">

            <div class="cta-content">

                <span class="eyebrow">
                    NEED HELP CHOOSING?
                </span>

                <h2>
                    Let's work out how much battery storage you actually need.
                </h2>

                <p>
                    The right battery depends on your electricity usage,
                    backup requirements, inverter and future energy plans.
                    Solar8 can help you understand the options before
                    you invest.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Start My FREE Assessment
                    </a>

                    <a href="/knowledge-centre" class="secondary-button">
                        Back to Knowledge Centre
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<Footer />

<style>

.battery-container {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
}


/* HERO */

.battery-hero {
    padding: 180px 0 120px;
    background:
        radial-gradient(
            circle at 82% 18%,
            rgba(255,104,0,.14),
            transparent 35%
        ),
        linear-gradient(
            180deg,
            #ffffff 0%,
            #FAFAFA 100%
        );
}

.hero-content {
    max-width: 850px;
}

.eyebrow {
    display: inline-block;
    color: #FF6800;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .14em;
}

.battery-hero h1 {
    margin: 20px 0 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(3.2rem, 6vw, 5.8rem);
    line-height: 1.02;
    letter-spacing: -.045em;
}

.battery-hero h1 span {
    display: block;
    color: #FF6800;
}

.battery-hero p {
    max-width: 740px;
    margin-top: 30px;
    color: #6B7280;
    font-family: Inter, sans-serif;
    font-size: 20px;
    line-height: 1.7;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
}

.primary-button,
.secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all .3s ease;
}

.primary-button {
    background: #FF6800;
    color: white;
}

.primary-button:hover {
    background: #E65E00;
    transform: translateY(-2px);
}

.secondary-button {
    border: 1px solid #D1D5DB;
    color: #374151;
    background: white;
}

.secondary-button:hover {
    border-color: #FF6800;
    color: #FF6800;
}


/* GENERAL SECTIONS */

.intro-section,
.capacity-section,
.chemistry-section,
.sizing-section,
.terms-section {
    padding: 110px 0;
    background: #ffffff;
}

.section-heading {
    max-width: 780px;
    margin-bottom: 60px;
}

.section-heading.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.section-heading h2 {
    margin: 16px 0 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(2.3rem, 4vw, 3.3rem);
    line-height: 1.1;
}

.section-heading p {
    margin-top: 20px;
    color: #6B7280;
    font-size: 18px;
    line-height: 1.7;
}


/* INTRO */

.intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.intro-text p {
    margin-top: 0;
    margin-bottom: 22px;
    color: #4B5563;
    font-size: 18px;
    line-height: 1.8;
}

.battery-diagram {
    padding: 38px;
    border: 1px solid #E5E7EB;
    border-radius: 28px;
    background: #F8F9FA;
}

.diagram-title {
    margin-bottom: 35px;
    color: #6B7280;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
}

.energy-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
}

.energy-item {
    flex: 1;
    text-align: center;
}

.energy-item.active {
    padding: 18px 8px;
    border: 1px solid rgba(255,104,0,.25);
    border-radius: 20px;
    background: #ffffff;
}

.energy-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border-radius: 18px;
    background: #FFF3EA;
    font-size: 30px;
}

.energy-item strong {
    display: block;
    color: #111827;
}

.energy-item small {
    display: block;
    margin-top: 5px;
    color: #6B7280;
    line-height: 1.4;
}

.energy-arrow {
    color: #FF6800;
    font-size: 28px;
    font-weight: 700;
}

.grid-note {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 30px;
    padding-top: 25px;
    border-top: 1px solid #E5E7EB;
}

.grid-note span {
    color: #FF6800;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
}

.grid-note p {
    margin: 0;
    color: #6B7280;
    line-height: 1.5;
}


/* BENEFITS */

.benefits-section {
    padding: 110px 0;
    background: #F4F5F7;
}

.benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
}

.benefit-card {
    padding: 34px;
    border: 1px solid #E5E7EB;
    border-radius: 24px;
    background: white;
    box-shadow: 0 5px 16px rgba(0,0,0,.04);
    transition: all .3s ease;
}

.benefit-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 45px rgba(0,0,0,.09);
}

.benefit-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    margin-bottom: 25px;
    border-radius: 17px;
    background: #FFF3EA;
    font-size: 28px;
}

.benefit-card h3 {
    margin: 0 0 12px;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: 24px;
}

.benefit-card p {
    color: #6B7280;
    line-height: 1.7;
}


/* CAPACITY */

.capacity-section {
    background: #ffffff;
}

.capacity-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
}

.capacity-card {
    position: relative;
    padding: 40px;
    border: 1px solid #E5E7EB;
    border-radius: 26px;
    background: white;
}

.capacity-card.highlighted {
    border: 2px solid #FF6800;
    box-shadow: 0 18px 50px rgba(255,104,0,.1);
}

.capacity-number {
    position: absolute;
    top: 30px;
    right: 30px;
    color: #D1D5DB;
    font-size: 12px;
    font-weight: 800;
}

.capacity-card h3 {
    margin: 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: 25px;
}

.capacity-value {
    margin: 25px 0 18px;
    color: #FF6800;
    font-family: Poppins, sans-serif;
    font-size: 34px;
    font-weight: 800;
}

.capacity-card p {
    color: #6B7280;
    line-height: 1.7;
}

.capacity-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    margin-top: 35px;
    padding: 26px 30px;
    border-left: 4px solid #FF6800;
    background: #FFF8F3;
}

.capacity-note strong {
    color: #FF6800;
}

.capacity-note p {
    margin: 0;
    color: #4B5563;
    line-height: 1.7;
}


/* BACKUP */

.backup-section {
    padding: 110px 0;
    background: #111827;
}

.backup-section .section-heading h2 {
    color: white;
