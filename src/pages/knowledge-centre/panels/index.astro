---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
---

<BaseLayout
    title="Solar Panels | How Solar Panels Work | Solar8"
    description="Learn how solar panels work, what affects solar panel production, panel capacity, efficiency, orientation, shading and how to choose the right solar panels for your system."
>

<Navigation />

<main>

    <!-- HERO -->

    <section class="panels-hero">

        <div class="solar-container">

            <div class="hero-content">

                <span class="eyebrow">
                    SOLAR8 KNOWLEDGE CENTRE
                </span>

                <h1>
                    Solar Panels
                    <span>Made Simple.</span>
                </h1>

                <p>
                    Solar panels are the part of your system that captures
                    energy from the sun. Learn how they work, how much
                    electricity they can produce and what affects their
                    performance.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Get My FREE Assessment
                    </a>

                    <a href="/systems/" class="secondary-button">
                        Explore Solar Systems
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- INTRODUCTION -->

    <section class="intro-section">

        <div class="solar-container">

            <div class="section-heading">

                <span class="eyebrow">
                    THE BASICS
                </span>

                <h2>
                    What does a solar panel actually do?
                </h2>

                <p>
                    Solar panels convert sunlight into electrical energy.
                    That electricity can then be used by your property,
                    stored in batteries or, depending on the system,
                    exported to the grid.
                </p>

            </div>


            <div class="intro-grid">

                <div class="intro-text">

                    <p>
                        Solar panels are made up of photovoltaic cells.
                        When sunlight reaches these cells, it creates
                        electrical energy in the form of direct current,
                        or DC electricity.
                    </p>

                    <p>
                        The panels themselves do not normally produce the
                        type of AC electricity used directly by household
                        appliances. The inverter manages the conversion
                        from DC to usable AC electricity.
                    </p>

                    <p>
                        The amount of electricity produced changes throughout
                        the day and depends on sunlight conditions, panel
                        capacity, temperature, orientation, shading and other
                        factors.
                    </p>

                </div>


                <div class="panel-diagram">

                    <div class="diagram-title">
                        FROM SUNLIGHT TO ELECTRICITY
                    </div>

                    <div class="panel-flow">

                        <div class="diagram-item">

                            <div class="diagram-icon">
                                ☀
                            </div>

                            <strong>
                                Sunlight
                            </strong>

                            <small>
                                Solar energy reaches the panel
                            </small>

                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-item">

                            <div class="solar-panel-graphic">

                                <div></div>
                                <div></div>
                                <div></div>
                                <div></div>
                                <div></div>
                                <div></div>

                            </div>

                            <strong>
                                Solar Panel
                            </strong>

                            <small>
                                Converts sunlight into DC electricity
                            </small>

                        </div>

                        <div class="diagram-arrow">
                            →
                        </div>

                        <div class="diagram-item">

                            <div class="diagram-icon">
                                ⚡
                            </div>

                            <strong>
                                Inverter
                            </strong>

                            <small>
                                Converts and manages electricity
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- PANEL CAPACITY -->

    <section class="capacity-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    UNDERSTANDING PANEL SIZE
                </span>

                <h2>
                    What does a 450W or 550W panel mean?
                </h2>

                <p>
                    The wattage printed on a panel describes its rated
                    power under defined test conditions.
                </p>

            </div>


            <div class="capacity-grid">

                <article class="capacity-card">

                    <span class="capacity-number">
                        450W
                    </span>

                    <h3>
                        450 watt panel
                    </h3>

                    <p>
                        A panel with a nominal rating of 450 watts can
                        produce up to approximately 450 watts of power
                        under suitable test conditions.
                    </p>

                </article>


                <article class="capacity-card featured">

                    <span class="capacity-number">
                        550W
                    </span>

                    <h3>
                        550 watt panel
                    </h3>

                    <p>
                        A 550 watt panel has a higher rated output than
                        a 450 watt panel, which can allow more panel
                        capacity to be installed within a similar roof area.
                    </p>

                </article>


                <article class="capacity-card">

                    <span class="capacity-number">
                        kWp
                    </span>

                    <h3>
                        Total panel capacity
                    </h3>

                    <p>
                        The combined rated capacity of your panels is often
                        expressed in kilowatt-peak, or kWp. For example,
                        ten 550W panels provide a total nominal capacity
                        of 5.5 kWp.
                    </p>

                </article>

            </div>

        </div>

    </section>


    <!-- PRODUCTION -->

    <section class="production-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    SOLAR PRODUCTION
                </span>

                <h2>
                    A panel does not produce its rated power all day
                </h2>

                <p>
                    Panel wattage is a useful specification, but real-world
                    energy production changes throughout the day.
                </p>

            </div>


            <div class="production-grid">

                <div class="production-card morning">

                    <div class="production-time">
                        MORNING
                    </div>

                    <div class="production-icon">
                        🌅
                    </div>

                    <h3>
                        Production increases
                    </h3>

                    <p>
                        As the sun rises, available solar energy increases
                        and panel output generally rises.
                    </p>

                </div>


                <div class="production-card midday">

                    <div class="production-time">
                        MIDDAY
                    </div>

                    <div class="production-icon">
                        ☀
                    </div>

                    <h3>
                        Strongest production
                    </h3>

                    <p>
                        Around the strongest sunlight period, panels can
                        approach their highest production for the day,
                        subject to system conditions.
                    </p>

                </div>


                <div class="production-card afternoon">

                    <div class="production-time">
                        AFTERNOON
                    </div>

                    <div class="production-icon">
                        🌇
                    </div>

                    <h3>
                        Production decreases
                    </h3>

                    <p>
                        As the sun moves lower in the sky, available solar
                        energy decreases and panel production falls.
                    </p>

                </div>


                <div class="production-card night">

                    <div class="production-time">
                        NIGHT
                    </div>

                    <div class="production-icon">
                        🌙
                    </div>

                    <h3>
                        No solar production
                    </h3>

                    <p>
                        Without sunlight, solar panels do not provide
                        meaningful electricity production. Your system may
                        use batteries or the grid instead.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- FACTORS -->

    <section class="factors-section">

        <div class="solar-container">

            <div class="section-heading">

                <span class="eyebrow">
                    WHAT AFFECTS PRODUCTION?
                </span>

                <h2>
                    Six factors that influence solar panel performance
                </h2>

                <p>
                    Two systems with the same panel capacity can produce
                    different amounts of energy depending on their
                    installation and operating conditions.
                </p>

            </div>


            <div class="factors-grid">

                <article class="factor-card">

                    <div class="factor-number">
                        01
                    </div>

                    <h3>
                        Sunlight
                    </h3>

                    <p>
                        Solar panels require sunlight to generate electricity.
                        Cloud cover, weather and seasonal conditions can
                        affect production.
                    </p>

                </article>


                <article class="factor-card">

                    <div class="factor-number">
                        02
                    </div>

                    <h3>
                        Orientation
                    </h3>

                    <p>
                        The direction a panel faces affects how much sunlight
                        reaches it throughout the day.
                    </p>

                </article>


                <article class="factor-card">

                    <div class="factor-number">
                        03
                    </div>

                    <h3>
                        Tilt
                    </h3>

                    <p>
                        The angle of the panels influences how effectively
                        they receive sunlight at different times of the year.
                    </p>

                </article>


                <article class="factor-card">

                    <div class="factor-number">
                        04
                    </div>

                    <h3>
                        Shading
                    </h3>

                    <p>
                        Trees, buildings, chimneys and other obstructions can
                        reduce panel production and need to be considered
                        during system design.
                    </p>

                </article>


                <article class="factor-card">

                    <div class="factor-number">
                        05
                    </div>

                    <h3>
                        Temperature
                    </h3>

                    <p>
                        Solar panel electrical characteristics change with
                        temperature. Panel specifications therefore include
                        defined test conditions.
                    </p>

                </article>


                <article class="factor-card">

                    <div class="factor-number">
                        06
                    </div>

                    <h3>
                        System Design
                    </h3>

                    <p>
                        Panel configuration, inverter selection, wiring and
                        other system components all influence how effectively
                        available solar energy is converted into usable power.
                    </p>

                </article>

            </div>

        </div>

    </section>


    <!-- TYPES -->

    <section class="types-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    PANEL TECHNOLOGY
                </span>

                <h2>
                    What types of solar panels are available?
                </h2>

                <p>
                    Modern solar panels use different cell technologies and
                    construction methods. The best choice depends on the
                    property, available roof space and system requirements.
                </p>

            </div>


            <div class="types-grid">

                <article class="type-card">

                    <div class="type-label">
                        MONOCRYSTALLINE
                    </div>

                    <h3>
                        Monocrystalline panels
                    </h3>

                    <p>
                        Monocrystalline panels are widely used in modern
                        residential and commercial installations. They are
                        typically well suited to applications where available
                        roof space is important.
                    </p>

                    <ul>
                        <li>Widely available</li>
                        <li>High power options available</li>
                        <li>Suitable for residential installations</li>
                    </ul>

                </article>


                <article class="type-card highlighted">

                    <div class="type-label">
                        HIGH-EFFICIENCY
                    </div>

                    <h3>
                        High-efficiency panels
                    </h3>

                    <p>
                        Higher-efficiency panels can produce more power from
                        a similar physical area, which can be valuable when
                        roof space is limited.
                    </p>

                    <ul>
                        <li>More output per square metre</li>
                        <li>Useful where roof space is restricted</li>
                        <li>Available in high-wattage formats</li>
                    </ul>

                </article>


                <article class="type-card">

                    <div class="type-label">
                        BIFACIAL
                    </div>

                    <h3>
                        Bifacial panels
                    </h3>

                    <p>
                        Bifacial panels can generate electricity from light
                        reaching both sides of the panel. Their performance
                        depends strongly on the installation environment.
                    </p>

                    <ul>
                        <li>Can capture reflected light</li>
                        <li>Useful in suitable installations</li>
                        <li>Installation design is important</li>
                    </ul>

                </article>

            </div>

        </div>

    </section>


    <!-- HOW MANY PANELS -->

    <section class="sizing-section">

        <div class="solar-container">

            <div class="sizing-grid">

                <div class="sizing-content">

                    <span class="eyebrow">
                        HOW MANY PANELS DO I NEED?
                    </span>

                    <h2>
                        Panel quantity is only one part of system sizing.
                    </h2>

                    <p>
                        The number of panels required depends on several
                        factors, including your electricity consumption,
                        available roof space, desired solar production,
                        inverter capacity and battery requirements.
                    </p>

                    <p>
                        For example, a system using 10 × 550W panels would
                        have a nominal panel capacity of 5.5 kWp. That does
                        not mean it will produce 5.5 kW continuously throughout
                        the day.
                    </p>

                    <p>
                        A proper assessment considers your actual electricity
                        usage and the characteristics of the property before
                        recommending a panel configuration.
                    </p>

                    <a href="/assessment/" class="text-button">
                        Start a FREE Solar Assessment →
                    </a>

                </div>


                <div class="sizing-box">

                    <div class="sizing-box-title">
                        EXAMPLE
                    </div>

                    <div class="panel-example">

                        <div class="example-number">
                            10
                        </div>

                        <div class="example-text">
                            <strong>
                                × 550W panels
                            </strong>

                            <span>
                                5.5 kWp nominal panel capacity
                            </span>
                        </div>

                    </div>


                    <div class="example-note">
                        Actual energy production varies according to
                        sunlight, weather, orientation, shading, temperature,
                        system losses and other conditions.
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- FAQ -->

    <section class="faq-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    COMMON QUESTIONS
                </span>

                <h2>
                    Solar panel questions
                </h2>

            </div>


            <div class="faq-list">

                <details>
                    <summary>
                        Do solar panels work on cloudy days?
                    </summary>

                    <p>
                        Yes. Solar panels can still generate electricity when
                        it is cloudy, although production is generally lower
                        than during strong direct sunlight.
                    </p>

                </details>


                <details>
                    <summary>
                        Do solar panels work at night?
                    </summary>

                    <p>
                        Solar panels require sunlight to generate electricity,
                        so they do not provide meaningful solar production
                        at night. A battery or the grid can provide electricity
                        when solar production is unavailable.
                    </p>

                </details>


                <details>
                    <summary>
                        Is a higher wattage panel always better?
                    </summary>

                    <p>
                        Not necessarily. Higher-wattage panels can provide
                        more rated capacity per panel, but the correct choice
                        also depends on physical dimensions, roof space,
                        inverter compatibility, electrical design and overall
                        system requirements.
                    </p>

                </details>


                <details>
                    <summary>
                        Does shading affect solar panels?
                    </summary>

                    <p>
                        Yes. Shading can significantly reduce solar production.
                        The location, timing and extent of shading should be
                        considered when designing a system.
                    </p>

                </details>


                <details>
                    <summary>
                        How long do solar panels last?
                    </summary>

                    <p>
                        Modern quality solar panels are designed for long-term
                        operation, with manufacturers typically providing
                        long product and performance warranties. Exact warranty
                        periods vary by manufacturer and model.
                    </p>

                </details>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="panels-cta">

        <div class="solar-container">

            <div class="cta-content">

                <span class="eyebrow">
                    READY TO SIZE YOUR SYSTEM?
                </span>

                <h2>
                    Let's work out how much solar your property actually needs.
                </h2>

                <p>
                    Your ideal panel configuration depends on your electricity
                    usage, roof space, backup requirements and overall energy
                    goals.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Start My FREE Assessment
                    </a>

                    <a href="/knowledge-centre" class="secondary-button">
                        Back to Knowledge Centre
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<Footer />

<style>

.solar-container {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
}

.panels-hero {
    padding: 180px 0 120px;
    background:
        radial-gradient(
            circle at 82% 18%,
            rgba(255,104,0,.14),
            transparent 35%
        ),
        linear-gradient(
            180deg,
            #ffffff 0%,
            #FAFAFA 100%
        );
}

.hero-content {
    max-width: 820px;
}

.eyebrow {
    display: inline-block;
    color: #FF6800;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .14em;
}

.panels-hero h1 {
    margin: 20px 0 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(3.2rem, 6vw, 5.8rem);
    line-height: 1.02;
    letter-spacing: -.045em;
}

.panels-hero h1 span {
    display: block;
    color: #FF6800;
}

.panels-hero p {
    max-width: 720px;
    margin-top: 30px;
    color: #6B7280;
    font-family: Inter, sans-serif;
    font-size: 20px;
    line-height: 1.7;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
}

.primary-button,
.secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all .3s ease;
}

.primary-button {
    background: #FF6800;
    color: white;
}

.primary-button:hover {
    background: #E65E00;
    transform: translateY(-2px);
}

.secondary-button {
    border: 1px solid #D1D5DB;
    color: #374151;
    background: white;
}

.secondary-button:hover {
    border-color: #FF6800;
    color: #FF6800;
}

.intro-section,
.capacity-section,
.factors-section,
.sizing-section,
.faq-section {
    padding: 110px 0;
    background: #ffffff;
}

.section-heading {
    max-width: 760px;
    margin-bottom: 60px;
}

.section-heading.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.section-heading h2 {
    margin: 16px 0 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(2.3rem, 4vw, 3.3rem);
    line-height: 1.1;
}

.section-heading p {
    margin-top: 20px;
    color: #6B7280;
    font-size: 18px;
    line-height: 1.7;
}

.intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.intro-text p {
    margin: 0 0 22px;
    color: #4B5563;
    font-size: 18px;
    line-height: 1.8;
}

.panel-diagram {
    padding: 38px;
    border: 1px solid #E5E7EB;
    border-radius: 28px;
    background: #F8F9FA;
}

.diagram-title {
    margin-bottom: 35px;
    color: #6B7280;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
}

.panel-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
}

.diagram-item {
    flex: 1;
    text-align: center;
}

.diagram-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border-radius: 18px;
    background: #FFF3EA;
    font-size: 30px;
}

.diagram-item strong {
    display: block;
    color: #111827;
}

.diagram-item small {
    display: block;
    margin-top: 5px;
    color: #6B7280;
    line-height: 1.4;
}

.diagram-arrow {
    color: #FF6800;
    font-size: 28px;
    font-weight: 700;
}

.solar-panel-graphic {
    display: grid;
    grid-template-columns: repeat(3, 18px);
    grid-template-rows: repeat(2, 22px);
    gap: 3px;
    align-content: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border-radius: 18px;
    background: #172554;
    transform: rotate(-8deg);
    box-shadow: 0 8px 18px rgba(17,24,39,.15);
}

.solar-panel-graphic div {
    border: 1px solid rgba(255,255,255,.35);
    background: #1E40AF;
}

.capacity-section {
    background: #F4F5F7;
}

.capacity-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.capacity-card {
    padding: 38px;
    border: 1px solid #E5E7EB;
    border-radius: 24px;
    background: white;
}

.capacity-card.featured {
    border: 2px solid #FF6800;
    box-shadow: 0 18px 45px rgba(255,104,0,.1);
}

.capacity-number {
    color: #FF6800;
    font-family: Poppins, sans-serif;
    font-size: 38px;
    font-weight: 800;
}

.capacity-card h3 {
    margin: 18px 0 12px;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: 25px;
}

.capacity-card p {
    color: #6B7280;
    line-height: 1.7;
}

.production-section {
    padding: 110px 0;
    background: #111827;
}

.production-section .section-heading h2 {
    color: white;
}

.production-section .section-heading p {
    color: #D1D5DB;
}

.production-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
}

.production-card {
    padding: 34px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 24px;
    background: rgba(255,255,255,.05);
}

.production-card.midday {
    border-color: rgba(255,104,0,.4);
    background: linear-gradient(
        145deg,
        rgba(255,104,0,.22),
        rgba(255,255,255,.05)
    );
}

.production-time {
    color: #FF9B58;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
}

.production-icon {
    margin: 28px 0;
    font-size: 42px;
}

.production-card h3 {
    color: white;
    font-family: Poppins, sans-serif;
    font-size: 23px;
}

.production-card p {
    margin-top: 14px;
    color: #D1D5DB;
    line-height: 1.7;
}

.factors-section {
    background: #FAFAFA;
}

.factors-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.factor-card {
    position: relative;
    padding: 34px;
    border: 1px solid #E5E7EB;
    border-radius: 24px;
    background: white;
    box-shadow: 0 5px 16px rgba(0,0,0,.04);
    transition: all .3s ease;
}

.factor-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(0,0,0,.08);
}

.factor-number {
    color: #D1D5DB;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .1em;
}

.factor-card h3 {
    margin: 18px 0 12px;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: 24px;
}

.factor-card p {
    color: #6B7280;
    line-height: 1.7;
}

.types-section {
    padding: 110px 0;
    background: #ffffff;
}

.types-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
}

.type-card {
    padding: 40px;
    border: 1px solid #E5E7EB;
    border-radius: 26px;
    background: #ffffff;
}

.type-card.highlighted {
    border: 2px solid #FF6800;
    box-shadow: 0 18px 50px rgba(255,104,0,.1);
}

.type-label {
    color: #FF6800;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
}

.type-card h3 {
    margin: 18px 0 14px;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: 27px;
