---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
---

<BaseLayout
    title="Solar Basics | How Solar Power Works | Solar8"
    description="Learn the basics of solar power, including solar panels, inverters, batteries, electricity usage and how a residential solar system works."
>

<Navigation />

<main>

    <!-- HERO -->

    <section class="solar-basics-hero">

        <div class="solar-container">

            <div class="hero-content">

                <span class="eyebrow">
                    SOLAR8 KNOWLEDGE CENTRE
                </span>

                <h1>
                    Solar Power
                    <span>Made Simple.</span>
                </h1>

                <p>
                    New to solar? Start here. Learn how solar panels,
                    inverters and batteries work together to provide
                    electricity for your home or business.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Get My FREE Assessment
                    </a>

                    <a href="/systems/" class="secondary-button">
                        Explore Solar Systems
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- INTRODUCTION -->

    <section class="intro-section">

        <div class="solar-container">

            <div class="section-heading">

                <span class="eyebrow">
                    THE BASICS
                </span>

                <h2>
                    What is a solar energy system?
                </h2>

                <p>
                    A solar energy system converts sunlight into electricity
                    that can be used to power your home or business.
                </p>

            </div>


            <div class="intro-grid">

                <div class="intro-text">

                    <p>
                        Solar panels capture energy from the sun and produce
                        electrical power. An inverter then converts and manages
                        that electricity so it can be used by your appliances.
                    </p>

                    <p>
                        Depending on the system you choose, excess electricity
                        can be stored in batteries for use later, exported to
                        the electrical grid, or simply used immediately by your
                        property.
                    </p>

                    <p>
                        A correctly designed system therefore combines several
                        components rather than simply installing solar panels.
                    </p>

                </div>


                <div class="simple-diagram">

                    <div class="diagram-title">
                        A SIMPLE SOLAR SYSTEM
                    </div>

                    <div class="diagram-flow">

                        <div class="diagram-item">
                            <div class="diagram-icon">☀</div>
                            <strong>Solar Panels</strong>
                            <small>Generate electricity</small>
                        </div>

                        <div class="diagram-arrow">→</div>

                        <div class="diagram-item">
                            <div class="diagram-icon">⚡</div>
                            <strong>Inverter</strong>
                            <small>Manages electricity</small>
                        </div>

                        <div class="diagram-arrow">→</div>

                        <div class="diagram-item">
                            <div class="diagram-icon">⌂</div>
                            <strong>Your Home</strong>
                            <small>Uses electricity</small>
                        </div>

                    </div>

                    <div class="diagram-battery">

                        <div class="diagram-arrow-down">↓</div>

                        <div class="battery-box">

                            <div class="diagram-icon">🔋</div>

                            <strong>Battery</strong>

                            <small>
                                Stores energy for later
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- COMPONENTS -->

    <section class="components-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    THE MAIN COMPONENTS
                </span>

                <h2>
                    Four parts you need to understand
                </h2>

                <p>
                    These components work together to create a complete
                    solar energy system.
                </p>

            </div>


            <div class="components-grid">

                <article class="component-card">

                    <div class="component-icon">☀</div>

                    <span class="component-number">
                        01
                    </span>

                    <h3>
                        Solar Panels
                    </h3>

                    <p>
                        Solar panels convert sunlight into DC electricity.
                        The amount of electricity they produce depends on
                        factors such as panel capacity, sunlight, orientation,
                        temperature and shading.
                    </p>

                    <a href="/knowledge-centre/panels">
                        Learn about solar panels →
                    </a>

                </article>


                <article class="component-card">

                    <div class="component-icon">⚡</div>

                    <span class="component-number">
                        02
                    </span>

                    <h3>
                        Inverter
                    </h3>

                    <p>
                        The inverter converts and manages electricity so that
                        it can safely power your appliances. Hybrid inverters
                        can also manage batteries and the electrical grid.
                    </p>

                    <a href="/knowledge-centre/inverters">
                        Learn about inverters →
                    </a>

                </article>


                <article class="component-card">

                    <div class="component-icon">🔋</div>

                    <span class="component-number">
                        03
                    </span>

                    <h3>
                        Battery
                    </h3>

                    <p>
                        Batteries store electrical energy so it can be used
                        when solar production is low or when the grid is
                        unavailable.
                    </p>

                    <a href="/knowledge-centre/batteries">
                        Learn about batteries →
                    </a>

                </article>


                <article class="component-card">

                    <div class="component-icon">⌂</div>

                    <span class="component-number">
                        04
                    </span>

                    <h3>
                        Your Electrical System
                    </h3>

                    <p>
                        Your home's electrical distribution system determines
                        which appliances can be powered and how electricity
                        flows between the grid, solar system, battery and
                        appliances.
                    </p>

                    <a href="/knowledge-centre/system-sizing">
                        Learn about system sizing →
                    </a>

                </article>

            </div>

        </div>

    </section>


    <!-- HOW IT WORKS -->

    <section class="how-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    HOW IT WORKS
                </span>

                <h2>
                    What happens during a normal day?
                </h2>

                <p>
                    A solar system can behave differently depending on
                    sunlight, electricity demand and battery charge.
                </p>

            </div>


            <div class="day-grid">

                <div class="day-card">

                    <div class="day-time">
                        MORNING
                    </div>

                    <div class="day-icon">🌅</div>

                    <h3>
                        Solar production starts
                    </h3>

                    <p>
                        As sunlight increases, your solar panels begin
                        generating electricity.
                    </p>

                </div>


                <div class="day-card featured">

                    <div class="day-time">
                        DAYTIME
                    </div>

                    <div class="day-icon">☀</div>

                    <h3>
                        Solar powers your property
                    </h3>

                    <p>
                        Your solar electricity can power appliances directly.
                        Excess energy can charge your battery.
                    </p>

                </div>


                <div class="day-card">

                    <div class="day-time">
                        EVENING
                    </div>

                    <div class="day-icon">🌇</div>

                    <h3>
                        Battery takes over
                    </h3>

                    <p>
                        When solar production falls, stored battery energy
                        can supply your home.
                    </p>

                </div>


                <div class="day-card">

                    <div class="day-time">
                        NIGHT
                    </div>

                    <div class="day-icon">🌙</div>

                    <h3>
                        Stored energy continues
                    </h3>

                    <p>
                        Depending on battery capacity and your electricity
                        usage, stored energy can continue powering selected
                        appliances overnight.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- GRID VS HYBRID -->

    <section class="comparison-section">

        <div class="solar-container">

            <div class="section-heading centered">

                <span class="eyebrow">
                    UNDERSTANDING SYSTEM TYPES
                </span>

                <h2>
                    Not all solar systems work the same way
                </h2>

                <p>
                    The right system depends on whether your priority is
                    electricity savings, backup power or greater energy
                    independence.
                </p>

            </div>


            <div class="comparison-grid">

                <div class="comparison-card">

                    <span class="comparison-label">
                        GRID-TIED
                    </span>

                    <h3>
                        Solar + Grid
                    </h3>

                    <p>
                        A grid-tied system primarily uses solar electricity
                        to reduce the amount of electricity purchased from
                        the grid.
                    </p>

                    <ul>
                        <li>Lower daytime grid consumption</li>
                        <li>Generally simpler system design</li>
                        <li>Usually no battery required</li>
                    </ul>

                </div>


                <div class="comparison-card highlighted">

                    <span class="comparison-label">
                        HYBRID
                    </span>

                    <h3>
                        Solar + Battery + Grid
                    </h3>

                    <p>
                        A hybrid system can combine solar generation,
                        battery storage and grid electricity.
                    </p>

                    <ul>
                        <li>Solar savings</li>
                        <li>Battery backup</li>
                        <li>Flexible energy management</li>
                    </ul>

                </div>


                <div class="comparison-card">

                    <span class="comparison-label">
                        BACKUP
                    </span>

                    <h3>
                        Battery Backup
                    </h3>

                    <p>
                        A battery-focused system can provide backup power
                        during grid interruptions, with or without solar
                        panels depending on the configuration.
                    </p>

                    <ul>
                        <li>Backup during outages</li>
                        <li>Essential-load support</li>
                        <li>Can be expanded later</li>
                    </ul>

                </div>

            </div>

        </div>

    </section>


    <!-- IMPORTANT TERMS -->

    <section class="terms-section">

        <div class="solar-container">

            <div class="section-heading">

                <span class="eyebrow">
                    SOLAR TERMINOLOGY
                </span>

                <h2>
                    Terms you'll hear when comparing systems
                </h2>

            </div>


            <div class="terms-grid">

                <div class="term">
                    <strong>kW</strong>
                    <p>
                        A measure of power. It helps describe how much
                        electrical load an inverter can supply.
                    </p>
                </div>

                <div class="term">
                    <strong>kWh</strong>
                    <p>
                        A measure of energy. Battery capacity is commonly
                        expressed in kWh.
                    </p>
                </div>

                <div class="term">
                    <strong>DC</strong>
                    <p>
                        Direct current. Solar panels produce DC electricity.
                    </p>
                </div>

                <div class="term">
                    <strong>AC</strong>
                    <p>
                        Alternating current. Household appliances normally
                        use AC electricity.
                    </p>
                </div>

                <div class="term">
                    <strong>Load</strong>
                    <p>
                        The electrical demand created by appliances and
                        equipment.
                    </p>
                </div>

                <div class="term">
                    <strong>Depth of Discharge</strong>
                    <p>
                        The amount of a battery's available capacity that
                        has been used.
                    </p>
                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->

    <section class="solar-cta">

        <div class="solar-container">

            <div class="cta-content">

                <span class="eyebrow">
                    READY TO LEARN MORE?
                </span>

                <h2>
                    Let's work out what your property actually needs.
                </h2>

                <p>
                    Every property uses electricity differently. Solar8 can
                    help you understand your requirements before you invest
                    in a system.
                </p>

                <div class="hero-actions">

                    <a href="/assessment/" class="primary-button">
                        Start My FREE Assessment
                    </a>

                    <a href="/knowledge-centre" class="secondary-button">
                        Back to Knowledge Centre
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<Footer />

<style>

.solar-container {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
}

.solar-basics-hero {
    padding: 180px 0 120px;
    background:
        radial-gradient(
            circle at 82% 18%,
            rgba(255,104,0,.14),
            transparent 35%
        ),
        linear-gradient(
            180deg,
            #ffffff 0%,
            #FAFAFA 100%
        );
}

.hero-content {
    max-width: 820px;
}

.eyebrow {
    display: inline-block;
    color: #FF6800;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .14em;
}

.solar-basics-hero h1 {
    margin: 20px 0 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(3.2rem, 6vw, 5.8rem);
    line-height: 1.02;
    letter-spacing: -.045em;
}

.solar-basics-hero h1 span {
    display: block;
    color: #FF6800;
}

.solar-basics-hero p {
    max-width: 720px;
    margin-top: 30px;
    color: #6B7280;
    font-family: Inter, sans-serif;
    font-size: 20px;
    line-height: 1.7;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
}

.primary-button,
.secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all .3s ease;
}

.primary-button {
    background: #FF6800;
    color: white;
}

.primary-button:hover {
    background: #E65E00;
    transform: translateY(-2px);
}

.secondary-button {
    border: 1px solid #D1D5DB;
    color: #374151;
    background: white;
}

.secondary-button:hover {
    border-color: #FF6800;
    color: #FF6800;
}

.intro-section,
.components-section,
.comparison-section,
.terms-section {
    padding: 110px 0;
    background: #ffffff;
}

.section-heading {
    max-width: 760px;
    margin-bottom: 60px;
}

.section-heading.centered {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.section-heading h2 {
    margin: 16px 0 0;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: clamp(2.3rem, 4vw, 3.3rem);
    line-height: 1.1;
}

.section-heading p {
    margin-top: 20px;
    color: #6B7280;
    font-size: 18px;
    line-height: 1.7;
}

.intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: center;
}

.intro-text p {
    margin-top: 0;
    margin-bottom: 22px;
    color: #4B5563;
    font-size: 18px;
    line-height: 1.8;
}

.simple-diagram {
    padding: 38px;
    border: 1px solid #E5E7EB;
    border-radius: 28px;
    background: #F8F9FA;
}

.diagram-title {
    margin-bottom: 35px;
    color: #6B7280;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
}

.diagram-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
}

.diagram-item {
    flex: 1;
    text-align: center;
}

.diagram-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border-radius: 18px;
    background: #FFF3EA;
    font-size: 30px;
}

.diagram-item strong,
.battery-box strong {
    display: block;
    color: #111827;
}

.diagram-item small,
.battery-box small {
    display: block;
    margin-top: 5px;
    color: #6B7280;
    line-height: 1.4;
}

.diagram-arrow {
    color: #FF6800;
    font-size: 28px;
    font-weight: 700;
}

.diagram-battery {
    margin-top: 25px;
    text-align: center;
}

.diagram-arrow-down {
    color: #FF6800;
    font-size: 26px;
}

.battery-box {
    width: min(220px, 100%);
    margin: 0 auto;
    padding: 20px;
    border: 1px solid rgba(255,104,0,.25);
    border-radius: 18px;
    background: #ffffff;
}

.components-section {
    background: #F4F5F7;
}

.components-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
}

.component-card {
    position: relative;
    padding: 34px;
    border: 1px solid #E5E7EB;
    border-radius: 24px;
    background: white;
    box-shadow: 0 5px 16px rgba(0,0,0,.04);
    transition: all .3s ease;
}

.component-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 45px rgba(0,0,0,.09);
}

.component-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 17px;
    background: #FFF3EA;
    font-size: 28px;
}

.component-number {
    position: absolute;
    top: 35px;
    right: 30px;
    color: #D1D5DB;
    font-size: 12px;
    font-weight: 800;
}

.component-card h3 {
    margin: 25px 0 12px;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: 25px;
}

.component-card p {
    color: #6B7280;
    line-height: 1.7;
}

.component-card a {
    display: inline-block;
    margin-top: 24px;
    color: #FF6800;
    font-weight: 700;
    text-decoration: none;
}

.how-section {
    padding: 110px 0;
    background: #111827;
}

.how-section .section-heading h2 {
    color: white;
}

.how-section .section-heading p {
    color: #D1D5DB;
}

.day-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
}

.day-card {
    padding: 34px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 24px;
    background: rgba(255,255,255,.05);
}

.day-card.featured {
    background: linear-gradient(
        145deg,
        rgba(255,104,0,.22),
        rgba(255,255,255,.06)
    );
    border-color: rgba(255,104,0,.35);
}

.day-time {
    color: #FF9B58;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
}

.day-icon {
    margin: 28px 0;
    font-size: 42px;
}

.day-card h3 {
    color: white;
    font-family: Poppins, sans-serif;
    font-size: 23px;
}

.day-card p {
    margin-top: 14px;
    color: #D1D5DB;
    line-height: 1.7;
}

.comparison-section {
    background: #FAFAFA;
}

.comparison-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
}

.comparison-card {
    padding: 40px;
    border: 1px solid #E5E7EB;
    border-radius: 26px;
    background: white;
}

.comparison-card.highlighted {
    border: 2px solid #FF6800;
    box-shadow: 0 18px 50px rgba(255,104,0,.1);
}

.comparison-label {
    color: #FF6800;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
}

.comparison-card h3 {
    margin: 18px 0 14px;
    color: #111827;
    font-family: Poppins, sans-serif;
    font-size: 28px;
}

.comparison-card p {
    color: #6B7280;
    line-height: 1.7;
}

.comparison-card ul {
    margin: 25px 0 0;
    padding-left: 20px;
    color: #4B5563;
    line-height: 2;
}

.terms-section {
    background: white;
}

.terms-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid #E5E7EB;
    border-radius: 24px;
    background: #E5E7EB;
}

.term {
    padding: 34px;
    background: white;
}

.term strong {
    color: #FF6800;
    font-family: Poppins, sans-serif;
    font-size: 22px;
}

.term p {
    margin-top: 10px;
    color: #6B7280;
    line-height: 1.65;
}

.solar-cta {
    padding: 110px 0;
    background:
        radial-gradient(
            circle at 85% 30%,
            rgba(255,104,0,.22),
            transparent 35%
        ),
        #111827;
}

.cta-content {
    max-width: 820px;
}

.cta-content h2 {
    margin-top: 18px;
    color: white;
    font-family: Poppins, sans-serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.08;
}

.cta-content p {
    margin-top: 22px;
    color: #D1D5DB;
    font-size: 19px;
    line-height: 1.7;
}

@media (max-width: 1100px) {

    .components-grid,
    .day-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 900px) {

    .intro-grid,
    .comparison-grid {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 768px) {

    .solar-container {
        width: min(100% - 32px, 1440px);
    }

    .solar-basics-hero {
        padding: 140px 0 80px;
    }

    .solar-basics-hero h1 {
        font-size: clamp(2.8rem, 12vw, 4rem);
    }

    .solar-basics-hero p {
        font-size: 17px;
    }

    .intro-section,
    .components-section,
    .how-section,
    .comparison-section,
    .terms-section,
    .solar-cta {
        padding: 80px 0;
    }

    .components-grid,
    .day-grid,
    .terms-grid {
        grid-template-columns: 1fr;
    }

    .diagram-flow {
        flex-direction: column;
    }

    .diagram-arrow {
        transform: rotate(90deg);
    }

    .hero-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .primary-button,
    .secondary-button {
        width: 100%;
    }

}

@media (max-width: 420px) {

    .solar-container {
        width: calc(100% - 24px);
    }

    .simple-diagram,
    .component-card,
    .comparison-card,
    .day-card {
        padding: 26px;
        border-radius: 20px;
    }

}

</style>

</BaseLayout>