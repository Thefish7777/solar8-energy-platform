---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/blog/BlogCard.astro";
import { blogCategories, blogPosts, getBlogCategory } from "../../../data/blog";

export function getStaticPaths() {
    return blogCategories.map((category) => ({
        params: { slug: category.slug },
        props: { slug: category.slug },
    }));
}

const { slug } = Astro.params;
const category = getBlogCategory(slug ?? "");
const posts = blogPosts.filter((post) => post.category === slug);

if (!category) {
    return Astro.redirect("/blog/");
}
---

<BaseLayout
    title={`${category.name} | Solar8 Blog`}
    description={`${category.description} Read Solar8's practical ${category.name.toLowerCase()} guides for South African homes and businesses.`}
    noIndex={posts.length === 0}
>
    <main>
        <section class="category-hero">
            <div class="solar-container">
                <div class="category-hero-content">
                    <a href="/blog/" class="category-back">← Solar8 Blog</a>
                    <span class="eyebrow">SOLAR8 BLOG</span>
                    <h1>{category.name}</h1>
                    <p>{category.description}</p>
                </div>
            </div>
        </section>

        <section class="category-content">
            <div class="solar-container">
                {posts.length > 0 ? (
                    <div class="blog-post-grid">
                        {posts.map((post) => <BlogCard post={post} />)}
                    </div>
                ) : (
                    <div class="category-empty">
                        <h2>Articles in this category are coming soon.</h2>
                        <p>We are preparing practical Solar8 guides on {category.name.toLowerCase()} for South African electricity users.</p>
                        <a href="/blog/" class="primary-button">Back to Solar8 Blog</a>
                    </div>
                )}
            </div>
        </section>
    </main>
</BaseLayout>

<style>
.category-hero{padding:92px 0 86px;background:radial-gradient(circle at 78% 28%,rgba(255,104,0,.14),transparent 30%),linear-gradient(180deg,#fff,#f7f9fc)}.category-hero-content{max-width:850px;margin:0 auto;text-align:center}.category-back{display:inline-block;margin-bottom:30px;color:#64748b;font-size:14px;font-weight:700;text-decoration:none}.category-back:hover{color:#ff6800}.category-hero h1{margin:14px 0 18px;font-family:Poppins,sans-serif;font-size:clamp(40px,5vw,64px);line-height:1.08;color:#0f172a;letter-spacing:-.03em}.category-hero p{max-width:720px;margin:0 auto;color:#64748b;font-size:18px;line-height:1.75}.category-content{min-height:480px;padding:108px 0 110px;background:#f8fafc}.blog-post-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}.category-empty{max-width:720px;margin:0 auto;padding:54px 44px;text-align:center;background:#fff;border:1px solid #e7eaf0;border-radius:26px;box-shadow:0 12px 30px rgba(15,23,42,.06)}.category-empty h2{margin:0 0 12px;font-family:Poppins,sans-serif;color:#0f172a;font-size:30px}.category-empty p{margin:0 auto 26px;color:#64748b;line-height:1.75}.category-empty .primary-button{display:inline-flex}@media(max-width:900px){.blog-post-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:640px){.category-hero{padding:72px 0}.category-content{padding:78px 0 80px}.blog-post-grid{grid-template-columns:1fr}.category-empty{padding:36px 24px}.category-empty h2{font-size:26px}}
</style>
