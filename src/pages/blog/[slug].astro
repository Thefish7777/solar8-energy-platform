---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { blogPosts, getBlogCategory } from "../../data/blog";

export function getStaticPaths() {
    return blogPosts.map((post) => ({
        params: { slug: post.slug },
        props: { slug: post.slug },
    }));
}

const { slug } = Astro.params;
const post = blogPosts.find((item) => item.slug === slug);

if (!post) {
    return Astro.redirect("/blog/");
}

const category = getBlogCategory(post.category);
---

<BlogLayout slug={post.slug}>
    <article class="blog-article">
        <div class="solar-container">
            <nav class="blog-breadcrumbs" aria-label="Breadcrumb">
                <a href="/">Home</a><span>→</span><a href="/blog/">Blog</a><span>→</span><span>{post.title}</span>
            </nav>

            <header class="blog-article-header">
                <span class="eyebrow">{category?.name ?? post.category}</span>
                <h1>{post.title}</h1>
                <p>{post.description}</p>
                <div class="blog-article-meta">
                    <span>Solar8</span><span>•</span><span>{post.readingTime}</span><span>•</span><time datetime={post.publishedAt}>{new Date(post.publishedAt).toLocaleDateString("en-ZA", { year: "numeric", month: "long", day: "numeric" })}</time>
                </div>
            </header>

            {post.image && <img src={post.imageUrl ?? post.image} alt={post.imageAlt ?? post.title} class="blog-article-image" />}

            <div class="blog-article-body" set:html={post.content}></div>

            <div class="blog-article-cta">
                <h2>Want help choosing the right solar system?</h2>
                <p>Get a FREE Solar8 assessment based on your property and electricity needs.</p>
                <a href="/assessment/" class="primary-button">Get My FREE Assessment</a>
            </div>
        </div>
    </article>
</BlogLayout>

<style>
.blog-article{padding:54px 0 110px;background:#fff}.blog-breadcrumbs{display:flex;flex-wrap:wrap;gap:9px;align-items:center;color:#94a3b8;font-size:14px}.blog-breadcrumbs a{color:#64748b;text-decoration:none}.blog-breadcrumbs a:hover{color:#ff6800}.blog-article-header{max-width:900px;margin:62px auto 42px;text-align:center}.blog-article-header h1{margin:14px 0 20px;font-family:Poppins,sans-serif;font-size:clamp(38px,5vw,64px);line-height:1.08;letter-spacing:-.03em;color:#0f172a}.blog-article-header p{margin:0;color:#64748b;font-size:19px;line-height:1.75}.blog-article-meta{display:flex;justify-content:center;flex-wrap:wrap;gap:10px;margin-top:22px;color:#94a3b8;font-size:14px}.blog-article-image{display:block;width:min(1100px,100%);max-height:580px;object-fit:cover;margin:0 auto 52px;border-radius:26px}.blog-article-body{max-width:820px;margin:0 auto;color:#334155;font-size:18px;line-height:1.85}.blog-article-body :global(h2){margin:48px 0 14px;font-family:Poppins,sans-serif;font-size:32px;line-height:1.2;color:#0f172a}.blog-article-body :global(h3){margin:34px 0 12px;font-family:Poppins,sans-serif;font-size:24px;color:#0f172a}.blog-article-body :global(p){margin:0 0 22px}.blog-article-body :global(a){color:#ff6800;font-weight:700}.blog-article-body :global(ul),.blog-article-body :global(ol){margin:0 0 24px;padding-left:26px}.blog-article-cta{max-width:820px;margin:64px auto 0;padding:38px;background:#fff7f0;border:1px solid #ffd9bd;border-radius:26px}.blog-article-cta h2{margin:0 0 8px;font-family:Poppins,sans-serif;color:#0f172a}.blog-article-cta p{margin:0 0 22px;color:#64748b}
@media(max-width:640px){.blog-article{padding:34px 0 78px}.blog-article-header{margin-top:46px}.blog-article-header p{font-size:17px}.blog-article-body{font-size:17px}.blog-article-body :global(h2){font-size:28px}.blog-article-cta{padding:28px 24px}}
</style>
