---
import BaseLayout from "../layouts/BaseLayout.astro";

import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

import { company } from "../data/company";
---

<BaseLayout
  title="About Solar8 | Trusted Solar Experts in Gauteng"
  description="Learn why Solar8 is helping homeowners and businesses across Gauteng reduce electricity costs through professional solar design, quality equipment and expert installation."
>

<Navigation />

<!-- ========================================================= -->
<!-- Hero                                                      -->
<!-- ========================================================= -->

<section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 text-white">

    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(249,115,22,0.18),transparent_40%)]"></div>

    <div class="relative mx-auto max-w-7xl px-6 py-24 lg:py-32">

        <div class="max-w-3xl">

            <span class="inline-flex rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-1 text-sm font-semibold tracking-wide text-orange-300">
                ABOUT SOLAR8
            </span>

            <h1 class="mt-8 text-5xl font-extrabold leading-tight tracking-tight lg:text-6xl">

                Helping South Africans Take Control of Their Electricity Costs

            </h1>

            <p class="mt-8 max-w-2xl text-xl leading-9 text-slate-300">

                At Solar8, we believe every family and every business deserves
                reliable electricity, lower monthly costs and honest advice.
                We don't believe in selling the biggest system —
                we believe in recommending the right one.

            </p>

            <div class="mt-10 flex flex-wrap gap-4">

                <a
                    href="/assessment"
                    class="rounded-xl bg-orange-500 px-8 py-4 text-lg font-semibold text-white shadow-xl transition hover:-translate-y-1 hover:bg-orange-600"
                >
                    {company.cta.primary}
                </a>

                <a
                    href="/systems"
                    class="rounded-xl border border-white/20 px-8 py-4 text-lg font-semibold transition hover:border-orange-400 hover:text-orange-300"
                >
                    View Solar Systems
                </a>

            </div>

        </div>

    </div>

</section>

<!-- ========================================================= -->
<!-- Company Introduction                                      -->
<!-- ========================================================= -->

<section class="bg-white py-24">

    <div class="mx-auto grid max-w-7xl gap-16 px-6 lg:grid-cols-2 lg:items-center">

        <div>

            <span class="text-sm font-bold uppercase tracking-[0.25em] text-orange-500">

                WHO WE ARE

            </span>

            <h2 class="mt-4 text-4xl font-extrabold text-slate-900">

                More Than Solar Installers

            </h2>

            <p class="mt-8 text-lg leading-9 text-slate-600">

                Solar8 was founded with a simple goal:
                to help South African homeowners and businesses become less
                dependent on rising electricity costs while investing in
                quality energy solutions that deliver value for years to come.

            </p>

            <p class="mt-6 text-lg leading-9 text-slate-600">

                We understand that investing in solar is a major financial
                decision. That's why every recommendation we make is based on
                your actual electricity usage, your goals and your budget —
                not on selling the most expensive equipment.

            </p>

            <p class="mt-6 text-lg leading-9 text-slate-600">

                Whether you're looking for backup power during load shedding or
                complete energy independence, our approach remains the same:
                honest advice, quality workmanship and long-term support.

            </p>

        </div>

        <div>

            <div class="rounded-3xl border border-slate-200 bg-slate-50 p-10 shadow-xl">

                <h3 class="text-2xl font-bold text-slate-900">

                    Why Customers Choose Solar8

                </h3>

                <ul class="mt-8 space-y-6">

                    <li class="flex gap-4">

                        <div class="mt-1 h-3 w-3 rounded-full bg-orange-500"></div>

                        <div>

                            <h4 class="font-semibold text-slate-900">

                                Honest Recommendations

                            </h4>

                            <p class="mt-2 text-slate-600">

                                Every system is designed around your
                                electricity usage rather than pushing a
                                one-size-fits-all package.

                            </p>

                        </div>

                    </li>

                    <li class="flex gap-4">

                        <div class="mt-1 h-3 w-3 rounded-full bg-orange-500"></div>

                        <div>

                            <h4 class="font-semibold text-slate-900">

                                Premium Equipment

                            </h4>

                            <p class="mt-2 text-slate-600">

                                We work with trusted manufacturers known for
                                performance, reliability and long-term
                                warranties.

                            </p>

                        </div>

                    </li> 
                                        <li class="flex gap-4">

                        <div class="mt-1 h-3 w-3 rounded-full bg-orange-500"></div>

                        <div>

                            <h4 class="font-semibold text-slate-900">

                                Professional Installation

                            </h4>

                            <p class="mt-2 text-slate-600">

                                Every installation is completed using industry
                                best practices with safety, neat workmanship
                                and long-term reliability as our priorities.

                            </p>

                        </div>

                    </li>

                    <li class="flex gap-4">

                        <div class="mt-1 h-3 w-3 rounded-full bg-orange-500"></div>

                        <div>

                            <h4 class="font-semibold text-slate-900">

                                Local Support

                            </h4>

                            <p class="mt-2 text-slate-600">

                                Our relationship doesn't end after
                                installation. We're here to support you
                                throughout the life of your solar investment.

                            </p>

                        </div>

                    </li>

                </ul>

            </div>

        </div>

    </div>

</section>

<!-- ========================================================= -->
<!-- Mission & Vision                                           -->
<!-- ========================================================= -->

<section class="bg-slate-100 py-24">

    <div class="mx-auto max-w-7xl px-6">

        <div class="mx-auto max-w-3xl text-center">

            <span class="text-sm font-bold uppercase tracking-[0.25em] text-orange-500">

                OUR PURPOSE

            </span>

            <h2 class="mt-4 text-4xl font-extrabold text-slate-900">

                Building Trust Through Better Energy Solutions

            </h2>

            <p class="mt-8 text-lg leading-9 text-slate-600">

                Solar8 exists to make solar simple.

                We remove confusion, explain every option clearly and recommend
                systems that genuinely suit our customers' homes, businesses
                and budgets.

            </p>

        </div>

        <div class="mt-20 grid gap-8 lg:grid-cols-2">

            <div class="rounded-3xl bg-white p-10 shadow-xl">

                <div class="inline-flex rounded-xl bg-orange-100 px-4 py-2 text-sm font-bold text-orange-600">

                    OUR MISSION

                </div>

                <h3 class="mt-8 text-3xl font-bold text-slate-900">

                    Helping Families Spend Less on Electricity

                </h3>

                <p class="mt-6 leading-8 text-slate-600">

                    Our mission is to provide honest advice, premium equipment
                    and professional installations that reduce electricity
                    costs while increasing energy independence for every
                    customer we serve.

                </p>

            </div>

            <div class="rounded-3xl bg-slate-900 p-10 text-white shadow-xl">

                <div class="inline-flex rounded-xl bg-orange-500 px-4 py-2 text-sm font-bold">

                    OUR VISION

                </div>

                <h3 class="mt-8 text-3xl font-bold">

                    Becoming Gauteng's Most Trusted Solar Company

                </h3>

                <p class="mt-6 leading-8 text-slate-300">

                    We aren't trying to become the biggest installer.

                    We aim to become the company homeowners and businesses
                    trust first when making one of the most important
                    investments in their property.

                </p>

            </div>

        </div>

    </div>

</section>

<!-- ========================================================= -->
<!-- Company Values                                              -->
<!-- ========================================================= -->

<section class="bg-white py-24">

    <div class="mx-auto max-w-7xl px-6">

        <div class="mx-auto max-w-3xl text-center">

            <span class="text-sm font-bold uppercase tracking-[0.25em] text-orange-500">

                OUR VALUES

            </span>

            <h2 class="mt-4 text-4xl font-extrabold text-slate-900">

