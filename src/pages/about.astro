---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { company } from "../data/company";
---

<BaseLayout
  title="About Solar8 | Trusted Solar Experts in Gauteng"
  description="Learn why Solar8 is helping homeowners and businesses across Gauteng reduce electricity costs through professional solar design, quality equipment and expert installation."
>

<Navigation />

<!-- ========================================================= -->
<!-- Hero -->
<!-- ========================================================= -->

<section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 text-white">

  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(249,115,22,0.18),transparent_40%)]"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-28 lg:py-36">

    <div class="max-w-3xl">

      <p class="inline-flex rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-1 text-sm font-semibold tracking-wide text-orange-300">
        ABOUT SOLAR8
      </p>

      <h1 class="mt-8 text-5xl font-extrabold leading-tight tracking-tight lg:text-6xl">

        Helping South Africans
        <br />
        Take Control of
        <br />
        Their Electricity Costs

      </h1>

      <p class="mt-8 max-w-2xl text-xl leading-9 text-slate-300">

        Solar8 exists to help homeowners and businesses reduce electricity
        costs through honest advice, premium solar equipment and professional
        installations designed around your needs—not around sales targets.

      </p>

      <div class="mt-10 flex flex-wrap gap-4">

        <a
          href="/assessment"
          class="rounded-xl bg-orange-500 px-8 py-4 text-lg font-semibold text-white shadow-xl transition hover:-translate-y-1 hover:bg-orange-600"
        >
          {company.cta.primary}
        </a>

        <a
          href="/systems"
          class="rounded-xl border border-white/20 px-8 py-4 text-lg font-semibold transition hover:border-orange-400 hover:text-orange-300"
        >
          View Solar Systems
        </a>

      </div>

    </div>

  </div>

</section>

<!-- ========================================================= -->
<!-- Who We Are -->
<!-- ========================================================= -->

<section class="bg-white py-24">

  <div class="mx-auto max-w-7xl px-6 lg:grid lg:grid-cols-2 lg:gap-20 lg:items-center">

    <!-- Left -->

    <div>

      <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-500">
        WHO WE ARE
      </p>

      <h2 class="mt-4 text-4xl font-extrabold text-slate-900">

        More Than
        <br />
        Solar Installers

      </h2>

      <p class="mt-8 text-lg leading-9 text-slate-600">

        Solar8 was founded with one simple goal: help South African
        homeowners and businesses reduce their electricity costs while
        investing in reliable, long-term energy solutions.

      </p>

      <p class="mt-6 text-lg leading-9 text-slate-600">

        We understand that installing solar is a significant investment.
        That's why every recommendation begins with understanding your
        electricity usage, your property and your goals before recommending
        the most suitable solution.

      </p>

      <p class="mt-6 text-lg leading-9 text-slate-600">

        Whether you're looking for backup power during load shedding,
        lower monthly electricity bills or complete energy independence,
        our commitment remains the same:
        honest advice, quality workmanship and long-term support.

      </p>

    </div>

    <!-- ========================================================= -->
<!-- Mission & Vision -->
<!-- ========================================================= -->

<section class="bg-slate-100 py-24">

  <div class="mx-auto max-w-7xl px-6">

    <div class="mx-auto max-w-3xl text-center">

      <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-500">
        OUR PURPOSE
      </p>

      <h2 class="mt-4 text-4xl font-extrabold text-slate-900">

        Building Trust Through
        Better Energy Solutions

      </h2>

      <p class="mt-8 text-lg leading-9 text-slate-600">

        Solar8 exists to simplify solar.
        We remove the confusion, explain every option clearly and design
        systems that genuinely suit each customer's needs and budget.

      </p>

    </div>

    <div class="mt-20 grid gap-8 lg:grid-cols-2">

      <!-- Mission -->

      <div class="rounded-3xl bg-white p-10 shadow-xl">

        <div class="inline-flex rounded-xl bg-orange-100 px-4 py-2 text-sm font-bold text-orange-600">

          OUR MISSION

        </div>

        <h3 class="mt-8 text-3xl font-bold text-slate-900">

          Helping South Africans Spend Less On Electricity

        </h3>

        <p class="mt-6 leading-8 text-slate-600">

          We provide honest advice, premium equipment and professional
          installations that lower electricity costs while increasing
          energy independence for every customer.

        </p>

      </div>

      <!-- Vision -->

      <div class="rounded-3xl bg-slate-900 p-10 text-white shadow-xl">

        <div class="inline-flex rounded-xl bg-orange-500 px-4 py-2 text-sm font-bold">

          OUR VISION

        </div>

        <h3 class="mt-8 text-3xl font-bold">

          Gauteng's Most Trusted Solar Company

        </h3>

        <p class="mt-6 leading-8 text-slate-300">

          We aren't trying to become the biggest installer.

          Our goal is to become the company that homeowners and businesses
          trust first when investing in solar energy.

        </p>

      </div>

    </div>

  </div>

</section>

<!-- ========================================================= -->
<!-- Our Values -->
<!-- ========================================================= -->

<section class="bg-white py-24">

    <div class="mx-auto max-w-7xl px-6">

        <div class="mx-auto max-w-3xl text-center">

            <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-500">

                OUR VALUES

            </p>

            <h2 class="mt-4 text-4xl font-extrabold text-slate-900">

                The Principles Behind
                Every Recommendation

            </h2>

            <p class="mt-8 text-lg leading-9 text-slate-600">

                Everything we do is built around honesty, quality and
                creating long-term value for every customer.

            </p>

        </div>

        <div class="mt-20 grid gap-8 md:grid-cols-2 lg:grid-cols-4">

            <!-- Card 1 -->

            <div class="group rounded-3xl border border-slate-200 bg-white p-10 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">

                <div class="mb-6 text-5xl">🎓</div>

                <h3 class="text-2xl font-bold text-slate-900">

                    Educate First

                </h3>

                <p class="mt-5 leading-8 text-slate-600">

                    We explain every option clearly so customers can make
                    informed decisions with confidence.

                </p>

            </div>

            <!-- Card 2 -->

            <div class="group rounded-3xl border border-slate-200 bg-white p-10 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">

                <div class="mb-6 text-5xl">⭐</div>

                <h3 class="text-2xl font-bold text-slate-900">

                    Quality Always

                </h3>

                <p class="mt-5 leading-8 text-slate-600">

                    We recommend equipment that we would confidently install
                    in our own homes.

                </p>

            </div>

            <!-- Card 3 -->

            <div class="group rounded-3xl border border-slate-200 bg-white p-10 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">

                <div class="mb-6 text-5xl">🤝</div>

                <h3 class="text-2xl font-bold text-slate-900">

                    Honest Advice

                </h3>

                <p class="mt-5 leading-8 text-slate-600">

                    We recommend the right solution—not the most expensive
                    solution.

                </p>

            </div>

            <!-- Card 4 -->

            <div class="group rounded-3xl border border-slate-200 bg-white p-10 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">

                <div class="mb-6 text-5xl">🛠️</div>

                <h3 class="text-2xl font-bold text-slate-900">

                    Long-Term Support

                </h3>

                <p class="mt-5 leading-8 text-slate-600">

                    Our relationship continues long after installation with
                    dependable support whenever you need us.

                </p>

            </div>

        </div>

    </div>

</section>

<!-- ========================================================= -->
<!-- Our Process -->
<!-- ========================================================= -->

<section class="bg-slate-50 py-24">

    <div class="mx-auto max-w-7xl px-6">

        <div class="mx-auto max-w-3xl text-center">

            <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-500">

                OUR PROCESS

            </p>

            <h2 class="mt-4 text-4xl font-extrabold text-slate-900">

                From First Conversation
                <br />
                To Power Independence

            </h2>

            <p class="mt-8 text-lg leading-9 text-slate-600">

                We've simplified the solar journey into five straightforward
                steps so you'll always know what happens next.

            </p>

        </div>

        <div class="mt-20 grid gap-8 md:grid-cols-2 lg:grid-cols-5">

            <div class="text-center">

                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-orange-500 text-3xl font-bold text-white shadow-lg">

                    1

                </div>

                <h3 class="mt-6 text-xl font-bold text-slate-900">

                    Assessment

                </h3>

                <p class="mt-4 leading-7 text-slate-600">

                    We learn about your electricity usage, property and goals.

                </p>

            </div>

            <div class="text-center">

                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-orange-500 text-3xl font-bold text-white shadow-lg">

                    2

                </div>

                <h3 class="mt-6 text-xl font-bold text-slate-900">

                    System Design

                </h3>

                <p class="mt-4 leading-7 text-slate-600">

                    We recommend the right inverter, batteries and solar panels.

                </p>

            </div>

            <div class="text-center">

                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-orange-500 text-3xl font-bold text-white shadow-lg">

                    3

                </div>

                <h3 class="mt-6 text-xl font-bold text-slate-900">

                    Proposal

                </h3>

                <p class="mt-4 leading-7 text-slate-600">

                    Receive a clear quotation with no hidden surprises.

                </p>

            </div>

            <div class="text-center">

                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-orange-500 text-3xl font-bold text-white shadow-lg">

                    4

                </div>

                <h3 class="mt-6 text-xl font-bold text-slate-900">

                    Installation

                </h3>

                <p class="mt-4 leading-7 text-slate-600">

                    Professional installation completed safely and efficiently.

                </p>

            </div>

            <div class="text-center">

                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-orange-500 text-3xl font-bold text-white shadow-lg">

                    5

                </div>

                <h3 class="mt-6 text-xl font-bold text-slate-900">

                    Support

                </h3>

                <p class="mt-4 leading-7 text-slate-600">

                    Ongoing advice, monitoring and assistance throughout the life of your system.

                </p>

            </div>

        </div>

    </div>

</section>

<!-- ========================================================= -->
<!-- Warranty & Peace of Mind -->
<!-- ========================================================= -->

<section class="bg-orange-500 py-24 text-white">

    <div class="mx-auto max-w-7xl px-6 text-center">

        <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-100">

            PEACE OF MIND

        </p>

        <h2 class="mt-4 text-4xl font-extrabold">

            Built to Perform.
            <br />
            Backed for Years.

        </h2>

        <p class="mx-auto mt-8 max-w-3xl text-xl leading-9 text-orange-100">

            Every Solar8 installation uses premium equipment backed by
            manufacturer warranties and installed to the highest professional
            standards. Our goal is to give you confidence that your investment
            will continue delivering value for many years to come.

        </p>

        <div class="mt-20 grid gap-8 md:grid-cols-2 lg:grid-cols-4">

            <!-- Panels -->

            <div class="rounded-3xl bg-white/10 p-10 backdrop-blur">

                <div class="text-5xl font-extrabold">

                    25

                </div>

                <p class="mt-4 text-lg font-semibold">

                    Year Solar Panel Performance*

                </p>

            </div>

            <!-- Batteries -->

            <div class="rounded-3xl bg-white/10 p-10 backdrop-blur">

                <div class="text-5xl font-extrabold">

                    10

                </div>

                <p class="mt-4 text-lg font-semibold">

                    Year Battery Warranty*

                </p>

            </div>

            <!-- Inverter -->

            <div class="rounded-3xl bg-white/10 p-10 backdrop-blur">

                <div class="text-5xl font-extrabold">

                    5

                </div>

                <p class="mt-4 text-lg font-semibold">

                    Year Inverter Warranty*

                </p>

            </div>

            <!-- Installation -->

            <div class="rounded-3xl bg-white/10 p-10 backdrop-blur">

                <div class="text-5xl font-extrabold">

                    ✓

                </div>

                <p class="mt-4 text-lg font-semibold">

                    Professional Installation Standards

                </p>

            </div>

        </div>

        <p class="mt-10 text-sm text-orange-100">

            *Warranty periods vary depending on manufacturer and selected equipment.

        </p>

    </div>

</section>

    <!-- Right Card -->

    <div class="mt-16 lg:mt-0">

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-10 shadow-xl">

        <h3 class="text-2xl font-bold text-slate-900">

          Why Customers Choose Solar8

        </h3>

        <div class="mt-10 space-y-8">

          <div class="flex gap-4">

            <div class="mt-2 h-3 w-3 rounded-full bg-orange-500"></div>

            <div>

              <h4 class="font-semibold text-slate-900">

                Honest Recommendations

              </h4>

              <p class="mt-2 text-slate-600">

                Every recommendation is based on your energy needs,
                not on selling the largest system.

              </p>

            </div>

          </div>

          <div class="flex gap-4">

            <div class="mt-2 h-3 w-3 rounded-full bg-orange-500"></div>

            <div>

              <h4 class="font-semibold text-slate-900">

                Premium Equipment

              </h4>

              <p class="mt-2 text-slate-600">

                We partner with trusted manufacturers known for
                reliability, performance and excellent warranties.

              </p>

            </div>

          </div>

          <div class="flex gap-4">

            <div class="mt-2 h-3 w-3 rounded-full bg-orange-500"></div>

            <div>

              <h4 class="font-semibold text-slate-900">

                Professional Installation

              </h4>

              <p class="mt-2 text-slate-600">

                Every installation is completed using industry best
                practices with safety and workmanship as our priority.

              </p>

            </div>

          </div>

          <div class="flex gap-4">

            <div class="mt-2 h-3 w-3 rounded-full bg-orange-500"></div>

            <div>

              <h4 class="font-semibold text-slate-900">

                Ongoing Support

              </h4>

              <p class="mt-2 text-slate-600">

                Our relationship continues long after installation with
                support whenever you need us.

              </p>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<!-- ========================================================= -->
<!-- Final Call To Action -->
<!-- ========================================================= -->

<section class="bg-slate-950 py-24 text-white">

    <div class="mx-auto max-w-5xl px-6 text-center">

        <p class="text-sm font-bold uppercase tracking-[0.25em] text-orange-400">

            READY TO START YOUR SOLAR JOURNEY?

        </p>

        <h2 class="mt-6 text-5xl font-extrabold leading-tight">

            Let's Design the Right
            <br />
            Solar Solution
            <br />
            For You

        </h2>

        <p class="mx-auto mt-8 max-w-3xl text-xl leading-9 text-slate-300">

            Whether you're looking for backup power during load shedding,
            lower electricity bills or complete energy independence,
            our team is ready to design a system that fits your property,
            your budget and your future.

        </p>

        <div class="mt-12 flex flex-wrap justify-center gap-6">

            <a
                href="/assessment"
                class="rounded-xl bg-orange-500 px-10 py-4 text-lg font-semibold text-white shadow-xl transition-all duration-300 hover:-translate-y-1 hover:bg-orange-600 hover:shadow-2xl"
            >
                {company.cta.primary}
            </a>

            <a
                href="/contact"
                class="rounded-xl border border-white/20 px-10 py-4 text-lg font-semibold transition-all duration-300 hover:border-orange-500 hover:text-orange-300"
            >
                Contact Solar8
            </a>

        </div>

    </div>

</section>

<!-- ========================================================= -->
<!-- Closing Footer                                             -->
<!-- ========================================================= -->

<Footer />

</BaseLayout>