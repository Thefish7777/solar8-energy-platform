---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { company } from "../data/company";
---

<BaseLayout
  title="About Solar8 | Trusted Solar Experts in Gauteng"
  description="Learn why Solar8 is helping homeowners and businesses across Gauteng reduce electricity costs through professional solar design, quality equipment and expert installation."
>

  <Navigation />

  <main>

    <!-- =========================================================
         HERO
    ========================================================== -->

    <section class="about-page-hero">

      <div class="container">

        <div class="about-page-hero-content">

          <p class="section-tag">
            ABOUT SOLAR8
          </p>

          <h1>
            Helping South Africans
            <br />
            Take Control of
            <br />
            Their Electricity Costs
          </h1>

          <p class="about-page-hero-text">
            Solar8 exists to help homeowners and businesses reduce electricity
            costs through honest advice, premium solar equipment and
            professional installations designed around your needs — not around
            sales targets.
          </p>

          <div class="about-page-hero-buttons">

            <a
              href="/assessment/"
              class="primary-button"
            >
              {company.cta.primary}
            </a>

            <a
              href="/systems/"
              class="secondary-button"
            >
              View Solar Systems
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================================
         WHO WE ARE
    ========================================================== -->

    <section class="bg-white py-24">

      <div class="container">

        <div class="about-section-heading">

          <p class="section-tag">
            WHO WE ARE
          </p>

          <h2>
            More Than
            <br />
            Solar Installers
          </h2>

          <p class="about-section-intro">
            Solar8 was founded with one simple goal: help South African
            homeowners and businesses reduce their electricity costs while
            investing in reliable, long-term energy solutions.
          </p>

        </div>


        <!-- Main content -->

        <div class="about-who-content">

          <!-- Main text -->

          <div class="about-who-copy">

            <p>
              We understand that installing solar is a significant investment.
              That's why every recommendation begins with understanding your
              electricity usage, your property and your goals before
              recommending the most suitable solution.
            </p>

            <p>
              Whether you're looking for backup power during load shedding,
              lower monthly electricity bills or greater energy independence,
              our commitment remains the same: honest advice, quality
              workmanship and long-term support.
            </p>

          </div>


          <!-- Why customers choose Solar8 -->

          <div class="about-choice-card">

            <h3>
              Why Customers Choose Solar8
            </h3>

            <div class="about-choice-list">

              <div class="about-choice-item">

                <div class="about-choice-icon">
                  ✓
                </div>

                <div>

                  <h4>
                    Honest Recommendations
                  </h4>

                  <p>
                    Every recommendation is based on your energy needs,
                    not on selling the largest system.
                  </p>

                </div>

              </div>


              <div class="about-choice-item">

                <div class="about-choice-icon">
                  ✓
                </div>

                <div>

                  <h4>
                    Premium Equipment
                  </h4>

                  <p>
                    We partner with trusted manufacturers known for
                    reliability, performance and excellent warranties.
                  </p>

                </div>

              </div>


              <div class="about-choice-item">

                <div class="about-choice-icon">
                  ✓
                </div>

                <div>

                  <h4>
                    Professional Installation
                  </h4>

                  <p>
                    Every installation is completed using industry best
                    practices with safety and workmanship as our priority.
                  </p>

                </div>

              </div>


              <div class="about-choice-item">

                <div class="about-choice-icon">
                  ✓
                </div>

                <div>

                  <h4>
                    Ongoing Support
                  </h4>

                  <p>
                    Our relationship continues long after installation
                    with support whenever you need us.
                  </p>

                </div>

              </div>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================================
         MISSION & VISION
    ========================================================== -->

    <section class="about-mission-section">

      <div class="container">

        <div class="about-section-heading">

          <p class="section-tag">
            WHAT DRIVES US
          </p>

          <h2>
            Our Mission &amp; Vision
          </h2>

          <p class="about-section-intro">
            Solar8 is built around a simple philosophy: give customers
            honest advice and design energy systems that genuinely improve
            their lives.
          </p>

        </div>


        <div class="about-mission-grid">

          <!-- Mission -->

          <div class="about-mission-card">

            <div class="about-card-label">
              OUR MISSION
            </div>

            <h3>
              Helping South Africans Spend Less On Electricity
            </h3>

            <p>
              We provide honest advice, premium equipment and professional
              installations that lower electricity costs while increasing
              energy independence for every customer.
            </p>

          </div>


          <!-- Vision -->

          <div class="about-vision-card">

            <div class="about-card-label">
              OUR VISION
            </div>

            <h3>
              Gauteng's Most Trusted Solar Company
            </h3>

            <p>
              We aren't trying to become the biggest installer.
              Our goal is to become the company that homeowners and businesses
              trust first when investing in solar energy.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================================
         FINAL CALL TO ACTION
    ========================================================== -->

    <section class="about-final-cta">

      <div class="container">

        <div class="about-final-cta-content">

          <p class="section-tag">
            READY TO START YOUR SOLAR JOURNEY?
          </p>

          <h2>
            Let's Design the Right
            <br />
            Solar Solution
            <br />
            For You
          </h2>

          <p>
            Whether you're looking for backup power during load shedding,
            lower monthly electricity bills or a complete solar solution,
            our team is ready to design a system that fits your property,
            your budget and your future.
          </p>

          <div class="about-final-buttons">

            <a
              href="/assessment/"
              class="primary-button"
            >
              {company.cta.primary}
            </a>

            <a
              href="/contact/"
              class="about-final-secondary"
            >
              Contact Solar8
            </a>

          </div>

        </div>

      </div>

    </section>

  </main>

  <Footer />

</BaseLayout>