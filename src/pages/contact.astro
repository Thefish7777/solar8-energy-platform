---
import MainLayout from "../layouts/MainLayout.astro";
import { company } from "../data/company";

const addressLines = [
    "Retief Avenue",
    "Lyttelton Manor",
    "Centurion, Gauteng",
    "0157",
    "South Africa",
];

const mapUrl = "https://www.google.com/maps/search/?api=1&query=Retief+Avenue%2C+Lyttelton+Manor%2C+Centurion%2C+Gauteng%2C+0157%2C+South+Africa";
---

<MainLayout title="Contact Solar8 | Solar Energy Experts in Centurion & Gauteng" description="Contact Solar8 in Centurion for residential and commercial solar systems, battery backup, installation advice and a free solar assessment across Gauteng.">
    <section class="contact-hero">
        <div class="solar-container contact-hero-grid">
            <div class="contact-hero-copy">
                <span class="eyebrow">GET IN TOUCH</span>
                <h1>Let's Talk About Your <span>Solar Future.</span></h1>
                <p>
                    Whether you need backup power, lower electricity costs or a complete solar solution,
                    the Solar8 team is ready to help you choose the right system for your property.
                </p>

                <div class="hero-actions">
                    <a href="/assessment/" class="button button-primary">Get My FREE Assessment</a>
                    <a href={company.phoneHref} class="button button-secondary">Call {company.phone}</a>
                </div>
            </div>

            <div class="hero-contact-card">
                <span class="card-label">SOLAR8</span>
                <h2>Speak to an Expert</h2>
                <p>Talk to us about your requirements and we'll help you work out the best next step.</p>

                <a class="quick-contact" href={company.phoneHref}>
                    <span class="quick-icon">☎</span>
                    <span>
                        <small>CALL US</small>
                        <strong>{company.phone}</strong>
                    </span>
                </a>

                <a class="quick-contact" href={company.whatsappHref} target="_blank" rel="noopener noreferrer">
                    <span class="quick-icon">WA</span>
                    <span>
                        <small>WHATSAPP</small>
                        <strong>{company.whatsapp}</strong>
                    </span>
                </a>

                <a class="quick-contact" href={company.emailHref}>
                    <span class="quick-icon">@</span>
                    <span>
                        <small>EMAIL</small>
                        <strong>{company.email}</strong>
                    </span>
                </a>
            </div>
        </div>
    </section>

    <section class="contact-section">
        <div class="solar-container">
            <div class="section-heading centered">
                <span class="eyebrow">WE'RE HERE TO HELP</span>
                <h2>Contact Solar8</h2>
                <p>
                    Get in touch with our team for solar advice, system information, assessments and general enquiries.
                </p>
            </div>

            <div class="contact-grid">
                <article class="contact-card">
                    <div class="contact-icon">☎</div>
                    <span class="card-label">PHONE</span>
                    <h3>Call Solar8</h3>
                    <p>Speak directly with our team during business hours.</p>
                    <a href={company.phoneHref}>{company.phone}</a>
                </article>

                <article class="contact-card">
                    <div class="contact-icon">WA</div>
                    <span class="card-label">WHATSAPP</span>
                    <h3>Message Us</h3>
                    <p>Send us a WhatsApp message for a quick response.</p>
                    <a href={company.whatsappHref} target="_blank" rel="noopener noreferrer">{company.whatsapp}</a>
                </article>

                <article class="contact-card">
                    <div class="contact-icon">@</div>
                    <span class="card-label">EMAIL</span>
                    <h3>Email Us</h3>
                    <p>Send your enquiry and our team will get back to you.</p>
                    <a href={company.emailHref}>{company.email}</a>
                </article>
            </div>
        </div>
    </section>

    <section class="location-section">
        <div class="solar-container location-grid">
            <div>
                <span class="eyebrow">VISIT / SERVICE AREA</span>
                <h2>Based in Centurion.<br /><span>Serving Gauteng.</span></h2>
                <p>
                    Solar8 is based in Lyttelton Manor, Centurion, and serves customers throughout Gauteng,
                    including Pretoria, Centurion, Midrand, Johannesburg, the East Rand and West Rand.
                </p>

                <div class="address-box">
                    <div class="contact-icon">⌖</div>
                    <div>
                        <strong>Solar8</strong>
                        {addressLines.map((line) => <span>{line}</span>)}
                    </div>
                </div>

                <a class="map-link" href={mapUrl} target="_blank" rel="noopener noreferrer">
                    Open location in Google Maps <span aria-hidden="true">↗</span>
                </a>
            </div>

            <div class="map-card" aria-label="Solar8 location map">
                <div class="map-grid-lines"></div>
                <div class="map-pin">
                    <span>Solar8</span>
                    <small>Lyttelton Manor · Centurion</small>
                </div>
                <div class="map-road road-one"></div>
                <div class="map-road road-two"></div>
                <div class="map-road road-three"></div>
                <a class="map-overlay-link" href={mapUrl} target="_blank" rel="noopener noreferrer">
                    View map &nbsp;↗
                </a>
            </div>
        </div>
    </section>

    <section class="enquiry-section">
        <div class="solar-container enquiry-grid">
            <div class="enquiry-copy">
                <span class="eyebrow">SEND AN ENQUIRY</span>
                <h2>Tell Us What You Need.</h2>
                <p>
                    Give us a few details and your enquiry will be prepared in your email application for sending to Solar8.
                    For a faster conversation, call or WhatsApp us directly.
                </p>

                <div class="hours-card">
                    <span class="card-label">BUSINESS HOURS</span>
                    {company.businessHours.map((hours) => <p>{hours}</p>)}
                </div>
            </div>

            <form id="contactForm" class="contact-form">
                <div class="form-row">
                    <label>
                        <span>Name</span>
                        <input type="text" name="name" autocomplete="name" required placeholder="Your name" />
                    </label>
                    <label>
                        <span>Phone</span>
                        <input type="tel" name="phone" autocomplete="tel" required placeholder="Your phone number" />
                    </label>
                </div>

                <div class="form-row">
                    <label>
                        <span>Email</span>
                        <input type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
                    </label>
                    <label>
                        <span>Subject</span>
                        <select name="subject">
                            <option>General Enquiry</option>
                            <option>Free Solar Assessment</option>
                            <option>Residential Solar</option>
                            <option>Commercial Solar</option>
                            <option>Solar Systems</option>
                            <option>Battery Storage</option>
                            <option>Finance</option>
                        </select>
                    </label>
                </div>

                <label>
                    <span>Message</span>
                    <textarea name="message" rows="6" required placeholder="Tell us a little about your solar requirements..."></textarea>
                </label>

                <button type="submit" class="button button-primary form-submit">Prepare Email Enquiry</button>
                <p class="form-note">Your email application will open with the enquiry details filled in.</p>
                <p id="formStatus" class="form-status" role="status" aria-live="polite"></p>
            </form>
        </div>
    </section>

    <section class="final-cta">
        <div class="solar-container">
            <div class="final-cta-inner">
                <span class="eyebrow">READY TO GET STARTED?</span>
                <h2>Let's Design the Right<br />Solar Solution For You.</h2>
                <p>
                    Get a tailored starting point for your property with our free solar assessment.
                </p>
                <div class="final-actions">
                    <a href="/assessment/" class="button button-primary">Get My FREE Assessment</a>
                    <a href={company.phoneHref} class="button button-secondary">Speak to an Expert</a>
                </div>
            </div>
        </div>
    </section>
</MainLayout>

<script>
    const form = document.querySelector<HTMLFormElement>("#contactForm");
    const status = document.querySelector<HTMLParagraphElement>("#formStatus");

    form?.addEventListener("submit", (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const name = String(data.get("name") ?? "");
        const phone = String(data.get("phone") ?? "");
        const email = String(data.get("email") ?? "");
        const subject = String(data.get("subject") ?? "General Enquiry");
        const message = String(data.get("message") ?? "");

        const body = [
            `Name: ${name}`,
            `Phone: ${phone}`,
            `Email: ${email}`,
            "",
            message,
        ].join("\n");

        const mailto = `mailto:info@solar8.co.za?subject=${encodeURIComponent(`Solar8 Website Enquiry - ${subject}`)}&body=${encodeURIComponent(body)}`;
        window.location.href = mailto;

        if (status) {
            status.textContent = "Opening your email application...";
        }
    });
</script>

<style>
.contact-hero {
    position: relative;
    overflow: hidden;
    padding: 100px 0 90px;
    background: #f7f8fa;
}

.contact-hero::before {
    content: "";
    position: absolute;
    width: 620px;
    height: 620px;
    top: -250px;
    right: -160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 104, 0, 0.16) 0%, rgba(255, 104, 0, 0) 68%);
}

.contact-hero-grid,
.location-grid,
.enquiry-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
    gap: 70px;
    align-items: center;
}

.contact-hero-copy,
.hero-contact-card,
.location-grid > *,
.enquiry-grid > * {
    position: relative;
    z-index: 1;
}

.contact-hero h1 {
    max-width: 800px;
    margin: 18px 0 0;
    font-family: var(--font-heading);
    font-size: clamp(3rem, 6vw, 5.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: #111827;
}

.contact-hero h1 span,
.location-section h2 span {
    color: #ff6800;
}

.contact-hero-copy > p {
    max-width: 720px;
    margin: 30px 0 0;
    color: #4b5563;
    font-size: 18px;
    line-height: 1.8;
}

.hero-actions,
.final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
}

.button {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    padding: 0 26px;
    border-radius: var(--button-radius);
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease;
}

.button:hover {
    transform: translateY(-2px);
}

.button-primary {
    border: 1px solid #ff6800;
    background: #ff6800;
    color: #fff;
}

.button-primary:hover {
    background: #e85e00;
    border-color: #e85e00;
}

.button-secondary {
    border: 1px solid #d1d5db;
    background: #fff;
    color: #111827;
}

.button-secondary:hover {
    border-color: #ff6800;
    color: #ff6800;
}

.hero-contact-card {
    max-width: 500px;
    justify-self: end;
    width: 100%;
    padding: 42px;
    border: 1px solid #e5e7eb;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(17, 24, 39, 0.1);
}

.card-label,
.hero-contact-card small {
    display: block;
    color: #ff6800;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
}

.hero-contact-card h2 {
    margin: 12px 0 0;
    font-family: var(--font-heading);
    font-size: 32px;
    line-height: 1.15;
    color: #111827;
}

.hero-contact-card > p {
    margin: 14px 0 28px;
    color: #6b7280;
    line-height: 1.7;
}

.quick-contact {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 17px 0;
    border-top: 1px solid #edf0f2;
    text-decoration: none;
}

.quick-contact:last-child {
    border-bottom: 0;
}

.quick-icon,
.contact-icon {
    display: inline-flex;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #fff0e8;
    color: #ff6800;
    font-size: 14px;
    font-weight: 900;
}

.quick-contact strong {
    display: block;
    margin-top: 3px;
    color: #111827;
    font-size: 16px;
}

.contact-section,
.enquiry-section {
    padding: 110px 0;
    background: #fff;
}

.contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 55px;
}

.contact-card {
    padding: 32px;
    border: 1px solid #e5e7eb;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 12px 35px rgba(17, 24, 39, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.contact-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 42px rgba(17, 24, 39, 0.09);
}

.contact-card h3 {
    margin: 20px 0 8px;
    font-family: var(--font-heading);
    font-size: 24px;
    color: #111827;
}

.contact-card p {
    min-height: 52px;
    margin: 0;
    color: #6b7280;
    line-height: 1.7;
}

.contact-card a,
.map-link {
    display: inline-flex;
    margin-top: 18px;
    color: #ff6800;
    font-weight: 800;
    text-decoration: none;
}

.location-section {
    padding: 110px 0;
    background: #f7f8fa;
}

.location-grid h2,
.enquiry-copy h2 {
    margin: 18px 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 4vw, 4rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #111827;
}

.location-grid p,
.enquiry-copy > p {
    max-width: 650px;
    margin: 24px 0 0;
    color: #5f6673;
    line-height: 1.8;
}

.address-box {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    max-width: 520px;
    margin-top: 32px;
    padding: 22px;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    background: #fff;
}

.address-box strong,
.address-box span {
    display: block;
}

.address-box strong {
    margin-bottom: 5px;
    color: #111827;
}

.address-box span {
    color: #6b7280;
    line-height: 1.6;
}

.map-link {
    align-items: center;
    gap: 8px;
}

.map-card {
    position: relative;
    min-height: 500px;
    overflow: hidden;
    border: 1px solid #e1e5e9;
    border-radius: 26px;
    background:
        linear-gradient(25deg, transparent 46%, rgba(255, 255, 255, 0.8) 47%, rgba(255, 255, 255, 0.8) 52%, transparent 53%),
        linear-gradient(155deg, transparent 44%, rgba(255, 255, 255, 0.75) 45%, rgba(255, 255, 255, 0.75) 50%, transparent 51%),
        #dfe5e8;
    box-shadow: 0 18px 45px rgba(17, 24, 39, 0.08);
}

.map-grid-lines {
    position: absolute;
    inset: 0;
    opacity: 0.32;
    background-image: linear-gradient(rgba(255, 255, 255, 0.8) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.8) 1px, transparent 1px);
    background-size: 48px 48px;
}

.map-road {
    position: absolute;
    height: 26px;
    border-radius: 999px;
    background: #f7f8fa;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.55);
}

.road-one { width: 120%; top: 43%; left: -10%; transform: rotate(-13deg); }
.road-two { width: 90%; top: 62%; left: 8%; transform: rotate(29deg); }
.road-three { width: 75%; top: 17%; left: 30%; transform: rotate(72deg); }

.map-pin {
    position: absolute;
    left: 50%;
    top: 47%;
    z-index: 2;
    transform: translate(-50%, -50%);
    padding: 17px 20px;
    border-radius: 16px;
    background: #111827;
    color: #fff;
    text-align: center;
    box-shadow: 0 15px 35px rgba(17, 24, 39, 0.2);
}

.map-pin::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 18px;
    height: 18px;
    transform: translateX(-50%) rotate(45deg);
    background: #111827;
}

.map-pin span,
.map-pin small {
    position: relative;
    z-index: 1;
    display: block;
}

.map-pin span {
    color: #ff6800;
    font-weight: 900;
}

.map-pin small {
    margin-top: 4px;
    color: #d1d5db;
}

.map-overlay-link {
    position: absolute;
    right: 20px;
    bottom: 20px;
    z-index: 3;
    padding: 12px 16px;
    border-radius: 12px;
    background: #fff;
    color: #111827;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(17, 24, 39, 0.12);
}

.enquiry-section {
    background: #fff;
}

.enquiry-copy {
    align-self: start;
}

.hours-card {
    max-width: 430px;
    margin-top: 34px;
    padding: 24px;
    border-radius: 20px;
    background: #f7f8fa;
}

.hours-card p {
    margin: 8px 0 0;
    color: #4b5563;
    line-height: 1.5;
}

.contact-form {
    padding: 38px;
    border: 1px solid #e5e7eb;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 18px 50px rgba(17, 24, 39, 0.08);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.contact-form label {
    display: block;
    margin-bottom: 18px;
}

.contact-form label > span {
    display: block;
    margin-bottom: 8px;
    color: #111827;
    font-size: 13px;
    font-weight: 800;
}

.contact-form input,
.contact-form select,
.contact-form textarea {
    width: 100%;
    border: 1px solid #dfe3e7;
    border-radius: 12px;
    background: #fafbfc;
    padding: 14px 15px;
    color: #111827;
    font: inherit;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.contact-form input,
.contact-form select {
    min-height: 50px;
}

.contact-form textarea {
    min-height: 150px;
    resize: vertical;
}

.contact-form input:focus,
.contact-form select:focus,
.contact-form textarea:focus {
    border-color: #ff6800;
    box-shadow: 0 0 0 3px rgba(255, 104, 0, 0.12);
}

.form-submit {
    width: 100%;
    margin-top: 4px;
    cursor: pointer;
}

.form-note,
.form-status {
    margin: 12px 0 0;
    color: #6b7280;
    font-size: 12px;
    line-height: 1.6;
}

.form-status {
    min-height: 18px;
    color: #ff6800;
    font-weight: 700;
}

.final-cta {
    padding: 120px 0;
    background: #111827;
    color: #fff;
}

.final-cta-inner {
    max-width: 850px;
    margin: 0 auto;
    text-align: center;
}

.final-cta .eyebrow {
    color: #ff6800;
}

.final-cta h2 {
    margin: 18px 0 0;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
}

.final-cta p {
    max-width: 650px;
    margin: 25px auto 0;
    color: #d1d5db;
    font-size: 17px;
    line-height: 1.8;
}

.final-actions {
    justify-content: center;
}

.final-cta .button-secondary {
    background: transparent;
    border-color: #4b5563;
    color: #fff;
}

.final-cta .button-secondary:hover {
    border-color: #ff6800;
    color: #ff6800;
}

@media (max-width: 900px) {
    .contact-hero-grid,
    .location-grid,
    .enquiry-grid {
        grid-template-columns: 1fr;
        gap: 45px;
    }

    .hero-contact-card {
        justify-self: stretch;
        max-width: none;
    }

    .contact-grid {
        grid-template-columns: 1fr;
    }

    .contact-card p {
        min-height: 0;
    }

    .map-card {
        min-height: 420px;
    }
}

@media (max-width: 640px) {
    .contact-hero,
    .contact-section,
    .location-section,
    .enquiry-section,
    .final-cta {
        padding: 78px 0;
    }

    .contact-hero h1 {
        font-size: clamp(2.7rem, 13vw, 4rem);
    }

    .hero-actions,
    .final-actions {
        flex-direction: column;
    }

    .button {
        width: 100%;
    }

    .hero-contact-card,
    .contact-form,
    .contact-card {
        padding: 26px;
    }

    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .map-card {
        min-height: 340px;
    }
}
</style>
