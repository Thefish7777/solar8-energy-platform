---
import heroImage from "../assets/images/hero-solar-installation.jpg";

import PrimaryButton from "./ui/PrimaryButton.astro";
import SecondaryButton from "./ui/SecondaryButton.astro";
---

<section class="hero">

    <div class="container hero-grid">

        <div class="hero-content">

            <p class="hero-tag">
                SOLAR8 ENERGY
            </p>

            <h1>
                Power Your Home.<br />
                Power Your Business.<br />
                Power Your Future.
            </h1>

            <p class="hero-text">
                Custom-designed residential and commercial solar systems engineered
                to reduce electricity costs, eliminate load shedding and deliver
                long-term energy independence using premium Tier-1 equipment.
            </p>

            <ul class="hero-features">

                <li>✓ Custom System Design</li>
                <li>✓ Tier-1 Equipment</li>
                <li>✓ Professional Installation</li>
                <li>✓ Manufacturer Warranties</li>

            </ul>

            <div class="hero-buttons">

                <PrimaryButton href="/assessment">
                    Get My Free Assessment
                </PrimaryButton>

                <SecondaryButton href="/residential">
                    Explore Solar Solutions
                </SecondaryButton>

            </div>

        </div>

        <div class="hero-image">

            <img
                src={heroImage.src}
                alt="Solar8 Solar Installation"
            />

            <div class="floating-card card-one">

                <strong>Custom</strong>

                <span>Engineered Systems</span>

            </div>

            <div class="floating-card card-two">

                <strong>40+</strong>

                <span>Years Combined Experience</span>

            </div>

            <div class="floating-card card-three">

                <strong>Tier-1</strong>

                <span>Premium Equipment</span>

            </div>

        </div>

    </div>

</section>