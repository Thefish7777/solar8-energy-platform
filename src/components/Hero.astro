---
import heroImage from "../assets/images/hero-solar.jpg";
---

<section class="relative overflow-hidden bg-white">

  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-6 py-16 lg:grid-cols-2">

    <!-- LEFT COLUMN -->

    <div class="max-w-2xl">

      <!-- Badge -->

      <span class="inline-flex rounded-full bg-orange-100 px-5 py-2 text-sm font-semibold text-orange-600">
        Residential & Commercial Solar Solutions
      </span>

      <!-- Heading -->

      <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-slate-900 lg:text-5xl">
        Take Control of Your
        <br />
        Electricity Costs.
      </h1>

      <!-- Intro -->

      <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">
        Electricity prices continue to rise every year. Solar8 designs and installs premium solar and battery systems that help Gauteng homeowners and businesses lower their monthly electricity bills while providing reliable backup power during outages.

      </p>

      <!-- Buttons -->

      <div class="mt-8 flex flex-wrap gap-4">

        <a
          href="#contact"
          class="rounded-xl bg-orange-500 px-8 py-4 font-semibold text-white shadow-md transition duration-300 hover:-translate-y-1 hover:bg-orange-600 hover:shadow-xl"
        >
          Get My FREE Assessment
        </a>

        <a
          href="#packages"
          class="rounded-xl border border-slate-300 bg-white px-8 py-4 font-semibold text-slate-700 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-orange-500 hover:text-orange-500 hover:shadow-lg"
        >
          Compare Systems
        </a>

      </div>

      <!-- Trust Cards -->

      <div class="mt-12 grid gap-5 sm:grid-cols-3">

        <!-- Card 1 -->

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

          <div class="mb-4 text-4xl">🛡️</div>

          <h3 class="font-bold text-orange-500">
            5-Year
          </h3>

          <p class="mt-2 text-slate-600">
            Workmanship Warranty
          </p>

        </div>

        <!-- Card 2 -->

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

          <div class="mb-4 text-4xl">⭐</div>

          <h3 class="font-bold text-orange-500">
            Premium
          </h3>

          <p class="mt-2 text-slate-600">
            Solar Brands
          </p>

        </div>

        <!-- Card 3 -->

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-lg">

          <div class="mb-4 text-4xl">📍</div>

          <h3 class="font-bold text-orange-500">
            Gauteng
          </h3>

          <p class="mt-2 text-slate-600">
            Residential & Commercial
          </p>

        </div>

      </div>

    </div>

    <!-- RIGHT COLUMN -->

    <div class="relative lg:-translate-y-8">

      <!-- Background Panel -->

      <div class="rounded-[32px] bg-gradient-to-br from-orange-100 to-orange-300 p-8 shadow-2xl">

        <img
          src={heroImage.src}
          alt="Solar installation in Gauteng"
          class="w-full rounded-2xl object-cover"
        />

      </div>

    </div>

  </div>

</section>