---
import type { BlogPost } from "../../data/blog";

interface Props {
    post: BlogPost;
}

const { post } = Astro.props;
---

<article class="blog-card">
    {post.image ? (
        <a href={`/blog/${post.slug}/`} class="blog-card-image-link" aria-label={`Read ${post.title}`}>
            <img src={post.imageUrl ?? post.image} alt={post.imageAlt ?? post.title} class="blog-card-image" loading="lazy" />
        </a>
    ) : (
        <div class="blog-card-image-placeholder" aria-hidden="true">
            <span>Solar8</span>
        </div>
    )}

    <div class="blog-card-body">
        <span class="blog-card-category">{post.category}</span>
        <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
        <p>{post.description}</p>
        <div class="blog-card-meta">
            <span>{post.readingTime}</span>
            <a href={`/blog/${post.slug}/`} aria-label={`Read ${post.title}`}>Read article →</a>
        </div>
    </div>
</article>

<style>
.blog-card{display:flex;flex-direction:column;overflow:hidden;background:#fff;border:1px solid #e7eaf0;border-radius:26px;box-shadow:0 12px 30px rgba(15,23,42,.06);transition:transform .25s ease,box-shadow .25s ease}.blog-card:hover{transform:translateY(-5px);box-shadow:0 18px 38px rgba(15,23,42,.1)}.blog-card-image-link{display:block}.blog-card-image{display:block;width:100%;height:210px;object-fit:cover}.blog-card-image-placeholder{height:210px;display:grid;place-items:center;background:radial-gradient(circle at 70% 30%,rgba(255,104,0,.22),transparent 38%),linear-gradient(135deg,#fff7f0,#eef2f7);color:#ff6800;font-family:Poppins,sans-serif;font-size:30px;font-weight:800}.blog-card-body{padding:28px}.blog-card-category{display:inline-block;color:#ff6800;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.blog-card h3{margin:10px 0 12px;font-family:Poppins,sans-serif;font-size:22px;line-height:1.25;color:#0f172a}.blog-card h3 a{color:inherit;text-decoration:none}.blog-card h3 a:hover{color:#ff6800}.blog-card p{margin:0;color:#64748b;line-height:1.7}.blog-card-meta{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:22px;padding-top:18px;border-top:1px solid #edf0f4;color:#94a3b8;font-size:13px}.blog-card-meta a{color:#ff6800;font-weight:700;text-decoration:none}.blog-card-meta a:hover{text-decoration:underline}
@media(max-width:640px){.blog-card-image,.blog-card-image-placeholder{height:190px}.blog-card-body{padding:24px}.blog-card h3{font-size:20px}}
</style>
