---
import SectionHeading from "../ui/SectionHeading.astro";
import { TrendingUp, ShieldCheck, Briefcase, Clock3, Activity, Handshake } from "lucide-react";
const reasons = [
  { icon: TrendingUp, title: "Engineered for ROI", description: "Every commercial system is designed around your energy profile to maximise long-term return on investment." },
  { icon: ShieldCheck, title: "Premium Tier-1 Equipment", description: "We install globally recognised equipment backed by strong manufacturer warranties and local support." },
  { icon: Briefcase, title: "Professional Project Management", description: "Dedicated project managers coordinate every stage of your installation from planning to commissioning." },
  { icon: Clock3, title: "Minimal Business Disruption", description: "Installation schedules are carefully planned to minimise downtime and keep your operations running." },
  { icon: Activity, title: "Monitoring & Maintenance", description: "Remote monitoring and ongoing maintenance ensure your investment continues performing at its best." },
  { icon: Handshake, title: "Long-Term Partnership", description: "Solar8 provides continued technical support, optimisation and assistance long after installation." }
];
---
<section class="commercial-why-section">
  <div class="solar-container">
    <SectionHeading tag="WHY SOLAR8" title="A commercial solar partner you can trust." intro="From engineering and procurement to installation and ongoing support, Solar8 delivers commercial solar projects that perform exactly as promised." />
    <div class="commercial-kc-grid">
      {reasons.map(({ icon: Icon, title, description }) => (
        <article class="kc-card">
          <div class="kc-icon"><Icon size={32} strokeWidth={2.2}/></div>
          <span class="kc-label">SOLAR8 ADVANTAGE</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
.commercial-why-section{padding:110px 0;background:#FAFAFA}.commercial-kc-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.commercial-why-section .kc-card{min-height:270px}
@media(max-width:900px){.commercial-why-section{padding:80px 0}.commercial-kc-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.commercial-kc-grid{grid-template-columns:1fr}}
</style>
