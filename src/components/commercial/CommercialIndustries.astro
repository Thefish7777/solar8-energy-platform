---
import SectionHeading from "../ui/SectionHeading.astro";
import { Factory, Tractor, ShoppingBag, Warehouse, Building2, GraduationCap } from "lucide-react";

const industries = [
  { icon: Factory, title: "Manufacturing", description: "Reduce operating costs while keeping production running efficiently." },
  { icon: Tractor, title: "Agriculture", description: "Reliable energy for irrigation, packhouses and cold-storage facilities." },
  { icon: ShoppingBag, title: "Retail", description: "Lower electricity costs while protecting trading hours during outages." },
  { icon: Warehouse, title: "Warehousing", description: "Large roof areas make warehouses ideal for high-output solar generation." },
  { icon: Building2, title: "Office Parks", description: "Reduce monthly operating expenses while improving sustainability goals." },
  { icon: GraduationCap, title: "Schools & Healthcare", description: "Reliable electricity for critical daily operations and essential services." }
];
---
<section class="commercial-kc-section">
  <div class="solar-container">
    <SectionHeading tag="INDUSTRIES WE SERVE" title="Solar solutions for every type of business." intro="Every industry has unique energy demands. Solar8 engineers systems tailored to maximise savings while ensuring reliable power." />
    <div class="commercial-kc-grid">
      {industries.map(({ icon: Icon, title, description }) => (
        <article class="kc-card">
          <div class="kc-icon"><Icon size={32} strokeWidth={2.2} /></div>
          <span class="kc-label">COMMERCIAL SOLAR</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
.commercial-kc-section{padding:110px 0;background:#F4F5F7}.commercial-kc-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.commercial-kc-section .kc-card{min-height:260px}
@media(max-width:900px){.commercial-kc-section{padding:80px 0}.commercial-kc-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.commercial-kc-grid{grid-template-columns:1fr}}
</style>
