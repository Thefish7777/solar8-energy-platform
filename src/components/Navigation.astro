---
import logo from "../assets/images/solar8-logo-dark.svg";
import { navigation } from "../data/navigation";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-lg shadow-sm">

  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6">

    <!-- Logo -->

    <a
      href="/"
      aria-label="Solar8 Home"
      class="flex items-center transition duration-300 hover:scale-105"
    >
      <img
        src={logo.src}
        alt="Solar8"
        class="h-12 w-auto"
      />
    </a>

    <!-- Desktop Navigation -->

    <nav
      class="hidden items-center gap-8 lg:flex"
      aria-label="Primary Navigation"
    >

      {
        navigation
          .filter((item) => !item.cta)
          .map((item) => (
            <a
              href={item.href}
              class:list={[
                "relative font-medium transition duration-300",
                currentPath === item.href
                  ? "text-orange-500"
                  : "text-slate-700 hover:text-orange-500",
              ]}
            >
              {item.label}

              <span
                class:list={[
                  "absolute left-0 -bottom-2 h-0.5 bg-orange-500 transition-all duration-300",
                  currentPath === item.href
                    ? "w-full"
                    : "w-0 group-hover:w-full",
                ]}
              />
            </a>
          ))
      }

    </nav>

    <!-- Right Side -->

    <div class="hidden lg:flex items-center">

      <a
        href="/assessment"
        class="inline-flex items-center rounded-xl bg-orange-500 px-6 py-3 font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:bg-orange-600 hover:shadow-xl"
      >
        Get My FREE Assessment
      </a>

    </div>

    <!-- Mobile Button Placeholder -->

    <button
      class="flex h-11 w-11 items-center justify-center rounded-xl border border-slate-300 lg:hidden"
      aria-label="Open navigation menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 text-slate-700"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h16M4 18h16"
        />
      </svg>
    </button>

  </div>

</header>