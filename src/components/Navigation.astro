---
import logo from "../assets/logos/solar8-logo-dark.svg";
import { navigation } from "../data/navigation";

const currentPath = Astro.url.pathname;

const isKnowledgeCentre =
    currentPath === "/knowledge-centre" ||
    currentPath.startsWith("/knowledge-centre/");

const knowledgeNavigation = [
    {
        label: "Solar Basics",
        href: "/knowledge-centre/solar-basics",
    },
    {
        label: "Solar Panels",
        href: "/knowledge-centre/panels",
    },
    {
        label: "Inverters",
        href: "/knowledge-centre/inverters",
    },
    {
        label: "Batteries",
        href: "/knowledge-centre/batteries",
    },
    {
        label: "System Sizing",
        href: "/assessment",
    },
];
---

<header
    id="mainHeader"
    class="fixed left-0 right-0 top-0 z-50"
>

    <!-- ================================================================
         PRIMARY NAVIGATION
    ================================================================ -->

    <div
        id="headerInner"
        class="site-container flex h-20 items-center justify-between transition-all duration-300"
    >

        <!-- Logo -->

        <a
            href="/"
            aria-label="Solar8 Home"
            class="flex shrink-0 items-center"
        >

            <img
                src={logo.src}
                alt="Solar8"
                class="h-12 w-auto"
            />

        </a>


        <!-- ============================================================
             DESKTOP PRIMARY NAVIGATION
        ============================================================ -->

        <nav
            class="hidden items-center gap-4 xl:gap-5 lg:flex"
            aria-label="Primary Navigation"
        >

            {
                navigation
                    .filter((item) => !item.cta)
                    .map((item) => {

                        const isActive =
                            item.href === "/"
                                ? currentPath === "/"
                                : currentPath === item.href ||
                                  currentPath.startsWith(item.href + "/");

                        return (
                            <a
                                href={item.href}
                                class:list={[
                                    "group relative whitespace-nowrap text-[15px] font-semibold tracking-wide transition duration-300",
                                    isActive
                                        ? "text-orange-500"
                                        : "text-slate-700 hover:text-orange-500",
                                ]}
                            >

                                {item.label}

                                <span
                                    class:list={[
                                        "absolute -bottom-2 left-0 h-0.5 bg-orange-500 transition-all duration-300",
                                        isActive
                                            ? "w-full"
                                            : "w-0 group-hover:w-full",
                                    ]}
                                />

                            </a>
                        );

                    })
            }

        </nav>


        <!-- ============================================================
             DESKTOP CTA
        ============================================================ -->

        <div class="hidden shrink-0 items-center lg:flex">

            <a
                href="/assessment/"
                class="inline-flex min-h-[52px] w-[170px] shrink-0 items-center justify-center rounded-xl bg-orange-500 px-4 text-center text-[15px] font-bold leading-[1.15] text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:bg-orange-600 hover:shadow-xl"
            >

                Get My FREE Assessment

            </a>

        </div>


        <!-- ============================================================
             MOBILE MENU BUTTON
        ============================================================ -->

        <button
            id="mobileMenuButton"
            type="button"
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-slate-300 bg-white lg:hidden"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobileMenu"
        >

            <svg
                id="menuIcon"
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-slate-700"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
            >

                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 6h16M4 12h16M4 18h16"
                />

            </svg>

        </button>

    </div>


    <!-- ================================================================
         KNOWLEDGE CENTRE SECONDARY NAVIGATION
    ================================================================ -->

    {
        isKnowledgeCentre && (
            <div
                id="knowledgeSubnav"
                class="hidden border-t border-slate-200 bg-white/95 shadow-sm backdrop-blur-xl lg:block"
            >

                <div class="site-container flex items-center justify-center">

                    <nav
                        class="flex items-center gap-8 py-3"
                        aria-label="Knowledge Centre Navigation"
                    >

                        {
                            knowledgeNavigation.map((item) => {

                                const isActive =
                                    item.href === "/assessment"
                                        ? currentPath === "/assessment"
                                        : currentPath === item.href ||
                                          currentPath.startsWith(item.href + "/");

                                return (
                                    <a
                                        href={item.href}
                                        class:list={[
                                            "relative whitespace-nowrap text-sm font-semibold transition duration-300",
                                            isActive
                                                ? "text-orange-500"
                                                : "text-slate-600 hover:text-orange-500",
                                        ]}
                                    >

                                        {item.label}

                                        <span
                                            class:list={[
                                                "absolute -bottom-1.5 left-0 h-0.5 bg-orange-500 transition-all duration-300",
                                                isActive
                                                    ? "w-full"
                                                    : "w-0",
                                            ]}
                                        />

                                    </a>
                                );

                            })
                        }

                    </nav>

                </div>

            </div>
        )
    }


    <!-- ================================================================
         MOBILE NAVIGATION
    ================================================================ -->

    <div
        id="mobileMenu"
        class="absolute left-4 right-4 top-full mt-3 hidden max-h-[80vh] overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4 shadow-2xl lg:hidden"
    >

        <nav
            class="flex flex-col gap-1"
            aria-label="Mobile Navigation"
        >

            {
                navigation.map((item) => {

                    const isActive =
                        item.href === "/"
                            ? currentPath === "/"
                            : currentPath === item.href ||
                              currentPath.startsWith(item.href + "/");

                    return (
                        <a
                            href={item.href}
                            class:list={[
                                "mobile-nav-link block rounded-xl px-4 py-3 font-semibold transition",
                                item.cta
                                    ? "bg-orange-500 text-white hover:bg-orange-600 hover:text-white"
                                    : isActive
                                        ? "bg-orange-50 text-orange-500"
                                        : "text-slate-700 hover:bg-slate-50 hover:text-orange-500",
                            ]}
                        >

                            {item.label}

                        </a>
                    );

                })
            }


            <!-- ========================================================
                 MOBILE KNOWLEDGE CENTRE SUBMENU
            ======================================================== -->

            {
                isKnowledgeCentre && (
                    <div class="mt-3 border-t border-slate-200 pt-3">

                        <div class="px-4 pb-2 text-xs font-bold uppercase tracking-widest text-orange-500">
                            Knowledge Centre
                        </div>

                        {
                            knowledgeNavigation.map((item) => {

                                const isActive =
                                    item.href === "/assessment"
                                        ? currentPath === "/assessment"
                                        : currentPath === item.href ||
                                          currentPath.startsWith(item.href + "/");

                                return (
                                    <a
                                        href={item.href}
                                        class:list={[
                                            "mobile-nav-link block rounded-xl px-4 py-3 text-sm font-semibold transition",
                                            isActive
                                                ? "bg-orange-50 text-orange-500"
                                                : "text-slate-600 hover:bg-slate-50 hover:text-orange-500",
                                        ]}
                                    >

                                        {item.label}

                                    </a>
                                );

                            })
                        }

                    </div>
                )
            }

        </nav>

    </div>

</header>


<script>

    const inner =
        document.getElementById("headerInner");

    const mobileButton =
        document.getElementById("mobileMenuButton");

    const mobileMenu =
        document.getElementById("mobileMenu");


    /* ================================================================
       HEADER SCROLL STATE
    ================================================================ */

    function updateHeader() {

        if (!inner) return;


        if (window.scrollY > 40) {

            inner.classList.add(
                "bg-white/95",
                "backdrop-blur-xl",
                "shadow-lg",
                "border",
                "border-slate-200"
            );

        } else {

            inner.classList.remove(
                "bg-white/95",
                "backdrop-blur-xl",
                "shadow-lg",
                "border",
                "border-slate-200"
            );

        }

    }


    /* ================================================================
       MOBILE MENU
    ================================================================ */

    function closeMobileMenu() {

        if (!mobileMenu || !mobileButton) return;


        mobileMenu.classList.add("hidden");


        mobileButton.setAttribute(
            "aria-expanded",
            "false"
        );


        mobileButton.setAttribute(
            "aria-label",
            "Open navigation menu"
        );

    }


    if (mobileButton && mobileMenu) {

        mobileButton.addEventListener(
            "click",
            (event) => {

                event.stopPropagation();


                const isOpen =
                    mobileButton.getAttribute(
                        "aria-expanded"
                    ) === "true";


                if (isOpen) {

                    closeMobileMenu();

                } else {

                    mobileMenu.classList.remove(
                        "hidden"
                    );


                    mobileButton.setAttribute(
                        "aria-expanded",
                        "true"
                    );


                    mobileButton.setAttribute(
                        "aria-label",
                        "Close navigation menu"
                    );

                }

            }
        );


        mobileMenu
            .querySelectorAll(
                ".mobile-nav-link"
            )
            .forEach((link) => {

                link.addEventListener(
                    "click",
                    closeMobileMenu
                );

            });


        document.addEventListener(
            "click",
            (event) => {

                const target =
                    event.target;


                if (!(target instanceof Node)) {
                    return;
                }


                if (
                    !mobileMenu.contains(target) &&
                    !mobileButton.contains(target)
                ) {

                    closeMobileMenu();

                }

            }
        );


        document.addEventListener(
            "keydown",
            (event) => {

                if (event.key === "Escape") {

                    closeMobileMenu();

                }

            }
        );

    }


    /* ================================================================
       EVENTS
    ================================================================ */

    window.addEventListener(
        "scroll",
        updateHeader
    );


    updateHeader();

</script>