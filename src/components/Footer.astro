---
import logo from "../assets/logos/solar8-logo-light.svg";
import { company } from "../data/company";
---
<footer class="solar-footer">
  <div class="container solar-footer-inner">
    <div class="solar-footer-grid">
      <div>
        <img src={logo.src} alt="Solar8" class="solar-footer-logo" />
        <p class="solar-footer-copy">Premium residential and commercial solar solutions, battery backup systems and hybrid inverter installations designed for long-term energy independence.</p>
        <div class="solar-footer-socials">
          <a href={company.social.facebook} target="_blank" rel="noreferrer" aria-label="Facebook" class="solar-social">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.6 1.7-1.6h1.7V3.8c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.5v3h2.7v8h3.3Z"/></svg>
          </a>
          <a href={company.social.instagram} target="_blank" rel="noreferrer" aria-label="Instagram" class="solar-social">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.4" cy="6.7" r="1.1" fill="currentColor"/></svg>
          </a>
          <a href={company.social.x} target="_blank" rel="noreferrer" aria-label="X" class="solar-social">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 4h4.2l4.1 5.4L16.9 4H20l-6.2 7.1L20.5 20h-4.2l-4.7-6.1L6.3 20H3.2l6.4-7.7L4 4Zm4.7 1.8H7l9.1 12.4h1.8L8.7 5.8Z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@solar8_sa" target="_blank" rel="noreferrer" aria-label="TikTok" class="solar-social">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 4h2.7c.2 1.7 1.2 3 2.9 3.7v2.8c-1.1-.1-2.1-.5-2.9-1.1v5.1c0 3.5-2.2 5.5-5.4 5.5-2.8 0-5.1-1.9-5.1-4.7 0-3 2.5-5.1 5.8-4.8v2.8c-1.5-.2-2.8.5-2.8 2 0 1.1.9 2 2.1 2 1.4 0 2.7-.8 2.7-3V4Z"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="solar-footer-heading">Solutions</h3>
        <ul class="solar-footer-links">
          <li><a href="/residential/">Residential Solar</a></li>
          <li><a href="/commercial/">Commercial Solar</a></li>
          <li><a href="/assessment/">Free Solar Assessment</a></li>
          <li><a href="/contact/">Contact Solar8</a></li>
        </ul>
      </div>

      <div>
        <h3 class="solar-footer-heading">Company</h3>
        <ul class="solar-footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/about/">About Solar8</a></li>
          <li><a href="/faq/">FAQ</a></li>
        </ul>
      </div>

      <div>
        <h3 class="solar-footer-heading">Contact</h3>
        <div class="solar-footer-contact">
          <a href={company.phoneHref}><strong>Phone</strong><span>{company.phone}</span></a>
          <a href={company.whatsappHref} target="_blank" rel="noreferrer"><strong>WhatsApp</strong><span>{company.whatsapp}</span></a>
          <a href={company.emailHref}><strong>Email</strong><span>{company.email}</span></a>
          <div><strong>Office</strong><span>Lyttelton Manor<br/>Centurion<br/>Gauteng</span></div>
          <div><strong>Office Hours</strong><span>Monday – Friday<br/>08:30 – 17:30</span></div>
        </div>
      </div>
    </div>
  </div>
  <div class="solar-footer-bottom"><div class="container"><span>{company.copyright}</span><span>Quality Today. Peace of Mind Tomorrow.</span></div></div>
</footer>
<style>
.solar-footer{background:#0B1220;color:#AEB8C5}.solar-footer-inner{padding:76px 0}.solar-footer-grid{display:grid;grid-template-columns:1.35fr .8fr .8fr 1fr;gap:56px}.solar-footer-logo{height:56px;width:auto}.solar-footer-copy{max-width:390px;margin-top:22px;color:#AEB8C5;line-height:1.75}.solar-footer-socials{display:flex;gap:12px;margin-top:26px}.solar-social{display:flex;align-items:center;justify-content:center;width:42px;height:42px;border:1px solid #334155;border-radius:50%;color:#D8E0EA;transition:.25s ease}.solar-social:hover{border-color:#FF6800;background:#FF6800;color:#fff}.solar-social svg{width:19px;height:19px}.solar-footer-heading{margin:0;color:#DDE6F0;font-family:Poppins,sans-serif;font-size:18px;font-weight:700}.solar-footer-links{display:grid;gap:13px;margin:20px 0 0;padding:0;list-style:none}.solar-footer-links a{color:#AEB8C5;transition:.25s ease}.solar-footer-links a:hover{color:#FF6800}.solar-footer-contact{display:grid;gap:15px;margin-top:20px}.solar-footer-contact a,.solar-footer-contact div{display:grid;gap:2px;color:#AEB8C5;line-height:1.5}.solar-footer-contact a:hover span{color:#FF6800}.solar-footer-contact strong{color:#DDE6F0}.solar-footer-bottom{border-top:1px solid #1E293B}.solar-footer-bottom .container{display:flex;justify-content:space-between;gap:20px;padding:22px 0;color:#748195;font-size:13px}
@media(max-width:900px){.solar-footer-grid{grid-template-columns:1fr 1fr;gap:42px}.solar-footer-inner{padding:60px 0}}@media(max-width:640px){.solar-footer-grid{grid-template-columns:1fr}.solar-footer-inner{padding:54px 0}.solar-footer-bottom .container{flex-direction:column;text-align:center;align-items:center;padding:20px 16px}}
</style>
