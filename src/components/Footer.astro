---
import logo from "../assets/logos/solar8-logo-light.svg";
---

<footer class="bg-slate-950 text-slate-300">

    <div class="container py-20">

        <div class="grid gap-14 lg:grid-cols-4">

            <!-- Brand -->

            <div>

                <img
                    src={logo.src}
                    alt="Solar8"
                    class="h-14 w-auto"
                />

                <p class="mt-6 leading-8 text-slate-400">

                    Premium residential and commercial solar solutions,
                    battery backup systems and hybrid inverter installations
                    designed for long-term energy independence.

                </p>

                <div class="mt-8 flex gap-4">

                    <a
                        href="https://www.facebook.com/Solar8.SA"
                        target="_blank"
                        class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-700 transition hover:border-orange-500 hover:bg-orange-500 hover:text-white"
                        aria-label="Facebook"
                    >
                        FB
                    </a>

                    <a
                        href="https://www.instagram.com/solar8_sa/"
                        target="_blank"
                        class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-700 transition hover:border-orange-500 hover:bg-orange-500 hover:text-white"
                        aria-label="Instagram"
                    >
                        IG
                    </a>

                    <a
                        href="https://x.com/Solar8_SA"
                        target="_blank"
                        class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-700 transition hover:border-orange-500 hover:bg-orange-500 hover:text-white"
                        aria-label="X"
                    >
                        X
                    </a>

                    <a
                        href="https://www.tiktok.com/@solar8_sa"
                        target="_blank"
                        class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-700 transition hover:border-orange-500 hover:bg-orange-500 hover:text-white"
                        aria-label="TikTok"
                    >
                        TT
                    </a>

                </div>

            </div>

            <!-- Solutions -->

            <div>

                <h3 class="text-xl font-bold text-white">

                    Solutions

                </h3>

                <ul class="mt-6 space-y-4">

                    <li><a href="/residential" class="transition hover:text-orange-400">Residential Solar</a></li>

                    <li><a href="/commercial" class="transition hover:text-orange-400">Commercial Solar</a></li>

                    <li><a href="/assessment" class="transition hover:text-orange-400">Free Solar Assessment</a></li>

                    <li><a href="/contact" class="transition hover:text-orange-400">Contact Solar8</a></li>

                </ul>

            </div>

            <!-- Company -->

            <div>

                <h3 class="text-xl font-bold text-white">

                    Company

                </h3>

                <ul class="mt-6 space-y-4">

                    <li><a href="/" class="transition hover:text-orange-400">Home</a></li>

                    <li><a href="/about" class="transition hover:text-orange-400">About Solar8</a></li>

                    <li><a href="/faq" class="transition hover:text-orange-400">FAQ</a></li>

                    <li><a href="/privacy" class="transition hover:text-orange-400">Privacy Policy</a></li>

                </ul>

            </div>

            <!-- Contact -->

            <div>

                <h3 class="text-xl font-bold text-white">

                    Contact

                </h3>

                <div class="mt-6 space-y-5 text-slate-400 leading-7">

                    <div>

                        <strong class="text-white">

                            Phone

                        </strong>

                        <br>

                        012 004 3488

                    </div>

                    <div>

                        <strong class="text-white">

                            WhatsApp

                        </strong>

                        <br>

                        081 339 3346

                    </div>

                    <div>

                        <strong class="text-white">

                            Email

                        </strong>

                        <br>

                        info@solar8.co.za

                    </div>

                    <div>

                        <strong class="text-white">

                            Office

                        </strong>

                        <br>

                        Lyttelton Manor<br>
                        Centurion<br>
                        Gauteng

                    </div>

                    <div>

                        <strong class="text-white">

                            Office Hours

                        </strong>

                        <br>

                        Monday – Friday<br>

                        08:30 – 17:30

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="border-t border-slate-800">

        <div class="container flex flex-col items-center justify-between gap-3 py-6 text-sm text-slate-500 md:flex-row">

            <p>

                © 2026 Solar8 (Pty) Ltd. All Rights Reserved.

            </p>

            <p>

                Quality Today. Peace of Mind Tomorrow.

            </p>

        </div>

    </div>

</footer>