<script>
    /*
     * Explicitly type the monthly bill element as an HTMLInputElement.
     * document.getElementById() normally returns HTMLElement, which does
     * not expose the .value property.
     */
    const monthlyBillInput =
        document.getElementById("monthlyBill") as HTMLInputElement | null;

    const annualBillOutput =
        document.getElementById("annualBill");

    const annualSavingOutput =
        document.getElementById("annualSaving");

    const monthlySavingOutput =
        document.getElementById("monthlySaving");


    function formatCurrency(value: number) {
        return new Intl.NumberFormat("en-ZA", {
            style: "currency",
            currency: "ZAR",
            maximumFractionDigits: 0
        }).format(value);
    }


    function updateCalculator() {

        if (!monthlyBillInput) return;

        const monthlyBill =
            Number(monthlyBillInput.value) || 0;

        const annualBill =
            monthlyBill * 12;

        const annualSaving =
            annualBill * 0.50;

        const monthlySaving =
            annualSaving / 12;


        if (annualBillOutput) {
            annualBillOutput.textContent =
                formatCurrency(annualBill);
        }

        if (annualSavingOutput) {
            annualSavingOutput.textContent =
                formatCurrency(annualSaving);
        }

        if (monthlySavingOutput) {
            monthlySavingOutput.textContent =
                formatCurrency(monthlySaving);
        }
    }


    monthlyBillInput?.addEventListener(
        "input",
        updateCalculator
    );

    updateCalculator();
</script>

