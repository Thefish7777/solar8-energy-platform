---
import home1 from "../../assets/images/residential-home.jpg";
import hero from "../../assets/images/hero-solar-installation.jpg";
import commercial from "../../assets/images/commercial-solar.jpg";
---

<section class="gallery">

    <div class="container">

        <p class="section-tag">
            RECENT INSTALLATIONS
        </p>

        <h2 class="section-title">
            Beautiful installations.
            Professionally engineered.
        </h2>

        <p class="section-intro">
            Every Solar8 installation is designed to blend beautifully with your property while delivering outstanding long-term performance.
        </p>

        <div class="gallery-grid">

            <figure class="gallery-large">

                <img src={home1.src} alt="Residential Solar Installation" />

                <figcaption>

                    Residential Hybrid Installation

                </figcaption>

            </figure>

            <figure>

                <img src={hero.src} alt="Solar Panels" />

                <figcaption>

                    Premium Roof Installation

                </figcaption>

            </figure>

            <figure>

                <img src={commercial.src} alt="Battery System" />

                <figcaption>

                    Battery & Inverter Room

                </figcaption>

            </figure>

        </div>

    </div>

</section>