---
import home1 from "../../assets/images/residential-home.jpg";
import hero from "../../assets/images/hero-solar-installation.jpg";
import commercial from "../../assets/images/commercial-solar.jpg";
---

<section class="residential-gallery">
    <div class="gallery-container">
        <div class="section-heading centered">
            <span class="eyebrow">RECENT INSTALLATIONS</span>
            <h2>Beautiful installations. Professionally engineered.</h2>
            <p>
                Every Solar8 installation is designed to blend beautifully with your
                property while delivering outstanding long-term performance.
            </p>
        </div>

        <div class="gallery-grid">
            <figure class="gallery-card gallery-card-main">
                <img src={home1.src} alt="Residential hybrid solar installation" loading="lazy" />
                <figcaption>
                    <span>Residential</span>
                    <strong>Hybrid Solar Installation</strong>
                </figcaption>
            </figure>

            <figure class="gallery-card gallery-card-small">
                <img src={hero.src} alt="Premium solar panel roof installation" loading="lazy" />
                <figcaption>
                    <span>Solar Generation</span>
                    <strong>Premium Roof Installation</strong>
                </figcaption>
            </figure>

            <figure class="gallery-card gallery-card-small">
                <img src={commercial.src} alt="Solar battery and inverter installation" loading="lazy" />
                <figcaption>
                    <span>Energy Storage</span>
                    <strong>Battery &amp; Inverter System</strong>
                </figcaption>
            </figure>
        </div>
    </div>
</section>

<style>
.residential-gallery {
    background: var(--color-white);
    padding: var(--section-padding) 0;
}

.gallery-container {
    width: min(var(--container-width), calc(100% - 48px));
    margin-inline: auto;
}

.section-heading {
    max-width: 760px;
    margin-bottom: 60px;
}

.section-heading.centered {
    margin-inline: auto;
    text-align: center;
}

.section-heading h2 {
    margin: 16px 0 0;
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: clamp(2.3rem, 4vw, 3.3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
}

.section-heading p {
    max-width: 720px;
    margin: 20px auto 0;
    color: var(--color-muted);
    font-size: 18px;
    line-height: 1.7;
}

.gallery-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(260px, 1fr));
    gap: 32px;
}

.gallery-card {
    position: relative;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border-radius: var(--image-radius);
    background: var(--color-light);
    box-shadow: var(--shadow-medium);
}

.gallery-card-main {
    grid-row: 1 / span 2;
    min-height: 560px;
}

.gallery-card-small {
    min-height: 264px;
}

.gallery-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
}

.gallery-card:hover img {
    transform: scale(1.04);
}

.gallery-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(17, 24, 39, 0.82) 100%);
    pointer-events: none;
}

.gallery-card figcaption {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 32px;
    color: var(--color-white);
}

.gallery-card figcaption span {
    color: #FFB27D;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.gallery-card figcaption strong {
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.2;
}

@media (max-width: 1023px) {
    .residential-gallery {
        padding: var(--section-padding-small) 0;
    }

    .gallery-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: auto;
    }

    .gallery-card-main {
        grid-row: auto;
        grid-column: 1 / -1;
        min-height: 460px;
    }

    .gallery-card-small {
        min-height: 300px;
    }
}

@media (max-width: 640px) {
    .gallery-container {
        width: min(var(--container-width), calc(100% - 32px));
    }

    .section-heading {
        margin-bottom: 40px;
    }

    .section-heading h2 {
        font-size: 2.25rem;
    }

    .section-heading p {
        font-size: 16px;
    }

    .gallery-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .gallery-card-main,
    .gallery-card-small {
        grid-column: auto;
        min-height: 300px;
    }

    .gallery-card-main {
        min-height: 380px;
    }

    .gallery-card figcaption {
        padding: 24px;
    }
}
</style>
