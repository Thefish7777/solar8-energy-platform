---
const steps = [
    {
        number: "01",
        title: "Understand Your Energy",
        description:
            "We look at your electricity usage, appliances, household requirements and backup priorities.",
    },
    {
        number: "02",
        title: "Design Your System",
        description:
            "Your solar, inverter and battery system is designed around your property rather than a standard package.",
    },
    {
        number: "03",
        title: "Professional Installation",
        description:
            "Your system is installed by qualified professionals with attention to safety, quality and compliance.",
    },
    {
        number: "04",
        title: "Monitoring & Commissioning",
        description:
            "Your system is tested, commissioned and connected to live monitoring so its performance can be tracked.",
    },
    {
        number: "05",
        title: "Lifetime Support",
        description:
            "We remain available to help you understand, maintain and get the most from your solar investment.",
    },
];
---

<section class="residential-journey">
    <div class="container">

        <div class="section-heading centered residential-journey-heading">
            <span class="eyebrow">THE SOLAR8 JOURNEY</span>

            <h2>
                From your first question to years of reliable energy.
            </h2>

            <p>
                Going solar should feel straightforward. We guide you through
                each stage so you understand what is happening and why.
            </p>
        </div>

        <div class="journey-wrapper">

            <div class="journey-line" aria-hidden="true"></div>

            <div class="journey-list">
                {
                    steps.map((step) => (
                        <article class="journey-step">

                            <div class="journey-marker">
                                <span>{step.number}</span>
                            </div>

                            <div class="journey-content">
                                <div class="journey-step-label">
                                    STEP {step.number}
                                </div>

                                <h3>{step.title}</h3>

                                <p>{step.description}</p>
                            </div>

                        </article>
                    ))
                }
            </div>

        </div>

        <div class="journey-bottom">
            <div class="journey-bottom-icon" aria-hidden="true">
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M12 3v18" />
                    <path d="m5 10 7-7 7 7" />
                </svg>
            </div>

            <div>
                <h3>Better decisions start with better information.</h3>
                <p>
                    Start with a Smart Solar Assessment and discover what
                    your home actually needs.
                </p>
            </div>

            <a href="/assessment/" class="journey-button">
                Start My Assessment
                <span aria-hidden="true">→</span>
            </a>
        </div>

    </div>
</section>

<style>
.residential-journey {
    width: 100%;
    padding: 120px 0;
    background: var(--color-white);
}

.residential-journey-heading {
    max-width: 820px;
    margin-bottom: 72px;
}

.residential-journey-heading h2 {
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: clamp(2.35rem, 4vw, 3.3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
}

.residential-journey-heading p {
    max-width: 720px;
}

.journey-wrapper {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
}

.journey-line {
    position: absolute;
    top: 30px;
    bottom: 30px;
    left: 31px;
    width: 2px;
    background: linear-gradient(
        to bottom,
        rgba(255, 104, 0, 0.12),
        rgba(255, 104, 0, 0.55),
        rgba(255, 104, 0, 0.12)
    );
}

.journey-list {
    display: flex;
    flex-direction: column;
    gap: 0;
}

.journey-step {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 32px;
    min-height: 150px;
}

.journey-marker {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border: 1px solid rgba(255, 104, 0, 0.25);
    border-radius: 20px;
    background: var(--color-white);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
}

.journey-marker span {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 800;
}

.journey-content {
    padding: 4px 0 46px;
}

.journey-step-label {
    margin-bottom: 8px;
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
}

.journey-content h3 {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
}

.journey-content p {
    max-width: 680px;
    margin-top: 10px;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.75;
}

.journey-step:last-child .journey-content {
    padding-bottom: 8px;
}

.journey-bottom {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    max-width: 980px;
    margin: 58px auto 0;
    padding: 30px 34px;
    border: 1px solid rgba(255, 104, 0, 0.18);
    border-radius: var(--radius-large);
    background: #fff8f4;
}

.journey-bottom-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: var(--color-primary);
    color: var(--color-white);
}

.journey-bottom-icon svg {
    width: 28px;
    height: 28px;
}

.journey-bottom h3 {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.3;
}

.journey-bottom p {
    margin-top: 5px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
}

.journey-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px;
    border-radius: var(--button-radius);
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 14px;
    font-weight: 800;
    white-space: nowrap;
    transition:
        background 0.25s ease,
        transform 0.25s ease;
}

.journey-button span {
    font-size: 19px;
    line-height: 1;
}

.journey-button:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
}

@media (max-width: 900px) {
    .residential-journey {
        padding: 88px 0;
    }

    .residential-journey-heading {
        margin-bottom: 56px;
    }

    .journey-bottom {
        grid-template-columns: auto minmax(0, 1fr);
    }

    .journey-button {
        grid-column: 2;
        justify-self: start;
    }
}

@media (max-width: 640px) {
    .residential-journey {
        padding: 72px 0;
    }

    .residential-journey-heading {
        margin-bottom: 44px;
    }

    .residential-journey-heading h2 {
        font-size: 2.2rem;
    }

    .journey-wrapper {
        margin-left: 0;
    }

    .journey-line {
        top: 24px;
        bottom: 24px;
        left: 24px;
    }

    .journey-step {
        grid-template-columns: 48px minmax(0, 1fr);
        gap: 20px;
        min-height: 145px;
    }

    .journey-marker {
        width: 48px;
        height: 48px;
        border-radius: 15px;
    }

    .journey-marker span {
        font-size: 12px;
    }

    .journey-content {
        padding-bottom: 38px;
    }

    .journey-content h3 {
        font-size: 20px;
    }

    .journey-content p {
        font-size: 15px;
        line-height: 1.7;
    }

    .journey-bottom {
        grid-template-columns: 1fr;
        gap: 18px;
        margin-top: 42px;
        padding: 26px 22px;
        border-radius: 20px;
    }

    .journey-bottom-icon {
        width: 54px;
        height: 54px;
    }

    .journey-button {
        grid-column: auto;
        width: 100%;
    }
}
</style>