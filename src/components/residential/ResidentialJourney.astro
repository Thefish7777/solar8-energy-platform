---
import SectionHeading from "../ui/SectionHeading.astro";
import {
    ClipboardCheck,
    DraftingCompass,
    Wrench,
    Smartphone,
    Headset
} from "lucide-react";

const steps = [
    {
        icon: ClipboardCheck,
        title: "Free Assessment",
        description:
            "We evaluate your electricity usage, property and long-term energy goals."
    },
    {
        icon: DraftingCompass,
        title: "Custom System Design",
        description:
            "Our engineers design a solar solution tailored specifically for your home."
    },
    {
        icon: Wrench,
        title: "Professional Installation",
        description:
            "Qualified installation teams complete your project safely and to SANS standards."
    },
    {
        icon: Smartphone,
        title: "Monitoring & Commissioning",
        description:
            "Your system is tested, commissioned and connected to live monitoring."
    },
    {
        icon: Headset,
        title: "Lifetime Support",
        description:
            "Enjoy ongoing technical support, warranty assistance and expert advice whenever you need it."
    }
];
---

<section class="bg-slate-50 py-24">

    <div class="container">

        <SectionHeading
            tag="OUR PROCESS"
            title="From consultation to clean energy."
            intro="Every Solar8 installation follows a structured process that ensures your solar system is professionally designed, expertly installed and supported for years to come."
        />

        <div class="mt-20 grid gap-8 lg:grid-cols-5">

            {
                steps.map(({ icon: Icon, title, description }, index) => (

                    <div class="relative">

                        <div class="group rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-2 hover:border-orange-200 hover:shadow-xl">

                            <div class="mx-auto mb-8 flex h-16 w-16 items-center justify-center rounded-2xl bg-orange-100 text-orange-500 transition duration-300 group-hover:bg-orange-500 group-hover:text-white">

                                <Icon size={34} strokeWidth={2.2} />

                            </div>

                            <div class="mb-4 text-sm font-bold tracking-widest text-orange-500">

                                STEP {String(index + 1).padStart(2, "0")}

                            </div>

                            <h3 class="mb-4 text-2xl font-bold text-slate-900">

                                {title}

                            </h3>

                            <p class="leading-8 text-slate-600">

                                {description}

                            </p>

                        </div>

                        {
                            index < steps.length - 1 && (

                                <div class="absolute top-1/2 left-full hidden w-8 -translate-y-1/2 xl:block">

                                    <svg
                                        class="text-orange-300"
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >

                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M5 12h14m-5-5l5 5-5 5"
                                        />

                                    </svg>

                                </div>

                            )
                        }

                    </div>

                ))
            }

        </div>

    </div>

</section>