---
const testimonials = [
    {
        quote: "The installation was neat, professional and exactly as promised. Load shedding is no longer a concern.",
        name: "Residential Client",
        role: "Homeowner",
    },
    {
        quote: "Solar8 explained everything clearly before installation. The savings have exceeded our expectations.",
        name: "Homeowner",
        role: "Residential Solar System",
    },
    {
        quote: "Excellent workmanship, clean installation and fantastic after-sales support. We would happily recommend Solar8.",
        name: "Gauteng Client",
        role: "Residential Installation",
    },
];
---

<section class="residential-testimonials">
    <div class="testimonials-container">
        <div class="section-heading centered">
            <span class="eyebrow">CLIENT FEEDBACK</span>
            <h2>Trusted by homeowners across Gauteng.</h2>
            <p>
                Our customers choose Solar8 because they value honest advice, quality
                workmanship and long-term support long after the installation is complete.
            </p>
        </div>

        <div class="testimonial-grid">
            {testimonials.map((testimonial) => (
                <article class="testimonial-card">
                    <div class="stars" aria-label="5 out of 5 stars">
                        {Array.from({ length: 5 }).map(() => (
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 2.8l2.84 5.76 6.36.92-4.6 4.48 1.09 6.33L12 17.3l-5.69 2.99 1.09-6.33-4.6-4.48 6.36-.92L12 2.8z" />
                            </svg>
                        ))}
                    </div>

                    <p class="testimonial-quote">“{testimonial.quote}”</p>

                    <div class="testimonial-client">
                        <div class="client-avatar" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="8" r="3.2" />
                                <path d="M5.5 20c.8-3.1 3.1-4.8 6.5-4.8s5.7 1.7 6.5 4.8" />
                            </svg>
                        </div>
                        <div>
                            <h3>{testimonial.name}</h3>
                            <span>{testimonial.role}</span>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

<style>
.residential-testimonials {
    background: var(--color-light);
    padding: var(--section-padding) 0;
}

.testimonials-container {
    width: min(var(--container-width), calc(100% - 48px));
    margin-inline: auto;
}

.section-heading {
    max-width: 760px;
    margin-bottom: 60px;
}

.section-heading.centered {
    margin-inline: auto;
    text-align: center;
}

.section-heading h2 {
    margin: 16px 0 0;
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: clamp(2.3rem, 4vw, 3.3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
}

.section-heading p {
    max-width: 720px;
    margin: 20px auto 0;
    color: var(--color-muted);
    font-size: 18px;
    line-height: 1.7;
}

.testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
}

.testimonial-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 100%;
    padding: 36px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background: var(--color-white);
    box-shadow: var(--shadow-light);
    transition: var(--transition);
}

.testimonial-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 104, 0, 0.28);
    box-shadow: var(--shadow-medium);
}

.stars {
    display: flex;
    gap: 4px;
    margin-bottom: 24px;
}

.stars svg {
    width: 19px;
    height: 19px;
    fill: var(--color-primary);
    stroke: var(--color-primary);
    stroke-width: 1.5;
}

.testimonial-quote {
    margin: 0;
    color: var(--color-text);
    font-size: 17px;
    line-height: 1.8;
}

.testimonial-client {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 28px;
    border-top: 1px solid var(--color-border-light);
}

.client-avatar {
    display: grid;
    flex: 0 0 46px;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 50%;
    background: #FFF1E8;
    color: var(--color-primary);
}

.client-avatar svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.testimonial-client h3 {
    margin: 0;
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-size: 16px;
    line-height: 1.3;
}

.testimonial-client span {
    display: block;
    margin-top: 4px;
    color: var(--color-muted);
    font-size: 13px;
}

@media (max-width: 1023px) {
    .residential-testimonials {
        padding: var(--section-padding-small) 0;
    }

    .testimonial-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 640px) {
    .testimonials-container {
        width: min(var(--container-width), calc(100% - 32px));
    }

    .section-heading {
        margin-bottom: 40px;
    }

    .section-heading h2 {
        font-size: 2.25rem;
    }

    .section-heading p {
        font-size: 16px;
    }

    .testimonial-grid {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .testimonial-card {
        padding: 28px 24px;
    }
}
</style>
