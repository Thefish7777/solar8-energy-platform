---
import {
  Phone,
  Mail,
  MapPin,
  CheckCircle
} from "lucide-astro";
---

<section id="contact" class="bg-slate-900 py-24 text-white">

  <div class="mx-auto max-w-7xl px-6">

    <div class="grid items-start gap-16 lg:grid-cols-2">

      <!-- LEFT COLUMN -->

      <div>

        <span class="rounded-full bg-orange-500 px-5 py-2 text-sm font-semibold">
          FREE Solar Assessment
        </span>

        <h2 class="mt-8 text-5xl font-bold leading-tight">
          Let's Find the Right Solar Solution for Your Property
        </h2>

        <p class="mt-8 text-xl leading-8 text-slate-300">
          Whether you're looking to reduce your monthly electricity costs,
          install backup power or invest in a complete solar solution,
          our experienced team is ready to help.
        </p>

        <!-- Contact Information -->

        <div class="mt-12 space-y-8">

          <!-- Phone -->

          <div class="flex items-start gap-4">

            <div class="rounded-xl bg-orange-500/20 p-3 text-orange-400">
              <Phone size={24} />
            </div>

            <div>

              <h3 class="font-semibold text-white">
                Phone
              </h3>

              <a
                href="tel:+27120043488"
                class="mt-1 inline-block text-slate-300 transition hover:text-orange-400"
              >
                012 004 3488
              </a>

            </div>

          </div>

          <!-- Email -->

          <div class="flex items-start gap-4">

            <div class="rounded-xl bg-orange-500/20 p-3 text-orange-400">
              <Mail size={24} />
            </div>

            <div>

              <h3 class="font-semibold text-white">
                Email
              </h3>

              <a
                href="mailto:info@solar8.co.za"
                class="mt-1 inline-block text-slate-300 transition hover:text-orange-400"
              >
                info@solar8.co.za
              </a>

            </div>

          </div>

          <!-- Service Area -->

          <div class="flex items-start gap-4">

            <div class="rounded-xl bg-orange-500/20 p-3 text-orange-400">
              <MapPin size={24} />
            </div>

            <div>

              <h3 class="font-semibold text-white">
                Service Area
              </h3>

              <p class="mt-1 text-slate-300">
                Pretoria • Centurion • Midrand • Johannesburg • Gauteng
              </p>

            </div>

          </div>

        </div>

        <!-- What You'll Receive -->

        <div class="mt-12 rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm">

          <h3 class="text-2xl font-bold text-white">
            What You'll Receive
          </h3>

          <p class="mt-3 text-slate-300">
            Every assessment is tailored to your property and electricity usage.
            We'll help you understand your options before you make any decisions.
          </p>

          <div class="mt-8 space-y-6">

            <div class="flex items-start gap-4">

              <div class="rounded-full bg-orange-500/20 p-2 text-orange-400">
                <CheckCircle size={20}/>
              </div>

              <div>

                <h4 class="font-semibold text-white">
                  Personalised System Recommendation
                </h4>

                <p class="text-slate-400">
                  Based on your electricity usage and future plans.
                </p>

              </div>

            </div>

            <div class="flex items-start gap-4">

              <div class="rounded-full bg-orange-500/20 p-2 text-orange-400">
                <CheckCircle size={20}/>
              </div>

              <div>

                <h4 class="font-semibold text-white">
                  Estimated Electricity Savings
                </h4>

                <p class="text-slate-400">
                  Understand how much you could reduce your electricity costs.
                </p>

              </div>

            </div>

            <div class="flex items-start gap-4">

              <div class="rounded-full bg-orange-500/20 p-2 text-orange-400">
                <CheckCircle size={20}/>
              </div>

              <div>

                <h4 class="font-semibold text-white">
                  Transparent Quotation
                </h4>

                <p class="text-slate-400">
                  Clear pricing with no hidden costs or surprises.
                </p>

              </div>

            </div>

            <div class="flex items-start gap-4">

              <div class="rounded-full bg-orange-500/20 p-2 text-orange-400">
                <CheckCircle size={20}/>
              </div>

              <div>

                <h4 class="font-semibold text-white">
                  No Obligation
                </h4>

                <p class="text-slate-400">
                  Take your time before making any decision.
                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

      <!-- RIGHT COLUMN -->

      <div class="rounded-3xl bg-white p-10 text-slate-900 shadow-2xl">

        <h3 class="text-3xl font-bold">
          Request Your FREE Solar Assessment
        </h3>

        <p class="mt-3 text-slate-600">
          Complete the form below and one of our consultants will contact you to
          discuss the best solution for your home or business.
        </p>

        <form class="mt-8 space-y-6">

          <input
            type="text"
            placeholder="Full Name"
            class="w-full rounded-xl border border-slate-300 px-5 py-4 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-200"
          />

          <input
            type="email"
            placeholder="Email Address"
            class="w-full rounded-xl border border-slate-300 px-5 py-4 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-200"
          />

          <input
            type="tel"
            placeholder="Phone Number"
            class="w-full rounded-xl border border-slate-300 px-5 py-4 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-200"
          />

          <textarea
            rows="5"
            placeholder="Tell us about your electricity usage or project..."
            class="w-full rounded-xl border border-slate-300 px-5 py-4 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-200"
          ></textarea>

          <button
            type="submit"
            class="w-full rounded-xl bg-orange-500 py-4 text-lg font-semibold text-white transition duration-300 hover:-translate-y-1 hover:bg-orange-600 hover:shadow-xl"
          >
            Request My FREE Assessment
          </button>

        </form>

        <p class="mt-6 text-center text-sm text-slate-500">
          🔒 Your information is kept confidential and will never be shared with third parties.
        </p>

      </div>

    </div>

  </div>

</section>