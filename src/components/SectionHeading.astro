---
interface Props {
    eyebrow?: string;
    title: string;
    description?: string;
    centered?: boolean;
}

const {
    eyebrow,
    title,
    description,
    centered = true
} = Astro.props;
---

<div
    class:list={[
        "max-w-3xl",
        centered ? "mx-auto text-center" : ""
    ]}
>

    {
        eyebrow && (

            <span class="text-sm font-bold uppercase tracking-[0.25em] text-orange-500">

                {eyebrow}

            </span>

        )
    }

    <h2 class="mt-4 text-4xl font-extrabold text-slate-900">

        {title}

    </h2>

    {
        description && (

            <p class="mt-8 text-lg leading-9 text-slate-600">

                {description}

            </p>

        )
    }

</div>