---
import SectionHeading from "../ui/SectionHeading.astro";
import { inverters } from "../../data/equipment";

const featuredInverters = inverters.slice(0, 4);
---

<section class="systems-section inverter-section">
  <div class="solar-container">
    <SectionHeading
      tag="HYBRID INVERTERS"
      title="The inverter is the heart of your solar system."
      intro="It manages energy flowing between your solar panels, battery, property and the electricity grid."
    />

    <div class="inverter-grid">
      {featuredInverters.map((inverter) => (
        <article class="inverter-card">
          <div class="inverter-top"><span>{inverter.brand}</span><strong>{inverter.size}</strong></div>
          <h3>{inverter.model}</h3>
          <div class="inverter-details">
            <span>{inverter.phases}-phase</span>
            <span>Up to {inverter.maxPV} PV</span>
            <span>{inverter.warranty} warranty</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .systems-section{padding:110px 0;background:#f4f5f7}.solar-container{width:min(1440px,calc(100% - 48px));margin-inline:auto}
  .inverter-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:60px}
  .inverter-card{padding:28px;border:1px solid #e5e7eb;border-radius:24px;background:#fff;transition:.3s ease}.inverter-card:hover{transform:translateY(-5px);box-shadow:0 18px 38px rgba(0,0,0,.08);border-color:#ffd0b0}
  .inverter-top{display:flex;align-items:center;justify-content:space-between;gap:12px}.inverter-top span{color:#6b7280;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.inverter-top strong{color:#ff6800;font-size:15px}
  .inverter-card h3{margin-top:18px;font-family:Poppins,sans-serif;font-size:23px;line-height:1.25}.inverter-details{display:grid;gap:8px;margin-top:24px;color:#6b7280;font-size:14px}
  @media(max-width:1100px){.inverter-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:900px){.systems-section{padding:80px 0}.inverter-grid{margin-top:44px}}@media(max-width:640px){.solar-container{width:calc(100% - 32px)}.inverter-grid{grid-template-columns:1fr}}
</style>
