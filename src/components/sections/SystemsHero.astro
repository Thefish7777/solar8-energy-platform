---
import { company } from "../../data/company";
---
<section class="systems-master-hero">
  <div class="solar-container">
    <div class="systems-master-hero-copy">
      <span class="eyebrow">SOLAR8 SYSTEMS</span>
      <h1>Solar solutions designed around your electricity needs.</h1>
      <p>From simple backup power to complete solar and battery systems, Solar8 helps you understand the options and choose a solution that fits your property, usage and goals.</p>
      <div class="hero-actions">
        <a href="/assessment/" class="primary-button">{company.cta.primary}</a>
        <a href="/contact/" class="secondary-button">Speak to an Expert</a>
      </div>
    </div>
    <div class="systems-master-points">
      <article class="kc-card"><div class="kc-icon">⌂</div><span class="kc-label">01 · BACKUP</span><h3>Backup Power</h3><p>Keep essential appliances running when the grid is unavailable.</p></article>
      <article class="kc-card"><div class="kc-icon">☀</div><span class="kc-label">02 · SAVINGS</span><h3>Lower Bills</h3><p>Generate your own electricity and reduce grid consumption.</p></article>
      <article class="kc-card"><div class="kc-icon">⚡</div><span class="kc-label">03 · INDEPENDENCE</span><h3>Energy Independence</h3><p>Combine generation and storage for greater control over your energy.</p></article>
    </div>
  </div>
</section>
<style>
.systems-master-hero{padding:120px 0 90px;background:radial-gradient(circle at 82% 18%,rgba(255,104,0,.14),transparent 35%),linear-gradient(180deg,#fff 0%,#FAFAFA 100%)}.systems-master-hero-copy{max-width:900px;text-align:center;margin-inline:auto}.systems-master-hero h1{margin:20px 0 0;color:#111827;font-family:Poppins,sans-serif;font-size:clamp(3rem,6vw,5.5rem);font-weight:800;line-height:1.02;letter-spacing:-.045em}.systems-master-hero-copy>p{max-width:780px;margin:28px auto 0;color:#6B7280;font-size:20px;line-height:1.7}.systems-master-hero .hero-actions{justify-content:center}.systems-master-points{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:60px}.systems-master-points .kc-card{min-height:250px}.systems-master-points .kc-icon{font-size:28px}
@media(max-width:900px){.systems-master-hero{padding:90px 0 80px}.systems-master-points{grid-template-columns:1fr;margin-top:44px;max-width:680px;margin-inline:auto}}@media(max-width:640px){.systems-master-hero{padding:76px 0 64px}.systems-master-hero h1{font-size:2.75rem}.systems-master-hero-copy>p{font-size:17px}.systems-master-hero .hero-actions{flex-direction:column}.systems-master-hero .hero-actions>*{width:100%}}
</style>
