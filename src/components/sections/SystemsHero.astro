---
import { company } from "../../data/company";
---

<section class="relative overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 text-white">

    <!-- Background Glow -->

    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(249,115,22,0.18),transparent_40%)]"></div>

    <div class="relative mx-auto max-w-7xl px-6 py-24 lg:py-32">

        <div class="mx-auto max-w-4xl text-center">

            <span class="inline-flex rounded-full border border-orange-500/30 bg-orange-500/10 px-4 py-1 text-sm font-semibold tracking-wide text-orange-300">

                SOLAR SYSTEMS

            </span>

            <h1 class="mt-8 text-5xl font-extrabold leading-tight tracking-tight lg:text-7xl">

                Solar Solutions Designed Around Your Electricity Needs

            </h1>

            <p class="mx-auto mt-8 max-w-3xl text-xl leading-9 text-slate-300">

                Whether you're looking to reduce monthly electricity costs,
                protect yourself from load shedding or move towards energy
                independence, Solar8 can help you choose the right system for
                your home or business.

            </p>

            <div class="mt-12 flex flex-wrap justify-center gap-6">

                <a
                    href="/assessment"
                    class="rounded-xl bg-orange-500 px-8 py-4 text-lg font-semibold text-white shadow-xl transition-all duration-300 hover:-translate-y-1 hover:bg-orange-600 hover:shadow-2xl"
                >
                    {company.cta.primary}
                </a>

                <a
                    href="/contact"
                    class="rounded-xl border border-white/20 px-8 py-4 text-lg font-semibold transition-all duration-300 hover:border-orange-500 hover:text-orange-300"
                >
                    Speak to an Expert
                </a>

            </div>

        </div>

        <!-- Feature Cards -->

        <div class="mt-20 grid gap-8 md:grid-cols-2 xl:grid-cols-4">

            <div class="rounded-3xl border border-slate-800 bg-slate-900/70 p-8 backdrop-blur">

                <div class="text-4xl">🏠</div>

                <h3 class="mt-6 text-xl font-bold">

                    Residential Solar

                </h3>

                <p class="mt-4 leading-8 text-slate-400">

                    Reduce electricity bills and gain reliable backup power for
                    your home.

                </p>

            </div>

            <div class="rounded-3xl border border-slate-800 bg-slate-900/70 p-8 backdrop-blur">

                <div class="text-4xl">🏢</div>

                <h3 class="mt-6 text-xl font-bold">

                    Commercial Solar

                </h3>

                <p class="mt-4 leading-8 text-slate-400">

                    Lower operating costs and improve energy security for your
                    business.

                </p>

            </div>

            <div class="rounded-3xl border border-slate-800 bg-slate-900/70 p-8 backdrop-blur">

                <div class="text-4xl">🔋</div>

                <h3 class="mt-6 text-xl font-bold">

                    Battery Storage

                </h3>

                <p class="mt-4 leading-8 text-slate-400">

                    Store excess energy and keep essential loads running during
                    outages.

                </p>

            </div>

            <div class="rounded-3xl border border-slate-800 bg-slate-900/70 p-8 backdrop-blur">

                <div class="text-4xl">⚡</div>

                <h3 class="mt-6 text-xl font-bold">

                    Hybrid Systems

                </h3>

                <p class="mt-4 leading-8 text-slate-400">

                    Combine solar generation, batteries and grid power for
                    maximum flexibility.

                </p>

            </div>

        </div>

    </div>

</section>