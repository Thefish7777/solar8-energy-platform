---
import SectionHeading from "../ui/SectionHeading.astro";

const reasons = [
  ["01", "Designed around you", "Your electricity usage and backup priorities guide the system design."],
  ["02", "Quality equipment", "We work with established solar, inverter and battery manufacturers."],
  ["03", "Professional installation", "The installation is planned around safety, reliability and clean workmanship."],
  ["04", "Long-term support", "We remain available after installation for technical support and system assistance."]
];
---

<section class="systems-section why-systems-section">
  <div class="solar-container">
    <SectionHeading
      tag="WHY SOLAR8"
      title="A solar system should be designed for the way you live and work."
      intro="We focus on the right balance of generation, storage, backup and future flexibility rather than simply selling the biggest system."
    />
    <div class="reason-grid">
      {reasons.map(([number, title, description]) => (
        <article class="reason-card">
          <span>{number}</span><h3>{title}</h3><p>{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .systems-section{padding:110px 0;background:#fff}.solar-container{width:min(1440px,calc(100% - 48px));margin-inline:auto}.reason-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:60px}.reason-card{padding:30px;border:1px solid #e5e7eb;border-radius:24px;background:#fafafa}.reason-card>span{color:#ff6800;font-size:12px;font-weight:800;letter-spacing:.12em}.reason-card h3{margin-top:20px;font-family:Poppins,sans-serif;font-size:22px}.reason-card p{margin-top:12px;color:#6b7280;line-height:1.7}
  @media(max-width:1000px){.reason-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:900px){.systems-section{padding:80px 0}.reason-grid{margin-top:44px}}@media(max-width:640px){.solar-container{width:calc(100% - 32px)}.reason-grid{grid-template-columns:1fr}}
</style>
