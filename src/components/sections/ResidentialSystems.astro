---
import { solutions } from "../../data/solutions";
import SystemCard from "../SystemCard.astro";
---

<section class="residential-systems-master">

    <div class="solar-container">

        <div class="section-heading centered">

            <span class="eyebrow">RESIDENTIAL SYSTEMS</span>

            <h2>

                Residential Solar Systems

            </h2>

            <p class="">

                Every home is different.
                These recommended systems provide a great starting point,
                but every Solar8 recommendation is customised to your
                electricity usage.

            </p>

        </div>

        <div class="residential-systems-master-grid">

            {
                solutions.map((system) => (

                    <SystemCard system={system} />

                ))
            }

        </div>

    </div>

</section><style>
.residential-systems-master{padding:110px 0;background:#F4F5F7}.residential-systems-master-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.residential-systems-master .section-heading{max-width:760px}.residential-systems-master .section-heading>p{max-width:720px;margin-left:auto;margin-right:auto}
@media(max-width:1100px){.residential-systems-master-grid{grid-template-columns:1fr 1fr}}@media(max-width:900px){.residential-systems-master{padding:80px 0}.residential-systems-master-grid{grid-template-columns:1fr;max-width:680px;margin-inline:auto}}@media(max-width:640px){.residential-systems-master{padding:72px 0}}
</style>
