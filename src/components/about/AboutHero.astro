---
import { company } from "../../data/company";
---

<section class="about-hero">

    <div class="container">

        <div class="about-hero-content">

            <p class="section-tag">

                ABOUT SOLAR8

            </p>

            <h1>

                Helping South Africans
                <br>
                Take Control of Their
                <br>
                Electricity Costs

            </h1>

            <p class="about-hero-intro">

                At Solar8 we believe every family and every business deserves
                reliable electricity, lower monthly costs and honest advice.

                We don't believe in selling the biggest system.

                We believe in recommending the right one.

            </p>

            <div class="hero-buttons">

                <a
                    href="/assessment"
                    class="primary-button"
                >

                    {company.cta.primary}

                </a>

                <a
                    href="/systems"
                    class="secondary-button"
                >

                    View Solar Systems

                </a>

            </div>

        </div>

    </div>

</section>