---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
}

const {
  href,
  variant = "primary"
} = Astro.props;
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-xl px-8 py-4 font-semibold transition-all duration-300 hover:-translate-y-1",

    variant === "primary"
      ? "bg-orange-500 text-white shadow-md hover:bg-orange-600 hover:shadow-xl"

      : "border border-orange-500 text-orange-500 hover:bg-orange-500 hover:text-white"
  ]}
>

  <slot />

</a>