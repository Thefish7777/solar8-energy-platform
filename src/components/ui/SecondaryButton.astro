---
interface Props {
    href: string;
}

const { href } = Astro.props;
---

<a
    href={href}
    class="inline-flex items-center justify-center rounded-xl border-2 border-slate-300 bg-white px-8 py-4 text-lg font-semibold text-slate-800 transition-all duration-300 hover:border-orange-500 hover:text-orange-500"
>

    <slot />

</a>