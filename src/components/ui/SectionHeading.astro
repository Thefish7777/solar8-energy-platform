---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mx-auto mb-16 max-w-3xl text-center">

    <h2 class="text-4xl font-bold text-slate-900">
        {title}
    </h2>

    {subtitle && (
        <p class="mt-6 text-lg text-slate-600">
            {subtitle}
        </p>
    )}

</div>