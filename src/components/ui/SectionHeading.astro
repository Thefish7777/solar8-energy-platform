---
interface Props {
    tag: string;
    title: string;
    intro?: string;
}

const { tag, title, intro } = Astro.props;
---

<div class="mx-auto max-w-3xl text-center">

    <p class="section-tag">
        {tag}
    </p>

    <h2 class="section-title">
        {title}
    </h2>

    {
        intro && (
            <p class="section-intro">
                {intro}
            </p>
        )
    }

</div>