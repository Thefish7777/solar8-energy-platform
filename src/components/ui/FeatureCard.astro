---
interface Props {
    icon: any;
    title: string;
    description: string;
    link: string;
}

const {
    icon: Icon,
    title,
    description,
    link
} = Astro.props;
---

<div
    class="group flex h-full flex-col rounded-3xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:border-orange-400 hover:shadow-2xl"
>

    <div
        class="mb-8 flex h-20 w-20 items-center justify-center rounded-2xl bg-orange-50 text-orange-500 transition duration-300 group-hover:bg-orange-500 group-hover:text-white"
    >

        <Icon size={42} strokeWidth={2} />

    </div>

    <h3 class="mb-5 text-2xl font-bold text-slate-900">

        {title}

    </h3>

    <p class="mb-8 flex-grow leading-8 text-slate-600">

        {description}

    </p>

    <a
        href={link}
        class="inline-flex items-center gap-2 font-semibold text-orange-500 transition duration-300 group-hover:gap-4"
    >

        Learn More

        <span>→</span>

    </a>

</div>