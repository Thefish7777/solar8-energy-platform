---
interface Props {
  badge: string;
  title: string;
  description: string;
}

const {
  badge,
  title,
  description
} = Astro.props;
---

<div class="mx-auto max-w-4xl text-center">

    <span
        class="rounded-full bg-orange-100 px-5 py-2 text-sm font-semibold text-orange-600"
    >
        {badge}
    </span>

    <h2
        class="mt-8 text-5xl font-bold tracking-tight text-slate-900"
    >
        {title}
    </h2>

    <p
        class="mx-auto mt-8 max-w-3xl text-xl leading-8 text-slate-600"
    >
        {description}
    </p>

</div>