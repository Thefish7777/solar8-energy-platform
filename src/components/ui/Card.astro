---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  class="group rounded-3xl border border-slate-200 border-t-4 border-t-orange-500 bg-white p-8 shadow-md transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl"
>

  <slot name="icon" />

  <h3 class="mt-6 text-2xl font-bold tracking-tight text-slate-900">
    {title}
  </h3>

  <div class="mt-5 leading-7 text-slate-600">
    <slot />
  </div>

</div>