---
import type { SolarSolution } from "../data/solutions";

interface Props {
  system: SolarSolution;
}

const { system } = Astro.props;
---

<div
  class:list={[
    "relative rounded-3xl border bg-white shadow-lg transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl",
    system.featured
      ? "border-orange-500 ring-2 ring-orange-500"
      : "border-slate-200"
  ]}
>

  {
    system.featured && (
      <div class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-orange-500 px-5 py-2 text-sm font-bold text-white shadow-lg">
        MOST POPULAR
      </div>
    )
  }

  <div class="p-8">

    <h3 class="text-3xl font-extrabold text-slate-900">
      {system.name}
    </h3>

    <p class="mt-2 font-semibold text-orange-500">
      {system.tagline}
    </p>

    <p class="mt-6 leading-8 text-slate-600">
      {system.shortDescription}
    </p>

    <div class="mt-8 space-y-4 rounded-2xl bg-slate-50 p-6">

      <div>
        <strong>Inverter</strong><br />
        {system.configuration.inverter}
      </div>

      <div>
        <strong>Battery</strong><br />
        {system.configuration.battery}
      </div>

      <div>
        <strong>Solar Panels</strong><br />
        {system.configuration.panels}
      </div>

    </div>

    <div class="mt-8">

      <h4 class="font-bold">
        Ideal For
      </h4>

      <ul class="mt-3 space-y-2">

        {
          system.idealFor.map((item) => (

            <li class="text-slate-600">

              ✓ {item}

            </li>

          ))
        }

      </ul>

    </div>

    <div class="mt-8">

      <h4 class="font-bold">
        Benefits
      </h4>

      <ul class="mt-3 space-y-2">

        {
          system.benefits.map((benefit) => (

            <li class="text-slate-600">

              ✓ {benefit}

            </li>

          ))
        }

      </ul>

    </div>

    <a
      href="/assessment"
      class="mt-10 inline-flex w-full justify-center rounded-xl bg-orange-500 px-6 py-4 font-semibold text-white transition hover:bg-orange-600"
    >

      {system.cta}

    </a>

  </div>

</div>