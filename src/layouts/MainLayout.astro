---
import "../styles/global.css";

import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    noIndex?: boolean;
}

const {
    title = "Solar8 | Solar Energy Solutions in Gauteng",
    description = "Solar8 provides residential and commercial solar systems, battery backup and professional solar solutions across Gauteng.",
    image = "/images/hero-home.jpg",
    noIndex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://solar8.co.za");
const imageURL = new URL(image, Astro.site ?? "https://solar8.co.za");
---

<!doctype html>
<html lang="en-ZA" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex,nofollow" : "index,follow"} />
    <link rel="canonical" href={canonicalURL.toString()} />

    <meta name="theme-color" content="#FF6800" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL.toString()} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:site_name" content="Solar8" />
    <meta property="og:locale" content="en_ZA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.toString()} />

    <link rel="icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": "https://solar8.co.za/#business",
        name: "Solar8",
        url: "https://solar8.co.za/",
        logo: "https://solar8.co.za/favicon.svg",
        image: "https://solar8.co.za/images/hero-home.jpg",
        email: "mailto:info@solar8.co.za",
        telephone: "+27 12 004 3488",
        address: {
            "@type": "PostalAddress",
            streetAddress: "Retief Avenue, Lyttelton Manor",
            addressLocality: "Centurion",
            addressRegion: "Gauteng",
            postalCode: "0157",
            addressCountry: "ZA"
        },
        areaServed: ["Pretoria", "Centurion", "Midrand", "Johannesburg", "East Rand", "West Rand", "Gauteng"],
        openingHoursSpecification: [
            { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "opens": "08:00", "closes": "17:00" }
        ],
        sameAs: [
            "https://www.facebook.com/Solar8.SA/",
            "https://www.instagram.com/solar8_sa/",
            "https://x.com/Solar8_SA"
        ]
    })} />
</head>

<body class="bg-slate-50 text-slate-900 antialiased selection:bg-orange-500 selection:text-white">
    <Navigation />

    <main class="site-main">
        <slot />
    </main>

    <Footer />
</body>
</html>

<style>
.site-main { padding-top: 0; }
@media (max-width: 1023px) { .site-main { padding-top: 0; } }
@media (max-width: 640px) { .site-main { padding-top: 0; } }
</style>
