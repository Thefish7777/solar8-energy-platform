---
import "../styles/global.css";

import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
}

const { title } = Astro.props;
---

<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <link
        rel="icon"
        href="/favicon.ico"
    />

</head>


<body>

    <Navigation />


    <main class="site-main">

        <slot />

    </main>


    <Footer />

</body>

</html>


<style>

.site-main {

    padding-top:
        0;

}


/* ==========================================
   TABLET
========================================== */

@media (max-width: 1023px) {

    .site-main {

        padding-top:
            0;

    }

}


/* ==========================================
   MOBILE
========================================== */

@media (max-width: 640px) {

    .site-main {

        padding-top:
            0;

    }

}

</style>